<Page x:Class="Lotus.App.SectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
  <StackPanel Padding="32,40,32,32" Spacing="24" MaxWidth="1100" HorizontalAlignment="Stretch">
   <TextBlock Text="LOTUS  /  WORKSPACE" FontSize="11" CharacterSpacing="180" Foreground="{StaticResource RoseBrush}"/>
   <StackPanel Spacing="8"><TextBlock Text="{Binding Title}" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></StackPanel>
   <Border Style="{StaticResource CardStyle}">
    <StackPanel Spacing="16">
     <TextBlock Text="PRIMEIRO PASSO" Foreground="{StaticResource RoseBrush}" FontSize="11" CharacterSpacing="140"/>
     <TextBlock Text="Uma base para jogar com confiança." FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="Navegue pelas seções para conhecer a estrutura do Lotus. Os módulos serão implementados e validados em etapas." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
     <Border Background="#30232D" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left"><TextBlock Text="Etapa 01 · Fundação" Foreground="{StaticResource RoseBrush}"/></Border>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
    <TextBlock Text="Planejado · Funcionalidade ainda não implementada" TextWrapping="Wrap" Foreground="{StaticResource RoseBrush}"/>
    <TextBlock x:Name="LogLocation" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
   </StackPanel></Border>
   <Border BorderBrush="#36313B" BorderThickness="0,1,0,0" Padding="0,20,0,0"><StackPanel Spacing="8"><TextBlock Text="Transparência por princípio" FontWeight="SemiBold"/><TextBlock Text="Nenhuma métrica está sendo coletada. Nenhuma configuração do Windows foi alterada. Resultados só aparecerão quando houver medições reais." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</Page>
