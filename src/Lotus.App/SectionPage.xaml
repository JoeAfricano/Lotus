<Page x:Class="Lotus.App.SectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
  <StackPanel Padding="28,28,28,24" Spacing="22" MaxWidth="1440" HorizontalAlignment="Stretch">
   <StackPanel Spacing="7">
    <TextBlock Text="SEU JOGO. SEU RITMO." Style="{StaticResource EyebrowStyle}"/>
    <TextBlock x:Name="PageTitle" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
   </StackPanel>
   <StackPanel x:Name="DashboardContent" Spacing="20">
    <Border BorderBrush="#A63660" BorderThickness="1" CornerRadius="14">
     <Grid MinHeight="264" CornerRadius="14">
      <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6"><GradientStop Color="#281122"/><GradientStop Offset="0.5" Color="#15101B"/><GradientStop Offset="1" Color="#40142B"/></LinearGradientBrush></Grid.Background>
      <Viewbox Width="470" MaxWidth="470" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.65" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
       <Canvas Width="480" Height="260">
        <Ellipse Width="186" Height="186" Canvas.Left="235" Canvas.Top="12" Fill="#44182F" Stroke="#B83465" StrokeThickness="1"/>
        <Ellipse Width="156" Height="156" Canvas.Left="250" Canvas.Top="27" Fill="#94284F"/>
        <Path Fill="#211321" Data="M0,223 L100,112 L160,170 L213,106 L300,211 L358,151 L480,230 L480,260 L0,260 Z"/>
        <Path Fill="#0C0B13" Data="M0,250 L80,186 L130,215 L217,157 L291,240 L365,198 L480,244 L480,260 L0,260 Z"/>
        <Path Fill="#0C0B13" Data="M331,245 L331,155 L323,155 L323,149 L340,144 L340,114 L332,114 L332,107 L350,101 L350,78 L346,78 L346,73 L369,65 L392,73 L392,78 L388,78 L388,101 L406,107 L406,114 L398,114 L398,144 L415,149 L415,155 L407,155 L407,245 Z"/>
        <Path Stroke="#BD3B6B" StrokeThickness="2" Data="M317,150 Q369,140 422,150 M328,108 Q370,98 412,108 M341,74 Q369,66 397,74"/>
        <Path Stroke="#66233F" StrokeThickness="4" Data="M480,8 Q420,35 429,102 M460,18 Q400,5 378,23 M437,39 Q401,54 395,75"/>
        <Ellipse Canvas.Left="405" Canvas.Top="27" Width="9" Height="5" Fill="#FF6B9D"/><Ellipse Canvas.Left="435" Canvas.Top="48" Width="7" Height="11" Fill="#F43F7E"/><Ellipse Canvas.Left="390" Canvas.Top="65" Width="12" Height="6" Fill="#FF6B9D"/><Ellipse Canvas.Left="465" Canvas.Top="84" Width="9" Height="5" Fill="#FF6B9D"/>
       </Canvas>
      </Viewbox>
      <StackPanel Padding="26" Spacing="15" MaxWidth="510" HorizontalAlignment="Left">
       <TextBlock Text="FOCO NO QUE IMPORTA" Style="{StaticResource EyebrowStyle}"/>
       <TextBlock Text="Prepare o sistema.&#x0a;Entre no jogo." FontSize="34" FontWeight="Bold" TextWrapping="Wrap"/>
       <TextBlock Text="Diagnóstico claro. Mudanças conscientes.&#x0a;Evolução que você poderá medir." TextWrapping="Wrap" Foreground="#D1BACA" FontSize="14"/>
       <Border BorderBrush="#A53A60" BorderThickness="1" Background="#2B1424" CornerRadius="5" Padding="12,7" HorizontalAlignment="Left"><TextBlock Text="INTERFACE EM CONSTRUÇÃO" FontSize="9" CharacterSpacing="140" Foreground="#FF9CBB"/></Border>
      </StackPanel>
     </Grid>
    </Border>
    <Grid ColumnSpacing="18" RowSpacing="18">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <VisualStateManager.VisualStateGroups><VisualStateGroup>
      <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="TelemetryCard.(Grid.Row)" Value="1"/><Setter Target="TelemetryCard.(Grid.Column)" Value="0"/><Setter Target="TelemetryCard.(Grid.ColumnSpan)" Value="2"/><Setter Target="ScoreCard.(Grid.ColumnSpan)" Value="2"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1140"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="TelemetryCard.(Grid.Row)" Value="0"/><Setter Target="TelemetryCard.(Grid.Column)" Value="1"/><Setter Target="TelemetryCard.(Grid.ColumnSpan)" Value="1"/><Setter Target="ScoreCard.(Grid.ColumnSpan)" Value="1"/></VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <Border x:Name="ScoreCard" Style="{StaticResource CardStyle}">
      <StackPanel Spacing="12">
       <TextBlock Text="LOTUS SCORE" Style="{StaticResource EyebrowStyle}"/>
       <Grid Width="144" Height="144" HorizontalAlignment="Center" Margin="0,4">
        <Ellipse Stroke="#522039" StrokeThickness="9"/>
        <Ellipse Width="124" Height="124" Stroke="#261B29" StrokeThickness="1"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"><TextBlock Text="—" FontSize="42" FontWeight="SemiBold" Foreground="#FF9CBB" HorizontalAlignment="Center"/><TextBlock Text="NÃO AVALIADO" Foreground="#C69CAE" FontSize="9" CharacterSpacing="100"/></StackPanel>
       </Grid>
       <TextBlock Text="Diagnóstico disponível em uma próxima etapa." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"/>
      </StackPanel>
     </Border>
     <Border x:Name="TelemetryCard" Grid.Column="1" Style="{StaticResource CardStyle}">
      <StackPanel Spacing="16">
       <TextBlock Text="VISÃO DO SISTEMA" Style="{StaticResource EyebrowStyle}"/>
       <Grid ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#352231" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="4"><TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource RoseBrush}"/><TextBlock Text="—" FontSize="24"/><TextBlock Text="Sem leitura" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
        <Border Grid.Column="1" BorderBrush="#352231" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="4"><TextBlock Text="GPU" FontSize="10" Foreground="{StaticResource RoseBrush}"/><TextBlock Text="—" FontSize="24"/><TextBlock Text="Sem leitura" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
        <Border Grid.Row="1" BorderBrush="#352231" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="4"><TextBlock Text="MEMÓRIA" FontSize="10" Foreground="{StaticResource RoseBrush}"/><TextBlock Text="—" FontSize="24"/><TextBlock Text="Sem leitura" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#352231" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="4"><TextBlock Text="ARMAZENAMENTO" FontSize="10" Foreground="{StaticResource RoseBrush}" TextWrapping="Wrap"/><TextBlock Text="—" FontSize="24"/><TextBlock Text="Sem leitura" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
       </Grid>
      </StackPanel>
     </Border>
    </Grid>
    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="EVOLUÇÃO COM CONTROLE" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="Analisar  ›  Recomendar  ›  Confirmar  ›  Aplicar  ›  Verificar  ›  Comparar" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="Cada etapa será construída com você. As ferramentas de diagnóstico e otimização ainda não estão disponíveis." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
   </StackPanel>
   <Border x:Name="ModuleCard" Style="{StaticResource CardStyle}"><StackPanel Spacing="16">
    <TextBlock Text="PRÓXIMOS PASSOS" Style="{StaticResource EyebrowStyle}"/>
    <TextBlock Text="{Binding NextStep}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="Planejado · Funcionalidade ainda não implementada" TextWrapping="Wrap" Foreground="{StaticResource RoseBrush}"/>
    <TextBlock x:Name="LogLocation" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
   </StackPanel></Border>
   <Border BorderBrush="#542337" BorderThickness="0,1,0,0" Padding="0,16,0,0"><TextBlock Text="LOTUS / FUNDAÇÃO VISUAL   ·   Nenhuma métrica coletada ou configuração do Windows alterada." FontSize="10" TextWrapping="Wrap" Foreground="#8D8191"/></Border>
  </StackPanel>
 </ScrollViewer>
</Page>
