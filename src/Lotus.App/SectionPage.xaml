<Page x:Class="Lotus.App.SectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Lotus.App.Controls" Foreground="{ThemeResource MainTextBrush}">
 <ScrollViewer x:Name="PageScroll" SizeChanged="OnViewportSizeChanged" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
  <StackPanel x:Name="PageContent" Padding="24" Spacing="24" HorizontalAlignment="Stretch" SizeChanged="OnContentSizeChanged">
   <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeaderTemplate}" HorizontalContentAlignment="Stretch"/>
   <StackPanel x:Name="HomeContent" x:Load="{x:Bind ShowHome}" Spacing="20">
    <controls:PrimaryActionCard DataContext="{Binding Experience}"/>
    <TextBlock Text="{Binding Text[UxYourComputer]}" Style="{StaticResource SectionTitleStyle}"/>
    <Grid x:Name="SummaryGrid" ColumnSpacing="16" RowSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="CpuSummary" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="8"><TextBlock Text="{Binding Text[UxProcessor]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Experience.CpuModel}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
     <Border x:Name="GpuSummary" Grid.Column="1" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="8"><TextBlock Text="{Binding Text[UxGraphics]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Experience.GpuModel}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
     <Border x:Name="RamSummary" Grid.Column="2" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="8"><TextBlock Text="{Binding Text[Memory]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Experience.RamCapacity}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
    </Grid>
    <TextBlock Text="{Binding Experience.SummaryTime}" Style="{StaticResource CaptionStyle}"/>
   </StackPanel>
   <StackPanel x:Name="OptimizeContent" x:Load="{x:Bind ShowOptimize}" Spacing="20">
    <SelectorBar x:Name="OptimizeTabs" SelectionChanged="OnOptimizeTabChanged" AutomationProperties.Name="{Binding Text[UxOptimizeSections]}">
     <SelectorBarItem Text="{Binding Text[UxResultsTab]}"/><SelectorBarItem Text="{Binding Text[UxRestoreTab]}"/>
    </SelectorBar>
    <ContentControl x:Name="DiagnosisContent" x:Load="{x:Bind ShowDiagnosis}" Style="{StaticResource CardControlStyle}">
     <StackPanel Spacing="16">
      <TextBlock Text="{Binding Text[UxResultsTitle]}" Style="{StaticResource SectionTitleStyle}"/>
      <ContentControl Content="{Binding Experience.Finding}" Style="{StaticResource StatusBadgeStyle}"/>
      <controls:OperationProgress DataContext="{Binding Experience}" Visibility="{Binding Experience.IsAnalyzing, Converter={StaticResource BooleanVisibility}}"/>
      <TextBlock Text="{Binding Experience.Advice}" FontSize="17" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Experience.LastAnalysis}" Style="{StaticResource CaptionStyle}"/>
      <TextBlock Text="{Binding Text[UxAdviceInformational]}" Style="{StaticResource CaptionStyle}"/>
      <Expander Visibility="{Binding Experience.HasResult, Converter={StaticResource BooleanVisibility}}" Header="{Binding Text[UxTechnicalDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
       <StackPanel Spacing="12"><TextBlock Text="{Binding Text[RamAvailableLabel]}"/><TextBlock Text="{Binding Experience.Available}" FontSize="28" Foreground="{ThemeResource RoseBrush}"/><TextBlock Text="{Binding Text[RamCapacityLabel]}"/><TextBlock Text="{Binding Experience.Capacity}"/><TextBlock Text="{Binding Text[RamMinimumLabel]}"/><TextBlock Text="{Binding Experience.MinimumAvailable}"/><TextBlock Text="{Binding Experience.Evidence}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[RamMethod]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[RamCacheExplanation]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[RamLimits]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Experience.Source}" TextWrapping="Wrap"/></StackPanel>
      </Expander>
     </StackPanel>
    </ContentControl>
    <ContentControl x:Name="RestoreContent" x:Load="{x:Bind ShowRestore}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE777;" Style="{StaticResource EmptyIconStyle}"/><TextBlock Text="{Binding Text[UxNoChangesTitle]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[UxNoChangesDescription]}" TextWrapping="Wrap"/></StackPanel></ContentControl>
   </StackPanel>
   <StackPanel x:Name="PerformanceContent" x:Load="{x:Bind ShowPerformance}" Spacing="20">
    <SelectorBar x:Name="PerformanceTabs" SelectionChanged="OnPerformanceTabChanged" AutomationProperties.Name="{Binding Text[UxPerformanceSections]}"><SelectorBarItem Text="{Binding Text[UxLiveTab]}"/><SelectorBarItem Text="{Binding Text[UxCompareTab]}"/><SelectorBarItem Text="{Binding Text[UxHistoryTab]}"/></SelectorBar>
    <controls:MonitoringPanel x:Name="MonitoringContent" x:Load="{x:Bind ShowLive}" DataContext="{Binding Monitoring}"/>
    <ContentControl x:Name="CompareContent" x:Load="{x:Bind ShowCompare}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE9D9;" Style="{StaticResource EmptyIconStyle}"/><TextBlock Text="{Binding Text[UxCompareEmptyTitle]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[UxCompareEmptyDescription]}" TextWrapping="Wrap"/></StackPanel></ContentControl>
    <ContentControl x:Name="HistoryContent" x:Load="{x:Bind ShowHistory}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE81C;" Style="{StaticResource EmptyIconStyle}"/><TextBlock Text="{Binding Text[UxHistoryEmptyTitle]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[UxHistoryEmptyDescription]}" TextWrapping="Wrap"/></StackPanel></ContentControl>
   </StackPanel>
   <ContentControl x:Name="GamesContent" x:Load="{x:Bind ShowGames}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="16"><FontIcon Glyph="&#xE7FC;" Style="{StaticResource EmptyIconStyle}"/><TextBlock Text="{Binding Text[UxGamesEmptyTitle]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[UxGamesEmptyDescription]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[UxGamesFuture]}" Style="{StaticResource CaptionStyle}"/></StackPanel></ContentControl>
   <StackPanel x:Name="SettingsContent" x:Load="{x:Bind ShowSettings}" Spacing="20">
    <ComboBox Header="{Binding Text[UxSettingsCategory]}" ItemsSource="{Binding Shell.SettingsCategories}" SelectedIndex="{Binding Shell.SettingsCategoryIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" MaxWidth="440" SelectionChanged="OnSettingsCategoryChanged" AutomationProperties.AutomationId="settings-category"/>
    <ContentControl x:Name="AppearanceContent" x:Load="{x:Bind ShowAppearance}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="20">
     <TextBlock Text="{Binding Text[AppearanceCategory]}" Style="{StaticResource SectionTitleStyle}"/>
     <ComboBox Header="{Binding Text[Theme]}" SelectedIndex="{Binding Preferences.ThemeIndex, Mode=TwoWay}" ItemsSource="{Binding Preferences.ThemeOptions}" HorizontalAlignment="Stretch" MaxWidth="440" AutomationProperties.AutomationId="settings-theme" AutomationProperties.Name="{Binding Text[Theme]}"/>
     <ComboBox Header="{Binding Text[Language]}" SelectedIndex="{Binding Preferences.LanguageIndex, Mode=TwoWay}" ItemsSource="{Binding Preferences.LanguageOptions}" HorizontalAlignment="Stretch" MaxWidth="440" AutomationProperties.AutomationId="settings-language" AutomationProperties.Name="{Binding Text[Language]}"/>
     <CheckBox Content="{Binding Text[ReduceMotion]}" IsChecked="{Binding Preferences.ReduceMotion, Mode=TwoWay}" AutomationProperties.AutomationId="settings-motion"/>
     <TextBlock Text="{Binding Text[ImmediateHint]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Preferences.Message}" Foreground="{ThemeResource RoseBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <Expander Header="{Binding Text[UxMotionDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[BrandMotionPolicy]}" TextWrapping="Wrap"/></Expander>
    </StackPanel></ContentControl>
    <ContentControl x:Name="MonitoringSettingsContent" x:Load="{x:Bind ShowMonitoringSettings}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="16"><TextBlock Text="{Binding Text[MonitoringCategory]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Experience.CollectorStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[UxMonitoringSettings]}" TextWrapping="Wrap"/></StackPanel></ContentControl>
    <ContentControl x:Name="IntegrationsContent" x:Load="{x:Bind ShowIntegrations}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><TextBlock Text="{Binding Text[IntegrationsCategory]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[UxIntegrationsEmpty]}" TextWrapping="Wrap"/></StackPanel></ContentControl>
    <ContentControl x:Name="SafetyContent" x:Load="{x:Bind ShowSafety}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><TextBlock Text="{Binding Text[SafetyCategory]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[UxNoChangesDescription]}" TextWrapping="Wrap"/></StackPanel></ContentControl>
    <StackPanel x:Name="FaqContent" x:Load="{x:Bind ShowFaq}" Spacing="12">
     <TextBlock Text="{Binding Text[FaqTitle]}" Style="{StaticResource SectionTitleStyle}"/>
     <Expander Header="{Binding Text[UxProgressDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[UxProgressExplanation]}" TextWrapping="Wrap"/></Expander>
     <Expander Header="{Binding Text[FaqSafetyQuestion]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[FaqSafetyAnswer]}" TextWrapping="Wrap"/></Expander>
     <Expander Header="{Binding Text[FaqScopeQuestion]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[UxScope]}" TextWrapping="Wrap"/></Expander>
     <Expander Header="{Binding Text[FaqSolutionsQuestion]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[FaqSolutionsAnswer]}" TextWrapping="Wrap"/></Expander>
    </StackPanel>
    <ContentControl x:Name="AdvancedContent" x:Load="{x:Bind ShowAdvanced}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="16"><TextBlock Text="{Binding Text[AdvancedCategory]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding AppVersion}"/><TextBlock Text="{Binding Text[UxLogExplanation]}" TextWrapping="Wrap"/><TextBlock Text="{Binding LogLocation}" IsTextSelectionEnabled="True" TextWrapping="Wrap" AutomationProperties.AutomationId="settings-log-path"/><TextBlock Text="{Binding Experience.CollectorStatus}" TextWrapping="Wrap"/><Expander Header="{Binding Text[UxDataSources]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12"><TextBlock Text="{Binding Text[UxDataSourcesDescription]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Monitoring.LastUpdate}" TextWrapping="Wrap"/><TextBlock Text="{Binding Monitoring.GpuStatus}" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel></ContentControl>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</Page>
