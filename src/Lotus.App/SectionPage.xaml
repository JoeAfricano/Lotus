<Page x:Class="Lotus.App.SectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls" Foreground="{ThemeResource MainTextBrush}" Background="Transparent">
 <ScrollViewer x:Name="PageScroll" SizeChanged="OnViewportSizeChanged" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
  <StackPanel x:Name="PageContent" Padding="32,24,32,32" Spacing="24" HorizontalAlignment="Stretch" SizeChanged="OnContentSizeChanged">
   <ContentControl x:Name="PageHeader" Content="{Binding}" ContentTemplate="{StaticResource PageHeaderTemplate}" HorizontalContentAlignment="Stretch"/>

   <StackPanel x:Name="HomeContent" x:Load="{x:Bind ShowHome}" Spacing="20" app:Motion.Stagger="True">
    <!-- Visual 3.0: the last game's art runs edge to edge; the readiness score floats over it on the right -->
    <Grid x:Name="HomeTop" Margin="-32,-24,-32,0" RowSpacing="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <controls:ContinueCard x:Name="ContinueCard" Bleed="True" Loaded="OnContinueLoaded" DetailsRequested="OnContinueDetails" Height="540"/>
     <StackPanel x:Name="HomeSide" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,32,0" Spacing="16">
      <controls:GuidedSetupCard DataContext="{Binding Guided}" NavigateRequested="OnGuidedNavigate"/>
      <controls:ReadinessCard x:Name="ReadinessCard" Loaded="OnReadinessLoaded" NavigateRequested="OnGuidedNavigate" Visibility="{Binding Guided.ShowReady, Converter={StaticResource BooleanVisibility}}"/>
     </StackPanel>
    </Grid>
    <!-- Your games on the left, Game list and Lotus Ports as two big tiles on the right -->
    <StackPanel x:Name="HomeBelow" Spacing="24" Margin="0,-28,0,0">
     <StackPanel x:Name="HomeGamesBlock" Spacing="12">
    <!-- Your games: quick shortcuts; the cover opens My Games, Play starts the game -->
    <Grid ColumnSpacing="12" Margin="0,8,0,0" Visibility="{Binding Games.HasFeatured, Converter={StaticResource BooleanVisibility}}">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Text[HomeGames]}" Style="{StaticResource SectionTitleStyle}"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
      <Button x:Name="HomeRescan" Click="OnHomeRescan" AutomationProperties.Name="{Binding Text[HomeRescan]}" Background="Transparent" BorderThickness="0" Padding="10,6" ToolTipService.ToolTip="{Binding Text[HomeRescanHint]}" AutomationProperties.AutomationId="home-rescan">
       <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon x:Name="HomeRescanIcon" Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource RoseBrush}"/><TextBlock x:Name="HomeRescanText" Text="{Binding Text[HomeRescan]}" FontSize="14" Foreground="{ThemeResource RoseBrush}"/></StackPanel>
      </Button>
      <HyperlinkButton Content="{Binding Text[HomeGamesAll]}" Click="OnOpenGames" AutomationProperties.AutomationId="home-games-all"/>
     </StackPanel>
    </Grid>
    <!-- One full row of covers that fills the width (extra covers wrap below and are clipped; "Ver todos" opens the rest) -->
    <Grid Height="276" Visibility="{Binding Games.HasFeatured, Converter={StaticResource BooleanVisibility}}">
    <Grid.Clip><RectangleGeometry Rect="0,0,4000,276"/></Grid.Clip>
    <ItemsControl ItemsSource="{Binding Games.Featured}" Margin="0,0,-14,0" AutomationProperties.AutomationId="home-games">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="182" ItemHeight="290" app:Fit.MinItemWidth="182"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Spacing="8" Margin="0,0,14,0">
      <Grid Height="224" CornerRadius="16" Background="{ThemeResource HeroBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" app:Motion.Hover="1.04" Tapped="OnHomeGameTapped">
       <Image Source="{Binding Name, Converter={StaticResource FallbackCover}}" Stretch="UniformToFill" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}, ConverterParameter=Invert}" AutomationProperties.AccessibilityView="Raw"/>
       <TextBlock Text="{Binding Initials}" FontFamily="Georgia" FontSize="32" FontWeight="SemiBold" Foreground="#FFF6F9" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}, ConverterParameter=Invert}"/>
       <Border Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}}"><Border.Background><ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/></Border.Background></Border>
       <Button Click="OnCoverPlay" Width="34" Height="34" CornerRadius="17" Padding="0" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Background="{ThemeResource AccentGradientBrush}" BorderBrush="#66FFFFFF" BorderThickness="1.5" app:Motion.Press="True" ToolTipService.ToolTip="{Binding PlayLabel}" AutomationProperties.Name="{Binding Name}">
        <FontIcon Glyph="&#xF5B0;" FontSize="15" Foreground="White" Margin="2,0,0,0"/>
       </Button>
      </Grid>
      <!-- Name and store under the cover (design: GameCard) -->
      <StackPanel Spacing="1" Padding="2,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1"/><TextBlock Text="{Binding Store}" Style="{StaticResource CaptionStyle}" FontSize="12"/></StackPanel>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
     </StackPanel>
     <Grid x:Name="HomeTiles" ColumnSpacing="16" RowSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Button x:Name="HomeGameList" Click="OnHomeGameList" Style="{StaticResource CardButtonStyle}" AutomationProperties.AutomationId="home-gamelist" AutomationProperties.Name="{Binding Text[gamelistTitle]}">
       <Border CornerRadius="16" Padding="18,16" BorderThickness="1" BorderBrush="{ThemeResource GoldGradientBrush}" app:Motion.Hover="1.02" app:Motion.Sheen="True">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#66C2185B" Offset="0"/><GradientStop Color="#40E7AE93" Offset="1"/></LinearGradientBrush></Border.Background>
        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource GoldGradientBrush}"><FontIcon x:Name="HomeGameListIcon" Glyph="&#xE8B1;" FontSize="20" Foreground="#3A0F24"/></Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding Text[HbListTitle]}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Text[HomeGameListHint]}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
         </StackPanel>
         <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource GoldBrush}"/>
        </Grid>
       </Border>
      </Button>
      <!-- Lotus Ports (sibling app): a small invitation; the click explains it and installs only after the player confirms -->
      <Button x:Name="HomePorts" Grid.Column="1" Click="OnHomePorts" Loaded="OnHomePortsLoaded" Style="{StaticResource CardButtonStyle}" AutomationProperties.AutomationId="home-ports" AutomationProperties.Name="Lotus Ports">
       <Border CornerRadius="16" Padding="16,14" BorderThickness="1" BorderBrush="{ThemeResource CardBorderBrush}" Background="{ThemeResource CardBrush}" app:Motion.Hover="1.02">
        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Image x:Name="HomePortsIcon" Width="44" Height="44" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8">
           <TextBlock Text="Lotus Ports" FontSize="14" FontWeight="SemiBold"/>
           <Border x:Name="HomePortsBadge" CornerRadius="8" Padding="7,1" Background="{ThemeResource AccentGradientBrush}" VerticalAlignment="Center"><TextBlock Text="{Binding Text[PoNew]}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource OnRoseBrush}"/></Border>
          </StackPanel>
          <TextBlock x:Name="HomePortsHint" Text="{Binding Text[PoHint]}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
         </StackPanel>
         <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource RoseBrush}"/>
        </Grid>
       </Border>
      </Button>
     </Grid>
    </StackPanel>
    <!-- Diary shelf: what the player is playing and wants to play (filled in code) -->
    <StackPanel x:Name="HomeShelf" Spacing="12" Margin="0,8,0,0" Loaded="OnHomeShelfLoaded" Visibility="Collapsed">
     <StackPanel Spacing="2"><TextBlock Text="{Binding Text[DyShelf]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[DyShelfHint]}" Style="{StaticResource CaptionStyle}"/></StackPanel>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
      <StackPanel x:Name="HomeShelfRow" Orientation="Horizontal" Spacing="14" Padding="0,0,0,10"/>
     </ScrollViewer>
    </StackPanel>
   </StackPanel>

   <StackPanel x:Name="OptimizeContent" x:Load="{x:Bind ShowOptimize}" Spacing="20">
    <controls:PowerProfilesPanel DataContext="{Binding PowerProfiles}"/>
    <SelectorBar x:Name="OptimizeTabs" SelectionChanged="OnOptimizeTabChanged" AutomationProperties.Name="{Binding Text[UxOptimizeSections]}">
     <SelectorBarItem Text="{Binding Text[UxResultsTab]}"/><SelectorBarItem Text="{Binding Text[UxRestoreTab]}"/>
    </SelectorBar>
    <!-- Result (design 03): the analysis, full width. The safety promise lives once, in the "Segurança e reversão" card above -->
    <Grid x:Name="DiagnosisContent" x:Load="{x:Bind ShowDiagnosis}" ColumnSpacing="24" RowSpacing="24">
     <Border Style="{StaticResource CardStyle}">
      <StackPanel Spacing="14">
       <FontIcon Glyph="&#xE9D9;" FontSize="26" Foreground="{ThemeResource RoseBrush}" HorizontalAlignment="Left"/>
       <TextBlock Text="{Binding Text[UxResultsTitle]}" FontSize="20" FontWeight="SemiBold"/>
       <ContentControl Content="{Binding Experience.Finding}" Style="{StaticResource StatusBadgeStyle}"/>
       <controls:OperationProgress DataContext="{Binding Experience}" Visibility="{Binding Experience.IsAnalyzing, Converter={StaticResource BooleanVisibility}}"/>
       <TextBlock Text="{Binding Experience.Advice}" FontSize="18" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Experience.LastAnalysis}" Style="{StaticResource CaptionStyle}"/>
       <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Command="{Binding Experience.AnalyzeCommand}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="44" Visibility="{Binding Experience.IsAnalyzing, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}" AutomationProperties.AutomationId="result-analyze">
         <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="14"/><TextBlock Text="{Binding Text[UxAnalyzeNow]}"/></StackPanel>
        </Button>
        <Button Content="{Binding Text[UxCancel]}" Command="{Binding Experience.CancelCommand}" Style="{StaticResource SoftButtonStyle}" MinHeight="44" Visibility="{Binding Experience.IsAnalyzing, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="result-cancel"/>
       </StackPanel>
       <TextBlock Text="{Binding Text[UxAdviceInformational]}" Style="{StaticResource CaptionStyle}"/>
       <Expander Visibility="{Binding Experience.HasResult, Converter={StaticResource BooleanVisibility}}" Header="{Binding Text[UxTechnicalDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12"><TextBlock Text="{Binding Text[RamAvailableLabel]}" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="{Binding Experience.Available}" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="{Binding Text[RamCapacityLabel]}" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="{Binding Experience.Capacity}"/><TextBlock Text="{Binding Text[RamMinimumLabel]}" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="{Binding Experience.MinimumAvailable}"/><TextBlock Text="{Binding Experience.Evidence}" Style="{StaticResource BodyStyle}"/><TextBlock Text="{Binding Text[RamMethod]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Text[RamCacheExplanation]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Text[RamLimits]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Experience.Source}" Style="{StaticResource CaptionStyle}"/></StackPanel>
       </Expander>
      </StackPanel>
     </Border>
    </Grid>
    <controls:OptimizationPanel x:Name="RestoreContent" x:Load="{x:Bind ShowRestore}" DataContext="{Binding PowerProfiles}"/>
   </StackPanel>

   <StackPanel x:Name="PerformanceContent" x:Load="{x:Bind ShowPerformance}" Spacing="20">
    <SelectorBar x:Name="PerformanceTabs" SelectionChanged="OnPerformanceTabChanged" AutomationProperties.Name="{Binding Text[UxPerformanceSections]}"><SelectorBarItem Text="{Binding Text[UxLiveTab]}"/><SelectorBarItem Text="{Binding Text[UxCompareTab]}"/><SelectorBarItem Text="{Binding Text[UxHistoryTab]}"/></SelectorBar>
    <controls:MonitoringPanel x:Name="MonitoringContent" x:Load="{x:Bind ShowLive}" DataContext="{Binding Monitoring}"/>
    <controls:BenchmarkPanel x:Name="CompareContent" x:Load="{x:Bind ShowCompare}" DataContext="{Binding Benchmark}"/>
    <controls:ReportPanel x:Name="HistoryContent" x:Load="{x:Bind ShowHistory}"/>
   </StackPanel>

   <Grid x:Name="GamesArea" x:Load="{x:Bind ShowGames}">
    <StackPanel x:Name="GamesList" Spacing="16" Loaded="OnGamesListLoaded">
     <!-- Visual 3.0: the last game played, big, with Play right there -->
     <controls:ContinueCard x:Name="GamesSpotlight" Compact="True" Height="240" Loaded="OnSpotlightLoaded" DetailsRequested="OnSpotlightDetails"/>
     <!-- Library / Overlay: the overlay lives only in its own tab (visual 2.0) -->
     <SelectorBar x:Name="GamesTabs" SelectionChanged="OnGamesTabChanged" AutomationProperties.AutomationId="games-tabs">
      <SelectorBarItem Text="{Binding Text[GmTabLibrary]}" IsSelected="True"/><SelectorBarItem Text="{Binding Text[GmTabOverlay]}"/>
     </SelectorBar>
     <Border x:Name="OverlaySummary" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="22,16" AutomationProperties.AutomationId="games-overlay-summary">
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding Text[GmOverlayTitle]}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Text[GmOverlayHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><TextBlock Text="{Binding Integrations.LayoutStatus}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap"/></StackPanel>
       <Button Grid.Column="2" Content="{Binding Text[GmOverlayConfigure]}" Click="OnOverlayConfigure" Style="{StaticResource SoftButtonStyle}" MinHeight="44" MinWidth="180" VerticalAlignment="Center" AutomationProperties.AutomationId="games-overlay-configure"/>
      </Grid>
     </Border>
     <StackPanel x:Name="OverlayArea" Spacing="16" Visibility="Collapsed">
      <Border Style="{StaticResource CardStyle}" AutomationProperties.AutomationId="games-overlay-preview">
       <Grid ColumnSpacing="28" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Spacing="10"><FontIcon Glyph="&#xE9D9;" FontSize="26" Foreground="{ThemeResource RoseBrush}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Text[GmOverlayTitle]}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Text[GmOverlayPreviewHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
         <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="140" ItemHeight="64" HorizontalAlignment="Stretch" app:Fit.MinItemWidth="140">
        <Border Style="{StaticResource CompactCardStyle}" MinWidth="130" Padding="14,12" Margin="0,0,8,8"><TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding Text[GmFps]}"/><Run Text=" —"/></TextBlock></Border>
        <Border Style="{StaticResource CompactCardStyle}" MinWidth="130" Padding="14,12" Margin="0,0,8,8"><TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding Text[GmGpu]}"/><Run Text=" —"/></TextBlock></Border>
        <Border Style="{StaticResource CompactCardStyle}" MinWidth="130" Padding="14,12" Margin="0,0,8,8"><TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding Text[GmCpu]}"/><Run Text=" —"/></TextBlock></Border>
        <Border Style="{StaticResource CompactCardStyle}" MinWidth="130" Padding="14,12" Margin="0,0,8,8"><TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding Text[GmMemory]}"/><Run Text=" —"/></TextBlock></Border>
         </VariableSizedWrapGrid>
         <TextBlock Text="FRAMEPACER" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource RoseBrush}"/>
         <!-- Illustrative sample (not a measurement): a steady line with one small hitch, labeled as an example -->
         <Grid Height="48" AutomationProperties.Name="{Binding Text[GmFrametimeSample]}">
          <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Bottom"/>
          <Polyline Points="0,30 24,29 48,31 72,30 96,30 120,29 144,31 168,30 192,30 216,30 240,8 252,30 276,29 300,31 324,30 348,30 372,29 396,30 420,31 444,30 468,30 492,29 516,30" Stretch="Fill" Margin="0,6,0,6" Stroke="{ThemeResource RoseBrush}" StrokeThickness="2" StrokeLineJoin="Round" Opacity="0.85"/>
         </Grid>
         <Grid><TextBlock Text="{Binding Text[GmFrametimeSample]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,0,120,0"/><TextBlock Text="{Binding Text[GmFrametimeUnit]}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/></Grid>
        </StackPanel>
       </Grid>
      </Border>
      <controls:RtssCard DataContext="{Binding Integrations}"/>
     </StackPanel>
     <controls:GamesPanel x:Name="GamesContent" DataContext="{Binding Games}" DetailsRequested="OnGameDetails"/>
     <!-- Visual 2.0: the Steam highlight comes after the player's own games -->
     <controls:HomeBanner x:Name="GamesBanner" Height="220" Margin="0,16,0,0" Loaded="OnGamesBannerLoaded"/>
    </StackPanel>
    <controls:GameDetailView x:Name="GameDetail" Visibility="Collapsed" DataContext="{Binding GameDetails}" BackRequested="OnGameDetailBack" PlayRequested="OnPlayGame"/>
   </Grid>
   <controls:GameListPanel x:Name="GameListContent" x:Load="{x:Bind ShowGameList}" DataContext="{Binding GameList}" PlayRequested="OnPlayGame"/>
   <controls:SavesPanel x:Name="SavesContent" x:Load="{x:Bind ShowSaves}" DataContext="{Binding Saves}"/>
   <controls:DiaryPanel x:Name="DiaryContent" x:Load="{x:Bind ShowDiary}" DataContext="{Binding Diary}" GameListRequested="OnDiaryGameList"/>
   <controls:ScorePanel x:Name="ScoreContent" x:Load="{x:Bind ShowScore}" DataContext="{Binding Score}"/>
   <controls:ToolsPanel x:Name="ToolsContent" x:Load="{x:Bind ShowTools}" DataContext="{Binding Tools}"/>

   <StackPanel x:Name="SettingsContent" x:Load="{x:Bind ShowSettings}" Spacing="20">
    <SelectorBar x:Name="SettingsTabs" SelectionChanged="OnSettingsTabChanged" AutomationProperties.Name="{Binding Text[UxSettingsCategory]}" AutomationProperties.AutomationId="settings-category"/>
    <StackPanel x:Name="AppearanceContent" x:Load="{x:Bind ShowAppearance}" Spacing="8">
     <controls:AppearancePicker DataContext="{Binding Preferences}" Margin="0,0,0,16"/>
     <TextBlock Text="{Binding Text[AppearanceCategory]}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Text[ProfileEdit]}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button Grid.Column="2" Content="{Binding Text[ProfileEdit]}" Click="OnEditProfile" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="settings-profile"/>
      <Button Grid.Column="3" Content="{Binding Text[ObReplay]}" Click="OnReplayWelcome" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="settings-replay-welcome"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[GdRedoTitle]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[GdRedoHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <Button Grid.Column="2" Content="{Binding Text[GdRedo]}" Click="OnRedoGuided" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="settings-redo-guided"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetStartWithWindows]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetStartWithWindowsHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.StartWithWindows, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetStartWithWindows]}" AutomationProperties.AutomationId="settings-start-windows"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE73F;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetCloseToTray]}" TextWrapping="Wrap"/><TextBlock app:Rich.Text="{Binding Text[SetCloseToTrayHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.CloseToTray, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetCloseToTray]}" AutomationProperties.AutomationId="settings-close-tray"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE736;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetAutoSessions]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetAutoSessionsHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.AutoSessions, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetAutoSessions]}" AutomationProperties.AutomationId="settings-auto-sessions"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE8A4;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetResumePrompts]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetResumePromptsHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.ResumePrompts, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetResumePrompts]}" AutomationProperties.AutomationId="settings-resume-prompts"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetDriverNotices]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetDriverNoticesHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.DriverNotices, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetDriverNotices]}" AutomationProperties.AutomationId="settings-driver-notices"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetPreparePlay]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetPreparePlayHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.PreparePlay, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetPreparePlay]}" AutomationProperties.AutomationId="settings-prepare-play"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetMeasurePorts]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetMeasurePortsHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.MeasurePortsSessions, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetMeasurePorts]}" AutomationProperties.AutomationId="settings-measure-ports"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetMinimizeForGames]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetMinimizeForGamesHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.MinimizeForGames, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetMinimizeForGames]}" AutomationProperties.AutomationId="settings-minimize-for-games"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetGamePriority]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetGamePriorityHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.GamePriority, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetGamePriority]}" AutomationProperties.AutomationId="settings-game-priority"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE767;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetUiSounds]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetUiSoundsHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.UiSounds, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding Text[SetUiSounds]}" AutomationProperties.AutomationId="settings-sounds"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}" Visibility="{Binding Preferences.UiSounds, Converter={StaticResource BooleanVisibility}}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE995;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[SetSoundVolume]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[SetSoundVolumeHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <Slider Grid.Column="2" Minimum="0" Maximum="100" StepFrequency="5" Value="{Binding Preferences.UiSoundVolume, Mode=TwoWay}" ValueChanged="OnVolumeChanged" VerticalAlignment="Center" AutomationProperties.Name="{Binding Text[SetSoundVolume]}" AutomationProperties.AutomationId="settings-volume"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xF2B7;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Text[Language]}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <ComboBox Grid.Column="2" MinWidth="200" SelectedIndex="{Binding Preferences.LanguageIndex, Mode=TwoWay}" ItemsSource="{Binding Preferences.LanguageOptions}" AutomationProperties.AutomationId="settings-language" AutomationProperties.Name="{Binding Text[Language]}"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE769;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Text[ReduceMotion]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Text[BrandMotionPolicy]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.ReduceMotion, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.AutomationId="settings-motion" AutomationProperties.Name="{Binding Text[ReduceMotion]}"/>
     </Grid></Border>
     <TextBlock Text="{Binding Text[ImmediateHint]}" Style="{StaticResource CaptionStyle}" Margin="4,4,0,0"/><TextBlock Text="{Binding Preferences.Message}" Foreground="{ThemeResource RoseBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" app:Motion.Settle="True"/>
    </StackPanel>
    <ContentControl x:Name="MonitoringSettingsContent" x:Load="{x:Bind ShowMonitoringSettings}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><TextBlock Text="{Binding Text[MonitoringCategory]}" Style="{StaticResource SectionTitleStyle}"/><ContentControl Content="{Binding Experience.CollectorStatus}" Style="{StaticResource StatusBadgeStyle}"/><TextBlock Text="{Binding Text[UxMonitoringSettings]}" Style="{StaticResource CaptionStyle}"/></StackPanel></ContentControl>
    <controls:IntegrationsPanel x:Name="IntegrationsContent" x:Load="{x:Bind ShowIntegrations}" DataContext="{Binding Integrations}"/>
    <ContentControl x:Name="SafetyContent" x:Load="{x:Bind ShowSafety}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><Border Style="{StaticResource IconBadgeStyle}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE83D;" Style="{StaticResource BadgeIconStyle}"/></Border><TextBlock Text="{Binding Text[SafetyCategory]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[UxNoChangesDescription]}" Style="{StaticResource BodyStyle}"/>
     <!-- Restore Lotus: start over from the welcome, with the player's data archived (never deleted) -->
     <Border Margin="0,10,0,0" Padding="18,16" CornerRadius="12" Background="{ThemeResource CardHoverBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" AutomationProperties.AutomationId="settings-reset">
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <FontIcon Glyph="&#xE777;" FontSize="22" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
       <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Text[ResetTitle]}" FontWeight="SemiBold" FontSize="14"/><TextBlock app:Rich.Text="{Binding Text[ResetBody]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
       <Button Grid.Column="2" Click="OnResetLotus" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center" MinHeight="44" AutomationProperties.AutomationId="settings-reset-button"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE777;" FontSize="13"/><TextBlock Text="{Binding Text[ResetButton]}"/></StackPanel></Button>
      </Grid>
     </Border>
    </StackPanel></ContentControl>
    <StackPanel x:Name="FaqContent" x:Load="{x:Bind ShowFaq}" Spacing="8">
     <TextBlock Text="{Binding Text[FaqTitle]}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
     <!-- "Antes de começar": the promise that nothing changes without the player (moved from Home in visual 2.0) -->
     <Border CornerRadius="12" Padding="18,12" Margin="0,0,0,8" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="faq-before">
      <StackPanel Orientation="Horizontal" Spacing="12">
       <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
       <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"><Run Text="{Binding Text[HbBeforeTitle]}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Text[HbBeforeBody]}"/></TextBlock>
      </StackPanel>
     </Border>
     <Expander Header="{Binding Text[Fq1Q]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock app:Rich.Text="{Binding Text[Fq1A]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[Fq2Q]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock app:Rich.Text="{Binding Text[Fq2A]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[Fq3Q]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock app:Rich.Text="{Binding Text[Fq3A]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[Fq4Q]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock app:Rich.Text="{Binding Text[Fq4A]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[Fq5Q]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock app:Rich.Text="{Binding Text[Fq5A]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[Fq6Q]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock app:Rich.Text="{Binding Text[Fq6A]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[Fq7Q]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock app:Rich.Text="{Binding Text[Fq7A]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[FaqAmbientQuestion]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[FaqAmbientAnswer]}" Style="{StaticResource BodyStyle}"/></Expander>
     <!-- Development credits -->
     <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" AutomationProperties.AutomationId="settings-credits">
      <StackPanel Spacing="10">
       <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource AccentGradientBrush}"><FontIcon Glyph="&#xE734;" FontSize="17" Foreground="{ThemeResource OnRoseBrush}"/></Border>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Text[CrTitle]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding AppVersion}" Style="{StaticResource CaptionStyle}"/></StackPanel>
       </StackPanel>
       <TextBlock app:Rich.Text="{Binding Text[CrMade]}" Style="{StaticResource BodyStyle}"/>
       <TextBlock app:Rich.Text="{Binding Text[CrOpen]}" Style="{StaticResource BodyStyle}"/>
       <TextBlock app:Rich.Text="{Binding Text[CrThanks]}" Style="{StaticResource CaptionStyle}"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <controls:BackupPanel x:Name="BackupContent" x:Load="{x:Bind ShowBackup}" DataContext="{Binding Backup}"/>
    <controls:UpdatePanel x:Name="UpdatesContent" x:Load="{x:Bind ShowUpdates}" DataContext="{Binding Updates}"/>
    <ContentControl x:Name="AdvancedContent" x:Load="{x:Bind ShowAdvanced}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="14"><TextBlock Text="{Binding Text[AdvancedCategory]}" Style="{StaticResource SectionTitleStyle}"/><StackPanel Spacing="8" Padding="0,0,0,8"><TextBlock Text="{Binding Text[SetupTitle]}" FontWeight="SemiBold"/><TextBlock x:Name="SetupStatus" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Loaded="OnSetupLoaded"/><Button x:Name="SetupButton" Content="{Binding Text[SetupInstall]}" Click="OnInstallLotus" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="setup-install"/></StackPanel><ContentControl Content="{Binding AppVersion}" Style="{StaticResource StatusBadgeStyle}"/><TextBlock Text="{Binding Text[UxLogExplanation]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding LogLocation}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.AutomationId="settings-log-path"/><TextBlock Text="{Binding Experience.CollectorStatus}" Style="{StaticResource CaptionStyle}"/><Expander Header="{Binding Text[UxDataSources]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12"><TextBlock Text="{Binding Text[UxDataSourcesDescription]}" Style="{StaticResource BodyStyle}"/><TextBlock Text="{Binding Monitoring.LastUpdate}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Monitoring.GpuStatus}" Style="{StaticResource CaptionStyle}"/></StackPanel></Expander></StackPanel></ContentControl>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</Page>
