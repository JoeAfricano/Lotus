<Page x:Class="Lotus.App.SectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls" Foreground="{ThemeResource MainTextBrush}" Background="Transparent">
 <ScrollViewer x:Name="PageScroll" SizeChanged="OnViewportSizeChanged" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
  <StackPanel x:Name="PageContent" Padding="32,28,32,40" Spacing="24" HorizontalAlignment="Stretch" SizeChanged="OnContentSizeChanged">
   <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeaderTemplate}" HorizontalContentAlignment="Stretch"/>

   <StackPanel x:Name="HomeContent" x:Load="{x:Bind ShowHome}" Spacing="20">
    <controls:PrimaryActionCard DataContext="{Binding Experience}"/>
    <!-- Your games: quick shortcuts; the cover opens My Games, Play starts the game -->
    <Grid ColumnSpacing="12" Margin="0,8,0,0" Visibility="{Binding Games.HasFeatured, Converter={StaticResource BooleanVisibility}}">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Text[HomeGames]}" Style="{StaticResource SectionTitleStyle}"/>
     <HyperlinkButton Grid.Column="1" Content="{Binding Text[HomeGamesAll]}" Click="OnOpenGames" AutomationProperties.AutomationId="home-games-all"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding Games.Featured}" Visibility="{Binding Games.HasFeatured, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="home-games">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Width="124" Height="166" CornerRadius="14" Background="{ThemeResource HeroBrush}" app:Motion.Hover="1.05" Tapped="OnHomeGameTapped" ToolTipService.ToolTip="{Binding Name}">
       <TextBlock Text="{Binding Initials}" FontFamily="Georgia" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}, ConverterParameter=Invert}"/>
       <Border Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}}"><Border.Background><ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/></Border.Background></Border>
       <Button Command="{Binding Launch}" CommandParameter="{Binding}" Width="40" Height="40" CornerRadius="20" Padding="0" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Background="{ThemeResource AccentGradientBrush}" BorderBrush="#66FFFFFF" BorderThickness="1.5" app:Motion.Press="True" ToolTipService.ToolTip="{Binding PlayLabel}" AutomationProperties.Name="{Binding Name}">
        <FontIcon Glyph="&#xF5B0;" FontSize="15" Foreground="White" Margin="2,0,0,0"/>
       </Button>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Text[UxYourComputer]}" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,0"/>
    <Grid x:Name="SummaryGrid" ColumnSpacing="16" RowSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="CpuSummary" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="12">
      <Border Style="{StaticResource IconBadgeStyle}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE950;" Style="{StaticResource BadgeIconStyle}"/></Border>
      <TextBlock Text="{Binding Text[UxProcessor]}" Style="{StaticResource EyebrowStyle}"/>
      <TextBlock Text="{Binding Experience.CpuModel}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
     </StackPanel></Border>
     <Border x:Name="GpuSummary" Grid.Column="1" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="12">
      <Border Style="{StaticResource IconBadgeStyle}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE7F4;" Style="{StaticResource BadgeIconStyle}"/></Border>
      <TextBlock Text="{Binding Text[UxGraphics]}" Style="{StaticResource EyebrowStyle}"/>
      <TextBlock Text="{Binding Experience.GpuModel}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
     </StackPanel></Border>
     <Border x:Name="RamSummary" Grid.Column="2" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="12">
      <Border Style="{StaticResource IconBadgeStyle}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE964;" Style="{StaticResource BadgeIconStyle}"/></Border>
      <TextBlock Text="{Binding Text[UxMemoryLabel]}" Style="{StaticResource EyebrowStyle}"/>
      <TextBlock Text="{Binding Experience.RamCapacity}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
     </StackPanel></Border>
    </Grid>
    <TextBlock Text="{Binding Experience.SummaryTime}" Style="{StaticResource CaptionStyle}"/>
    <!-- Read-only hardware check -->
    <Border x:Name="HardwareCard" Style="{StaticResource CardStyle}" DataContext="{Binding Hardware}" Loaded="OnHardwareCardLoaded" Margin="0,8,0,0">
     <StackPanel Spacing="14">
      <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE9D9;" Style="{StaticResource BadgeIconStyle}"/></Border>
       <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[HwCardTitle]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionStyle}" AutomationProperties.AutomationId="hw-summary" AutomationProperties.LiveSetting="Polite" app:Motion.Settle="True"/></StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
        <ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}"/>
        <Button Content="{Binding Text[HwCheck]}" Command="{Binding CheckCommand}" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="hw-check"/>
       </StackPanel>
      </Grid>
      <ItemsControl ItemsSource="{Binding Findings}" Visibility="{Binding HasFindings, Converter={StaticResource BooleanVisibility}}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="{ThemeResource CardHoverBrush}" CornerRadius="12" Padding="14,12">
         <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Width="30" Height="30" VerticalAlignment="Top">
           <Border CornerRadius="9" Background="{ThemeResource AccentSoftBrush}"/>
           <FontIcon Glyph="{Binding Glyph}" FontSize="14" Foreground="{Binding IsAttention, Converter={StaticResource AttentionBrush}}"/>
          </Grid>
          <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionStyle}"/></StackPanel>
          <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
           <ContentControl Content="{Binding Level}" Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Right"/>
           <HyperlinkButton Content="{Binding DataContext.Text[HwOpenSettings], ElementName=HardwareCard}" Tag="{Binding SettingsUri}" Click="OnOpenSettings" Visibility="{Binding HasSettings, Converter={StaticResource BooleanVisibility}}" Padding="6,2" HorizontalAlignment="Right"/>
          </StackPanel>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding LastChecked}" Style="{StaticResource CaptionStyle}"/>
     </StackPanel>
    </Border>
   </StackPanel>

   <StackPanel x:Name="OptimizeContent" x:Load="{x:Bind ShowOptimize}" Spacing="20">
    <controls:PowerProfilesPanel DataContext="{Binding PowerProfiles}"/>
    <SelectorBar x:Name="OptimizeTabs" SelectionChanged="OnOptimizeTabChanged" AutomationProperties.Name="{Binding Text[UxOptimizeSections]}">
     <SelectorBarItem Text="{Binding Text[UxResultsTab]}"/><SelectorBarItem Text="{Binding Text[UxRestoreTab]}"/>
    </SelectorBar>
    <ContentControl x:Name="DiagnosisContent" x:Load="{x:Bind ShowDiagnosis}" Style="{StaticResource CardControlStyle}">
     <StackPanel Spacing="16">
      <TextBlock Text="{Binding Text[UxResultsTitle]}" Style="{StaticResource SectionTitleStyle}"/>
      <ContentControl Content="{Binding Experience.Finding}" Style="{StaticResource StatusBadgeStyle}"/>
      <controls:OperationProgress DataContext="{Binding Experience}" Visibility="{Binding Experience.IsAnalyzing, Converter={StaticResource BooleanVisibility}}"/>
      <TextBlock Text="{Binding Experience.Advice}" FontSize="17" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Experience.LastAnalysis}" Style="{StaticResource CaptionStyle}"/>
      <TextBlock Text="{Binding Text[UxAdviceInformational]}" Style="{StaticResource CaptionStyle}"/>
      <Expander Visibility="{Binding Experience.HasResult, Converter={StaticResource BooleanVisibility}}" Header="{Binding Text[UxTechnicalDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
       <StackPanel Spacing="12"><TextBlock Text="{Binding Text[RamAvailableLabel]}" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="{Binding Experience.Available}" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="{Binding Text[RamCapacityLabel]}" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="{Binding Experience.Capacity}"/><TextBlock Text="{Binding Text[RamMinimumLabel]}" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="{Binding Experience.MinimumAvailable}"/><TextBlock Text="{Binding Experience.Evidence}" Style="{StaticResource BodyStyle}"/><TextBlock Text="{Binding Text[RamMethod]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Text[RamCacheExplanation]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Text[RamLimits]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Experience.Source}" Style="{StaticResource CaptionStyle}"/></StackPanel>
      </Expander>
     </StackPanel>
    </ContentControl>
    <controls:OptimizationPanel x:Name="RestoreContent" x:Load="{x:Bind ShowRestore}" DataContext="{Binding Optimizer}"/>
   </StackPanel>

   <StackPanel x:Name="PerformanceContent" x:Load="{x:Bind ShowPerformance}" Spacing="20">
    <SelectorBar x:Name="PerformanceTabs" SelectionChanged="OnPerformanceTabChanged" AutomationProperties.Name="{Binding Text[UxPerformanceSections]}"><SelectorBarItem Text="{Binding Text[UxLiveTab]}"/><SelectorBarItem Text="{Binding Text[UxCompareTab]}"/><SelectorBarItem Text="{Binding Text[UxHistoryTab]}"/></SelectorBar>
    <controls:MonitoringPanel x:Name="MonitoringContent" x:Load="{x:Bind ShowLive}" DataContext="{Binding Monitoring}"/>
    <controls:BenchmarkPanel x:Name="CompareContent" x:Load="{x:Bind ShowCompare}" DataContext="{Binding Benchmark}"/>
    <ContentControl x:Name="HistoryContent" x:Load="{x:Bind ShowHistory}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><Border Style="{StaticResource IconBadgeStyle}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE81C;" Style="{StaticResource BadgeIconStyle}"/></Border><TextBlock Text="{Binding Text[UxHistoryEmptyTitle]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[UxHistoryEmptyDescription]}" Style="{StaticResource CaptionStyle}"/></StackPanel></ContentControl>
   </StackPanel>

   <StackPanel x:Name="GamesArea" x:Load="{x:Bind ShowGames}" Spacing="16">
    <controls:RtssCard DataContext="{Binding Integrations}"/>
    <controls:GamesPanel x:Name="GamesContent" DataContext="{Binding Games}"/>
   </StackPanel>
   <controls:ScorePanel x:Name="ScoreContent" x:Load="{x:Bind ShowScore}" DataContext="{Binding Score}"/>
   <controls:ToolsPanel x:Name="ToolsContent" x:Load="{x:Bind ShowTools}" DataContext="{Binding Tools}"/>

   <StackPanel x:Name="SettingsContent" x:Load="{x:Bind ShowSettings}" Spacing="20">
    <SelectorBar x:Name="SettingsTabs" SelectionChanged="OnSettingsTabChanged" AutomationProperties.Name="{Binding Text[UxSettingsCategory]}" AutomationProperties.AutomationId="settings-category"/>
    <StackPanel x:Name="AppearanceContent" x:Load="{x:Bind ShowAppearance}" Spacing="8">
     <TextBlock Text="{Binding Text[AppearanceCategory]}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Text[ProfileEdit]}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button Grid.Column="2" Content="{Binding Text[ProfileEdit]}" Click="OnEditProfile" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="settings-profile"/>
      <Button Grid.Column="3" Content="{Binding Text[ObReplay]}" Click="OnReplayWelcome" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="settings-replay-welcome"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Text[Theme]}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <ComboBox Grid.Column="2" MinWidth="200" SelectedIndex="{Binding Preferences.ThemeIndex, Mode=TwoWay}" ItemsSource="{Binding Preferences.ThemeOptions}" AutomationProperties.AutomationId="settings-theme" AutomationProperties.Name="{Binding Text[Theme]}"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xF2B7;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Text[Language]}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <ComboBox Grid.Column="2" MinWidth="200" SelectedIndex="{Binding Preferences.LanguageIndex, Mode=TwoWay}" ItemsSource="{Binding Preferences.LanguageOptions}" AutomationProperties.AutomationId="settings-language" AutomationProperties.Name="{Binding Text[Language]}"/>
     </Grid></Border>
     <Border Style="{StaticResource SettingRowStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Text[ReduceMotion]}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <ToggleSwitch Grid.Column="2" IsOn="{Binding Preferences.ReduceMotion, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.AutomationId="settings-motion" AutomationProperties.Name="{Binding Text[ReduceMotion]}"/>
     </Grid></Border>
     <TextBlock Text="{Binding Text[ImmediateHint]}" Style="{StaticResource CaptionStyle}" Margin="4,4,0,0"/><TextBlock Text="{Binding Preferences.Message}" Foreground="{ThemeResource RoseBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" app:Motion.Settle="True"/>
     <Expander Header="{Binding Text[UxMotionDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[BrandMotionPolicy]}" Style="{StaticResource CaptionStyle}"/></Expander>
    </StackPanel>
    <ContentControl x:Name="MonitoringSettingsContent" x:Load="{x:Bind ShowMonitoringSettings}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><TextBlock Text="{Binding Text[MonitoringCategory]}" Style="{StaticResource SectionTitleStyle}"/><ContentControl Content="{Binding Experience.CollectorStatus}" Style="{StaticResource StatusBadgeStyle}"/><TextBlock Text="{Binding Text[UxMonitoringSettings]}" Style="{StaticResource CaptionStyle}"/></StackPanel></ContentControl>
    <controls:IntegrationsPanel x:Name="IntegrationsContent" x:Load="{x:Bind ShowIntegrations}" DataContext="{Binding Integrations}"/>
    <ContentControl x:Name="SafetyContent" x:Load="{x:Bind ShowSafety}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="12"><Border Style="{StaticResource IconBadgeStyle}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE83D;" Style="{StaticResource BadgeIconStyle}"/></Border><TextBlock Text="{Binding Text[SafetyCategory]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[UxNoChangesDescription]}" Style="{StaticResource BodyStyle}"/></StackPanel></ContentControl>
    <StackPanel x:Name="FaqContent" x:Load="{x:Bind ShowFaq}" Spacing="8">
     <TextBlock Text="{Binding Text[FaqTitle]}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
     <Expander Header="{Binding Text[UxProgressDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[UxProgressExplanation]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[FaqAmbientQuestion]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[FaqAmbientAnswer]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[FaqSafetyQuestion]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[FaqSafetyAnswer]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[FaqScopeQuestion]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[UxScope]}" Style="{StaticResource BodyStyle}"/></Expander>
     <Expander Header="{Binding Text[FaqSolutionsQuestion]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="{Binding Text[FaqSolutionsAnswer]}" Style="{StaticResource BodyStyle}"/></Expander>
    </StackPanel>
    <ContentControl x:Name="AdvancedContent" x:Load="{x:Bind ShowAdvanced}" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="14"><TextBlock Text="{Binding Text[AdvancedCategory]}" Style="{StaticResource SectionTitleStyle}"/><StackPanel Spacing="8" Padding="0,0,0,8"><TextBlock Text="{Binding Text[SetupTitle]}" FontWeight="SemiBold"/><TextBlock x:Name="SetupStatus" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Loaded="OnSetupLoaded"/><Button x:Name="SetupButton" Content="{Binding Text[SetupInstall]}" Click="OnInstallLotus" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="setup-install"/></StackPanel><ContentControl Content="{Binding AppVersion}" Style="{StaticResource StatusBadgeStyle}"/><TextBlock Text="{Binding Text[UxLogExplanation]}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding LogLocation}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.AutomationId="settings-log-path"/><TextBlock Text="{Binding Experience.CollectorStatus}" Style="{StaticResource CaptionStyle}"/><Expander Header="{Binding Text[UxDataSources]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12"><TextBlock Text="{Binding Text[UxDataSourcesDescription]}" Style="{StaticResource BodyStyle}"/><TextBlock Text="{Binding Monitoring.LastUpdate}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Monitoring.GpuStatus}" Style="{StaticResource CaptionStyle}"/></StackPanel></Expander></StackPanel></ContentControl>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</Page>
