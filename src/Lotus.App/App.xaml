<Application x:Class="Lotus.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Windows.UI" xmlns:local="using:Lotus.App" RequestedTheme="Dark">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/><ResourceDictionary Source="Controls/Foundation.xaml"/></ResourceDictionary.MergedDictionaries>
  <local:BooleanVisibilityConverter x:Key="BooleanVisibility"/>
  <SolidColorBrush x:Key="ShellBrush" Color="#0C0B12"/><SolidColorBrush x:Key="PaneBrush" Color="#111018"/><SolidColorBrush x:Key="CardBrush" Color="#18141E"/><SolidColorBrush x:Key="CardBorderBrush" Color="#493044"/>
  <SolidColorBrush x:Key="ElevatedBrush" Color="#211723"/><SolidColorBrush x:Key="SuccessBrush" Color="#87C6A5"/><SolidColorBrush x:Key="WarningBrush" Color="#E7BE7A"/><SolidColorBrush x:Key="ErrorBrush" Color="#F3A2AA"/>
  <SolidColorBrush x:Key="OnRoseBrush" Color="#171017"/>
  <SolidColorBrush x:Key="RoseBrush" Color="#E584B1"/><SolidColorBrush x:Key="MutedBrush" Color="#BDB1BC"/><SolidColorBrush x:Key="BadgeBrush" Color="#2B1424"/><SolidColorBrush x:Key="MainTextBrush" Color="#F7F1F6"/>
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0C0B12"/><SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#111018"/><SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#111018"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E584B1"/><SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E77FA3"/><SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C8698B"/><SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#171017"/>


  <ui:Color x:Key="SystemAccentColor">#E584B1</ui:Color>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#432036"/>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#54283F"/>

  <Style x:Key="EyebrowStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource RoseBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="CharacterSpacing" Value="100"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>
