<Application x:Class="Lotus.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Windows.UI" RequestedTheme="Dark">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/><ResourceDictionary Source="Controls/Foundation.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="ShellBrush" Color="#0A0A0F"/><SolidColorBrush x:Key="PaneBrush" Color="#101016"/><SolidColorBrush x:Key="CardBrush" Color="#121219"/><SolidColorBrush x:Key="CardBorderBrush" Color="#68334A"/>
  <SolidColorBrush x:Key="RoseBrush" Color="#FF91B5"/><SolidColorBrush x:Key="MutedBrush" Color="#C8C2CF"/><SolidColorBrush x:Key="BadgeBrush" Color="#2B1424"/><SolidColorBrush x:Key="MainTextBrush" Color="#F5EFF3"/>
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0A0A0F"/><SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#101016"/><SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#101016"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF91B5"/><SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E77FA3"/><SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C8698B"/><SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#171017"/>


  <ui:Color x:Key="SystemAccentColor">#FF2D78</ui:Color>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#432036"/>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#54283F"/>
  <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="EyebrowStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource RoseBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="CharacterSpacing" Value="100"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>
