<Application x:Class="Lotus.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Windows.UI" RequestedTheme="Dark">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
  <ui:Color x:Key="SystemAccentColor">#FF2D78</ui:Color>
  <SolidColorBrush x:Key="RoseBrush" Color="#FF6B9D"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A6A2B0"/>
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0A0A0F"/>
  <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#101016"/>
  <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="#121219"/><Setter Property="BorderBrush" Value="#542337"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="EyebrowStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource RoseBrush}"/><Setter Property="FontSize" Value="10"/><Setter Property="CharacterSpacing" Value="180"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>
