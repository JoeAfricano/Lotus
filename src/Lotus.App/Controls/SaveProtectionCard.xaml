<UserControl x:Class="Lotus.App.Controls.SaveProtectionCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" Visibility="Collapsed" AutomationProperties.AutomationId="game-saves">
 <!-- Shortcut from a game's page to its saves in "Backup de saves" (the settings file only; no folder is read here) -->
 <Border Style="{StaticResource CardStyle}" Padding="18,14">
  <Grid ColumnSpacing="14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource IconBadgeStyle}"><FontIcon x:Name="Icon" Glyph="&#xE74E;" Style="{StaticResource BadgeIconStyle}"/></Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
    <TextBlock x:Name="Title" FontWeight="SemiBold" FontSize="15"/>
    <TextBlock x:Name="Summary" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="game-saves-status"/>
   </StackPanel>
   <Button x:Name="OpenButton" Grid.Column="2" Style="{StaticResource SoftButtonStyle}" Click="OnOpen" VerticalAlignment="Center" app:Motion.Press="True" AutomationProperties.AutomationId="game-saves-open">
    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="OpenText"/><FontIcon Glyph="&#xE76C;" FontSize="12"/></StackPanel>
   </Button>
  </Grid>
 </Border>
</UserControl>
