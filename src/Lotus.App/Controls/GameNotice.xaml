<UserControl x:Class="Lotus.App.Controls.GameNotice" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Visibility="Collapsed" AutomationProperties.AutomationId="game-notice">
 <!-- Same look as the achievement notice: bottom right, never modal, never over the game (it lives in Lotus's window) -->
 <Grid x:Name="Card" Width="400" Opacity="0" CornerRadius="18" BorderBrush="{ThemeResource GoldGradientBrush}" BorderThickness="1.5"
       PointerEntered="OnHold" PointerExited="OnRelease">
  <Grid.RenderTransform><CompositeTransform x:Name="Move" TranslateX="40"/></Grid.RenderTransform>
  <Grid.Background><StaticResource ResourceKey="ElevatedBrush"/></Grid.Background>
  <StackPanel Padding="16,14" Spacing="10">
   <Grid ColumnSpacing="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Width="52" Height="52" VerticalAlignment="Top">
     <Ellipse Fill="{ThemeResource AccentSoftBrush}"/>
     <FontIcon x:Name="Glyph" Glyph="&#xE8A4;" FontSize="20" Foreground="{ThemeResource GoldBrush}"/>
     <Border x:Name="ArtFrame" CornerRadius="26" Visibility="Collapsed"><Border.Background><ImageBrush x:Name="Art" Stretch="UniformToFill"/></Border.Background></Border>
    </Grid>
    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
     <TextBlock x:Name="Eyebrow" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource GoldBrush}"/>
     <TextBlock x:Name="Title" FontSize="15.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="game-notice-title"/>
     <TextBlock x:Name="Body" FontSize="12.5" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <Button Grid.Column="2" Click="OnClose" Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Top" AutomationProperties.AutomationId="game-notice-close" x:Name="CloseButton">
     <FontIcon Glyph="&#xE711;" FontSize="11"/>
    </Button>
   </Grid>
   <!-- Writing the note right here, without leaving the screen -->
   <TextBox x:Name="Note" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxLength="600" Visibility="Collapsed" GotFocus="OnNoteFocus" AutomationProperties.AutomationId="game-notice-note"/>
   <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"/>
  </StackPanel>
  <Rectangle x:Name="Timer" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5" Fill="{ThemeResource GoldGradientBrush}" RadiusX="1.5" RadiusY="1.5" Margin="14,0,14,1">
   <Rectangle.RenderTransform><ScaleTransform x:Name="TimerScale" ScaleX="1"/></Rectangle.RenderTransform>
  </Rectangle>
 </Grid>
</UserControl>
