<UserControl x:Class="Lotus.App.Controls.PlayerPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" Visibility="Collapsed" AutomationProperties.AutomationId="player-panel">
 <Grid>
  <Border x:Name="Backdrop" Background="#990C060A" Opacity="0" Tapped="OnBackdrop"/>
  <Grid x:Name="Sheet" Width="440" HorizontalAlignment="Right" Background="{ThemeResource WindowBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1,0,0,0">
   <Grid.RenderTransform><TranslateTransform x:Name="SheetShift" X="460"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- Who -->
   <Grid Padding="24,22,20,16" ColumnSpacing="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Width="56" Height="56">
     <Border CornerRadius="16" Background="{ThemeResource AccentGradientBrush}"><TextBlock x:Name="Initial" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource OnRoseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border x:Name="Picture" CornerRadius="16" Visibility="Collapsed"><Border.Background><ImageBrush x:Name="PictureBrush" Stretch="UniformToFill"/></Border.Background></Border>
    </Grid>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
     <TextBlock x:Name="PlayerName" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Stats}" Style="{StaticResource CaptionStyle}"/>
     <TextBlock Text="{Binding TotalHours}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}" Visibility="{Binding HasTotal, Converter={StaticResource BooleanVisibility}}"/>
    </StackPanel>
    <Button x:Name="CloseButton" Grid.Column="2" Click="OnClose" Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Top" AutomationProperties.Name="{Binding Text[PpClose]}" AutomationProperties.AutomationId="player-close"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
   </Grid>
   <ScrollViewer Grid.Row="1" Padding="24,0,20,24" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="18">
     <!-- Diary in miniature: level, XP, quick numbers, what's on the shelf, and the way into the full diary -->
     <Border x:Name="DiaryMini" CornerRadius="16" Padding="16,14" BorderBrush="{ThemeResource GoldGradientBrush}" BorderThickness="1" AutomationProperties.AutomationId="player-diary">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#55C2185B" Offset="0"/><GradientStop Color="#2AE7AE93" Offset="1"/></LinearGradientBrush></Border.Background>
      <StackPanel Spacing="10">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource GoldGradientBrush}"><TextBlock x:Name="MiniLevel" FontWeight="Bold" FontSize="18" Foreground="#3A0F24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
         <Grid><TextBlock x:Name="MiniTitle" FontWeight="SemiBold"/><TextBlock x:Name="MiniXp" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/></Grid>
         <ProgressBar x:Name="MiniBar" Maximum="100" MinHeight="6" CornerRadius="3"/>
        </StackPanel>
       </Grid>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="MiniDone" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock x:Name="MiniDoneLabel" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock x:Name="MiniHours" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock x:Name="MiniHoursLabel" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock x:Name="MiniBadges" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock x:Name="MiniBadgesLabel" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
       </Grid>
       <StackPanel x:Name="MiniShelf" Orientation="Horizontal" Spacing="8"/>
       <Button x:Name="MiniOpen" Click="OnOpenDiary" Visibility="Collapsed"/>
      </StackPanel>
     </Border>
     <!-- Last played -->
     <Grid x:Name="LastCard" Height="170" CornerRadius="16" Background="{ThemeResource HeroBrush}" Visibility="{Binding HasLast, Converter={StaticResource BooleanVisibility}}">
      <Image x:Name="LastArt" Stretch="UniformToFill" Opacity="0"/>
      <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2012090F" Offset="0"/><GradientStop Color="#E612090F" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
      <StackPanel VerticalAlignment="Bottom" Padding="18,0,18,16" Spacing="4">
       <TextBlock Text="{Binding Text[PpLast]}" Style="{StaticResource EyebrowStyle}" Foreground="{ThemeResource GoldBrush}"/>
       <TextBlock Text="{Binding Last.Name}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="White"/>
       <TextBlock Text="{Binding Last.Note}" FontSize="12.5" FontStyle="Italic" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="#F2FFE4EE" Visibility="{Binding Last.HasNote, Converter={StaticResource BooleanVisibility}}" ToolTipService.ToolTip="{Binding Last.Note}" AutomationProperties.AutomationId="player-last-note"/>
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Last.When}" FontSize="12.5" Foreground="#D9FFF0F6" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Click="OnPlayLast" Style="{StaticResource PrimaryButtonStyle}" MinHeight="34" Padding="14,4" AutomationProperties.AutomationId="player-play-last">
         <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF5B0;" FontSize="12"/><TextBlock Text="{Binding Text[GiPlay]}"/></StackPanel>
        </Button>
       </Grid>
      </StackPanel>
     </Grid>

     <!-- No last game yet: an invitation instead of an empty card -->
     <Border Padding="16,14" CornerRadius="16" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Visibility="{Binding HasLast, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}">
      <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7FC;" FontSize="20" Foreground="{ThemeResource RoseBrush}"/><TextBlock Text="{Binding Text[PpNoLast]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" MaxWidth="330"/></StackPanel>
     </Border>

     <!-- My games: favorite + note -->
     <StackPanel Spacing="4">
      <TextBlock Text="{Binding Text[PpGames]}" Style="{StaticResource SectionTitleStyle}"/>
      <TextBlock Text="{Binding Text[PpGamesHint]}" Style="{StaticResource CaptionStyle}"/>
     </StackPanel>
     <TextBlock Text="{Binding Text[PpNoGames]}" Style="{StaticResource CaptionStyle}" Visibility="{Binding HasGames, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}"/>
     <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="player-games">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Tag="noterow" Padding="10" CornerRadius="12" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="50" CornerRadius="8" Background="{ThemeResource HeroBrush}">
           <Border.Child><Image Source="{Binding Cover, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/></Border.Child>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding When}" FontSize="11.5" Foreground="{ThemeResource MutedBrush}"/>
          </StackPanel>
          <Button Grid.Column="2" Click="OnStar" Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Center"
                  ToolTipService.ToolTip="{Binding DataContext.Text[PpFavorite], ElementName=Sheet}" AutomationProperties.Name="{Binding Name}">
           <FontIcon Glyph="{Binding StarGlyph}" FontSize="16" Foreground="{ThemeResource GoldBrush}"/>
          </Button>
          <Button Grid.Column="3" Click="OnNoteToggle" Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding DataContext.Text[PpNote], ElementName=Sheet}">
           <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource RoseBrush}"/>
          </Button>
         </Grid>
         <TextBlock Text="{Binding Note}" FontSize="12.5" TextWrapping="Wrap" Foreground="{ThemeResource GoldBrush}" Visibility="{Binding HasNote, Converter={StaticResource BooleanVisibility}}" Margin="50,0,0,0"/>
         <TextBox Visibility="Collapsed" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MaxLength="600" PlaceholderText="{Binding DataContext.Text[PpNotePlaceholder], ElementName=Sheet}" KeyDown="OnNoteKey" LostFocus="OnNoteDone" Margin="50,0,0,0"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>

    </StackPanel>
   </ScrollViewer>
   <!-- Fixed footer: the two ways out of the panel -->
   <Grid Grid.Row="2" Padding="24,12,20,20" ColumnSpacing="10" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Click="OnEditProfile" Style="{StaticResource SoftButtonStyle}" HorizontalAlignment="Stretch" MinHeight="44" AutomationProperties.AutomationId="player-edit">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE77B;" FontSize="13"/><TextBlock Text="{Binding Text[ProfileEdit]}"/></StackPanel>
    </Button>
    <Button Grid.Column="1" Click="OnOpenDiary" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" MinHeight="44" AutomationProperties.AutomationId="player-open-diary">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE736;" FontSize="13"/><TextBlock Text="{Binding Text[diaryTitle]}"/></StackPanel>
    </Button>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
