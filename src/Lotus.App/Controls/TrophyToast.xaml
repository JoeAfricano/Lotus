<UserControl x:Class="Lotus.App.Controls.TrophyToast" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Visibility="Collapsed" AutomationProperties.AutomationId="trophy-toast">
 <Grid x:Name="Card" Width="384" Opacity="0" CornerRadius="18" BorderBrush="{ThemeResource GoldGradientBrush}" BorderThickness="1.5"
       PointerEntered="OnHold" PointerExited="OnRelease">
  <Grid.RenderTransform><CompositeTransform x:Name="Move" TranslateX="40"/></Grid.RenderTransform>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF2A1020" Offset="0"/><GradientStop Color="#FF1A0B14" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid Padding="16,14" ColumnSpacing="14" RowSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- Medal (Lotus) or game art (Steam) -->
   <Grid x:Name="Medal" Width="60" Height="60" VerticalAlignment="Top">
    <Grid.RenderTransform><CompositeTransform x:Name="MedalSpin" CenterX="30" CenterY="30"/></Grid.RenderTransform>
    <Ellipse x:Name="MedalFill" Fill="{ThemeResource GoldGradientBrush}"/>
    <Ellipse Stroke="#66FFFFFF" StrokeThickness="1.3" Margin="5"/>
    <FontIcon x:Name="MedalGlyph" Glyph="&#xE735;" FontSize="24" Foreground="#2A0F1E"/>
    <Border x:Name="ArtFrame" CornerRadius="30" Visibility="Collapsed"><Border.Background><ImageBrush x:Name="Art" Stretch="UniformToFill"/></Border.Background></Border>
   </Grid>
   <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
    <TextBlock x:Name="Eyebrow" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource GoldBrush}"/>
    <TextBlock x:Name="Title" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="trophy-toast-title"/>
    <TextBlock x:Name="Body" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <Button Grid.Column="2" Click="OnClose" Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Top" AutomationProperties.Name="Fechar" AutomationProperties.AutomationId="trophy-toast-close"><FontIcon Glyph="&#xE711;" FontSize="11"/></Button>
   <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border x:Name="XpPill" CornerRadius="10" Padding="10,3" Background="{ThemeResource AccentGradientBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
     <TextBlock x:Name="XpText" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource OnRoseBrush}"/>
    </Border>
    <Button x:Name="ViewButton" Grid.Column="1" Click="OnView" Style="{StaticResource SoftButtonStyle}" Padding="12,5" AutomationProperties.AutomationId="trophy-toast-view">
     <TextBlock x:Name="ViewLabel" FontSize="12.5"/>
    </Button>
   </Grid>
  </Grid>
  <!-- Time left -->
  <Rectangle x:Name="Timer" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5" Fill="{ThemeResource GoldGradientBrush}" RadiusX="1.5" RadiusY="1.5" Margin="14,0,14,1">
   <Rectangle.RenderTransform><ScaleTransform x:Name="TimerScale" ScaleX="1"/></Rectangle.RenderTransform>
  </Rectangle>
 </Grid>
</UserControl>
