<UserControl x:Class="Lotus.App.Controls.DiaryEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" Visibility="Collapsed" AutomationProperties.AutomationId="diary-editor">
 <Grid>
  <Border x:Name="Backdrop" Background="#B30C060A" Opacity="0" Tapped="OnBackdrop"/>
  <Grid x:Name="Card" MaxWidth="1120" Margin="24,20" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="{ThemeResource WindowBrush}"
        BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="22" Opacity="0">
   <Grid.RenderTransform><CompositeTransform x:Name="CardMove" TranslateY="24"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <!-- Cinematic header: wide art drifting slowly, a larger cover and the score in a colored ring -->
   <Grid Height="220" CornerRadius="21,21,0,0" Background="#160C14" RequestedTheme="Dark">
    <!-- Banner: the store's own wide art (Steam hero, Epic key art, GOG background) fades in over the quick fallback -->
    <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="HeaderZoom"/></Grid.RenderTransform>
     <Image x:Name="HeaderArt" Stretch="UniformToFill" Opacity="0.85"/>
     <Image x:Name="BannerArt" Stretch="UniformToFill" Opacity="0" ImageOpened="OnStoreArtOpened" ImageFailed="OnStoreArtFailed"/>
    </Grid>
    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#22160C14" Offset="0"/><GradientStop Color="#99160C14" Offset="0.55"/><GradientStop Color="#FA160C14" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#CC160C14" Offset="0"/><GradientStop Color="#00160C14" Offset="0.6"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Grid Padding="28,0,28,22" VerticalAlignment="Bottom" ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="112" Height="150" CornerRadius="12" Background="{ThemeResource CardBrush}" BorderBrush="#55EEC1A8" BorderThickness="1.5" Translation="0,0,24">
      <Border.Shadow><ThemeShadow/></Border.Shadow>
      <Image x:Name="CoverArt" Stretch="UniformToFill"/>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
      <TextBlock x:Name="Eyebrow" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" Foreground="#F07A9C"/>
      <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <!-- Score ring -->
     <Grid Grid.Column="2" Width="104" Height="104" VerticalAlignment="Bottom">
      <Ellipse Width="104" Height="104" Stroke="#33FFFFFF" StrokeThickness="7"/>
      <Path x:Name="ScoreArc" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
       <TextBlock x:Name="ScoreBig" Text="{Binding RatingText}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
       <TextBlock Text="{Binding RatingLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E6D6DE" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="86" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
    </Grid>
    <Button Click="OnCancel" Background="#8012090F" BorderThickness="0" Padding="9" CornerRadius="18" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="{Binding Text[DyCancel]}"><FontIcon Glyph="&#xE711;" FontSize="12" Foreground="White"/></Button>
   </Grid>

   <ScrollViewer Grid.Row="1" Padding="28,18,28,12" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="Columns" ColumnSpacing="28" RowSpacing="22" Padding="0,0,12,6" SizeChanged="OnColumnsSize">
     <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

     <!-- Left: score, categories, status -->
     <StackPanel x:Name="LeftColumn" Spacing="22">
      <StackPanel Spacing="8">
       <TextBlock Text="{Binding Text[DyScore]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
       <Slider x:Name="ScoreSlider" Minimum="0" Maximum="10" StepFrequency="0.5" TickFrequency="1" TickPlacement="Outside" Value="{Binding Rating, Mode=TwoWay}" ValueChanged="OnScore" AutomationProperties.Name="{Binding Text[DyScore]}" AutomationProperties.AutomationId="diary-score"/>
       <Grid><TextBlock Text="0" FontSize="11" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="10" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right"/></Grid>
      </StackPanel>
      <!-- Category scores (optional); their average can become the score -->
      <StackPanel Spacing="8">
       <Grid><TextBlock Text="{Binding Text[DyCategories]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
        <HyperlinkButton Content="{Binding CategoryAverageText}" Click="OnUseAverage" Padding="4,0" FontSize="12" HorizontalAlignment="Right" Visibility="{Binding CategoryAverageText, Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="diary-use-average"/></Grid>
       <ItemsControl ItemsSource="{Binding Categories}" AutomationProperties.AutomationId="diary-categories">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="10" StepFrequency="0.5" Value="{Binding Value, Mode=TwoWay}" ValueChanged="OnCategory" AutomationProperties.Name="{Binding Label}"/>
          <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource GoldBrush}"/>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <!-- Status: illustrated cards, each in its own color -->
      <StackPanel Spacing="8">
       <TextBlock Text="{Binding Text[DyStatus]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
       <ItemsControl x:Name="StatusList" ItemsSource="{Binding Statuses}" AutomationProperties.AutomationId="diary-status">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="170" ItemHeight="66"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Click="OnStatus" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="14" Padding="12,8" app:Motion.Press="True"
                 Background="{ThemeResource CardBrush}" BorderThickness="1.5" BorderBrush="{ThemeResource CardBorderBrush}" AutomationProperties.Name="{Binding Label}">
          <StackPanel Orientation="Horizontal" Spacing="10">
           <Grid Width="32" Height="32"><Ellipse Fill="{ThemeResource SubtleBrush}"/><FontIcon Glyph="{Binding Glyph}" FontSize="14"/></Grid>
           <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </StackPanel>

     <!-- Right: details, playthroughs, feats, moods, review -->
     <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="22">
      <StackPanel Spacing="10">
       <TextBlock Text="{Binding Text[DyDetails]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
       <Grid ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ComboBox Header="{Binding Text[DyPlatform]}" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
        <StackPanel Grid.Column="1" Spacing="2">
         <NumberBox Header="{Binding Text[DyHours]}" Value="{Binding Hours, Mode=TwoWay}" Minimum="0" Maximum="100000" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="diary-hours"/>
         <HyperlinkButton Content="{Binding SteamHoursLabel}" Click="OnSteamHours" Padding="0,2" FontSize="12" Visibility="{Binding HasSteamHours, Converter={StaticResource BooleanVisibility}}"/>
        </StackPanel>
        <ComboBox Grid.Column="2" Header="{Binding Text[DyDifficulty]}" ItemsSource="{Binding Difficulties}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Difficulty, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="diary-difficulty"/>
        <CalendarDatePicker x:Name="StartPicker" Grid.Row="1" Header="{Binding Text[DyStarted]}" DateChanged="OnStartChanged" HorizontalAlignment="Stretch"/>
        <CalendarDatePicker x:Name="EndPicker" Grid.Row="1" Grid.Column="1" Header="{Binding Text[DyFinished]}" DateChanged="OnEndChanged" HorizontalAlignment="Stretch"/>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding DateError}" Foreground="{ThemeResource ErrorBrush}" FontSize="12.5" TextWrapping="Wrap" Visibility="{Binding DateError, Converter={StaticResource PresenceVisibility}}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="diary-date-error"/>
       </Grid>
      </StackPanel>
      <!-- "Onde eu parei?": a personal note saved on its own (never changes score, hours or status) -->
      <StackPanel Spacing="8" Visibility="{Binding ResumeAvailable, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-resume">
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE8A4;" FontSize="14" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Text[RnTitle]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
        <Border Grid.Column="2" CornerRadius="8" Padding="8,2" Background="{ThemeResource AccentSoftBrush}" VerticalAlignment="Center" Visibility="{Binding ResumeFromLastSession, Converter={StaticResource BooleanVisibility}}">
         <TextBlock Text="{Binding Text[RnLastSession]}" FontSize="11.5" Foreground="{ThemeResource GoldBrush}"/>
        </Border>
       </Grid>
       <TextBlock Text="{Binding Text[RnHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Visibility="{Binding ShowResumeEmpty, Converter={StaticResource BooleanVisibility}}"/>
       <!-- Saved note -->
       <Border Padding="14,10" CornerRadius="12" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Visibility="{Binding ShowResumeText, Converter={StaticResource BooleanVisibility}}">
        <StackPanel Spacing="4">
         <TextBlock Text="{Binding ResumeText}" TextWrapping="Wrap" FontSize="14" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="diary-resume-text"/>
         <TextBlock Text="{Binding ResumeUpdatedText}" Style="{StaticResource CaptionStyle}"/>
        </StackPanel>
       </Border>
       <!-- Writing -->
       <TextBox Text="{Binding ResumeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Text[RnPlaceholder]}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="{Binding ResumeLimit}"
                Visibility="{Binding ResumeEditing, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="{Binding Text[RnTitle]}" AutomationProperties.AutomationId="diary-resume-box"/>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Click="OnResumeWrite" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding ShowResumeEmpty, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-resume-write">
         <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="13"/><TextBlock Text="{Binding Text[RnWrite]}"/></StackPanel>
        </Button>
        <Button Click="OnResumeSave" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding ResumeEditing, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-resume-save">
         <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="13"/><TextBlock Text="{Binding Text[RnSave]}"/></StackPanel>
        </Button>
        <Button Click="OnResumeCancel" Style="{StaticResource SoftButtonStyle}" Content="{Binding Text[DlgCancel]}" Visibility="{Binding ResumeEditing, Converter={StaticResource BooleanVisibility}}"/>
        <Button Click="OnResumeWrite" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding ShowResumeText, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-resume-edit">
         <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="13"/><TextBlock Text="{Binding Text[RnEdit]}"/></StackPanel>
        </Button>
        <Button Click="OnResumeClear" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding ShowResumeText, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-resume-clear">
         <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="13"/><TextBlock Text="{Binding Text[RnClear]}"/></StackPanel>
        </Button>
        <TextBlock Text="{Binding ResumeStatus}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" app:Motion.Settle="True"/>
       </StackPanel>
      </StackPanel>
      <!-- Extra playthroughs -->
      <StackPanel Spacing="8">
       <Grid><TextBlock Text="{Binding Text[DyRuns]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
        <HyperlinkButton Click="OnAddRun" Padding="4,0" FontSize="12.5" HorizontalAlignment="Right" AutomationProperties.AutomationId="diary-add-run"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="11"/><TextBlock Text="{Binding Text[DyRunAdd]}"/></StackPanel></HyperlinkButton></Grid>
       <TextBlock Text="{Binding Text[DyRunsHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
       <ItemsControl ItemsSource="{Binding Runs}" AutomationProperties.AutomationId="diary-runs">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Padding="12,10" CornerRadius="12" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
          <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <CalendarDatePicker Date="{Binding Started, Mode=TwoWay}" PlaceholderText="—" HorizontalAlignment="Stretch"/>
           <CalendarDatePicker Grid.Column="1" Date="{Binding Finished, Mode=TwoWay}" PlaceholderText="—" HorizontalAlignment="Stretch"/>
           <NumberBox Grid.Column="2" Value="{Binding Hours, Mode=TwoWay}" Minimum="0" Maximum="100000" SpinButtonPlacementMode="Hidden"/>
           <Button Grid.Column="3" Click="OnRemoveRun" Background="Transparent" BorderThickness="0" Padding="8"><FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource ErrorBrush}"/></Button>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <!-- Feats -->
      <StackPanel Spacing="6">
       <TextBlock Text="{Binding Text[DyFeats]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
       <TextBlock Text="{Binding Text[DyFeatsHint]}" Style="{StaticResource CaptionStyle}"/>
       <ItemsControl ItemsSource="{Binding FeatToggles}" Margin="0,4,0,0" AutomationProperties.AutomationId="diary-feats">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="172" ItemHeight="46"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <ToggleButton IsChecked="{Binding Selected, Mode=TwoWay}" Click="OnFeat" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="20" AutomationProperties.Name="{Binding Label}">
          <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="{Binding Glyph}" FontSize="13"/><TextBlock Text="{Binding Label}" FontSize="12.5"/></StackPanel>
         </ToggleButton>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <!-- How it felt -->
      <StackPanel Spacing="6">
       <TextBlock Text="{Binding Text[DyMoods]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
       <ItemsControl ItemsSource="{Binding Moods}" Margin="0,4,0,0" AutomationProperties.AutomationId="diary-moods">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="44"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <ToggleButton IsChecked="{Binding Selected, Mode=TwoWay}" Click="OnFeat" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="20" AutomationProperties.Name="{Binding Label}">
          <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="{Binding Glyph}" FontSize="12"/><TextBlock Text="{Binding Label}" FontSize="12.5"/></StackPanel>
         </ToggleButton>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <!-- Review -->
      <StackPanel Spacing="6">
       <TextBlock Text="{Binding Text[DyReview]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
       <TextBox Text="{Binding Review, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Text[DyReviewPlaceholder]}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="320" MaxLength="5000" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="diary-review"/>
       <TextBlock Text="{Binding ReviewCount}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" FontSize="11.5"/>
      </StackPanel>
     </StackPanel>
    </Grid>
   </ScrollViewer>

   <!-- Footer -->
   <Grid Grid.Row="2" Padding="28,12,28,20" ColumnSpacing="10" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Click="OnRemove" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding CanRemove, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-remove">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource ErrorBrush}"/><TextBlock Text="{Binding Text[DyRemove]}"/></StackPanel>
    </Button>
    <Button Grid.Column="2" Content="{Binding Text[DyCancel]}" Click="OnCancel" Style="{StaticResource SoftButtonStyle}" MinWidth="110"/>
    <Button x:Name="SaveButton" Grid.Column="3" Click="OnSave" IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" AutomationProperties.AutomationId="diary-save">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="13"/><TextBlock x:Name="SaveLabel"/></StackPanel>
    </Button>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
