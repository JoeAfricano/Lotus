<UserControl x:Class="Lotus.App.Controls.DiaryEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" Visibility="Collapsed" AutomationProperties.AutomationId="diary-editor">
 <Grid>
  <Border x:Name="Backdrop" Background="#B30C060A" Opacity="0" Tapped="OnBackdrop"/>
  <Grid x:Name="Card" MaxWidth="780" Margin="24,20" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="{ThemeResource WindowBrush}"
        BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="22" Opacity="0">
   <Grid.RenderTransform><CompositeTransform x:Name="CardMove" TranslateY="24"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <!-- Header: wide art, cover, name, big score -->
   <Grid Height="170" CornerRadius="21,21,0,0" Background="{ThemeResource HeroBrush}">
    <Image x:Name="HeaderArt" Stretch="UniformToFill" Opacity="0.55"/>
    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3312090F" Offset="0"/><GradientStop Color="#FA170B13" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Grid Padding="24,0,20,18" VerticalAlignment="Bottom" ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="78" Height="104" CornerRadius="10" Background="{ThemeResource CardBrush}" BorderBrush="#33FFFFFF" BorderThickness="1"><Image x:Name="CoverArt" Stretch="UniformToFill"/></Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="2">
      <TextBlock x:Name="Eyebrow" Style="{StaticResource EyebrowStyle}" Foreground="{ThemeResource GoldBrush}"/>
      <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
      <TextBlock x:Name="ScoreBig" Text="{Binding RatingText}" FontSize="44" FontWeight="Bold" HorizontalAlignment="Right" LineHeight="46"/>
      <TextBlock Text="{Binding Text[DyScore]}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/>
     </StackPanel>
    </Grid>
    <Button Click="OnCancel" Background="#8012090F" BorderThickness="0" Padding="9" CornerRadius="18" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="{Binding Text[DyCancel]}"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
   </Grid>

   <ScrollViewer Grid.Row="1" Padding="24,6,24,10" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Padding="0,10,16,6">
     <!-- Score -->
     <StackPanel Spacing="4">
      <Grid><TextBlock Text="{Binding Text[DyScore]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/><TextBlock Text="{Binding Text[DyScoreHint]}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Slider x:Name="ScoreSlider" Minimum="0" Maximum="10" StepFrequency="0.5" TickFrequency="1" TickPlacement="Outside" Value="{Binding Rating, Mode=TwoWay}" ValueChanged="OnScore" AutomationProperties.Name="{Binding Text[DyScore]}" AutomationProperties.AutomationId="diary-score"/>
     </StackPanel>
     <!-- Status -->
     <StackPanel Spacing="8">
      <TextBlock Text="{Binding Text[DyStatus]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
      <ItemsControl ItemsSource="{Binding Statuses}" AutomationProperties.AutomationId="diary-status">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="142" ItemHeight="52"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button Click="OnStatus" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="22" Padding="8,4" app:Motion.Press="True"
                Background="{Binding Selected, Converter={StaticResource SelectedSurface}}" BorderBrush="{Binding Selected, Converter={StaticResource SelectedBorder}}" BorderThickness="1.5" AutomationProperties.Name="{Binding Label}">
         <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="{Binding Glyph}" FontSize="13"/><TextBlock Text="{Binding Label}" FontSize="13"/></StackPanel>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <!-- Details -->
     <StackPanel Spacing="10">
      <TextBlock Text="{Binding Text[DyDetails]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
      <Grid ColumnSpacing="12" RowSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ComboBox Header="{Binding Text[DyPlatform]}" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
       <StackPanel Grid.Column="1" Spacing="2">
        <NumberBox Header="{Binding Text[DyHours]}" Value="{Binding Hours, Mode=TwoWay}" Minimum="0" Maximum="100000" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="diary-hours"/>
        <HyperlinkButton Content="{Binding SteamHoursLabel}" Click="OnSteamHours" Padding="0,2" FontSize="12" Visibility="{Binding HasSteamHours, Converter={StaticResource BooleanVisibility}}"/>
       </StackPanel>
       <CalendarDatePicker x:Name="StartPicker" Grid.Row="1" Header="{Binding Text[DyStarted]}" DateChanged="OnStartChanged" HorizontalAlignment="Stretch"/>
       <CalendarDatePicker x:Name="EndPicker" Grid.Row="1" Grid.Column="1" Header="{Binding Text[DyFinished]}" DateChanged="OnEndChanged" HorizontalAlignment="Stretch"/>
      </Grid>
     </StackPanel>
     <!-- Feats -->
     <StackPanel Spacing="6">
      <TextBlock Text="{Binding Text[DyFeats]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
      <TextBlock Text="{Binding Text[DyFeatsHint]}" Style="{StaticResource CaptionStyle}"/>
      <ItemsControl ItemsSource="{Binding FeatToggles}" Margin="0,4,0,0" AutomationProperties.AutomationId="diary-feats">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="178" ItemHeight="48"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <ToggleButton IsChecked="{Binding Selected, Mode=TwoWay}" Click="OnFeat" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="20" AutomationProperties.Name="{Binding Label}">
         <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="{Binding Glyph}" FontSize="13"/><TextBlock Text="{Binding Label}" FontSize="12.5"/></StackPanel>
        </ToggleButton>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <!-- Review -->
     <StackPanel Spacing="6">
      <TextBlock Text="{Binding Text[DyReview]}" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
      <TextBox Text="{Binding Review, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Text[DyReviewPlaceholder]}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="320" MaxLength="5000" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="diary-review"/>
      <TextBlock Text="{Binding ReviewCount}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" FontSize="11.5"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>

   <!-- Footer -->
   <Grid Grid.Row="2" Padding="24,12,24,20" ColumnSpacing="10" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Click="OnRemove" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding CanRemove, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-remove">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource ErrorBrush}"/><TextBlock Text="{Binding Text[DyRemove]}"/></StackPanel>
    </Button>
    <Button Grid.Column="2" Content="{Binding Text[DyCancel]}" Click="OnCancel" Style="{StaticResource SoftButtonStyle}" MinWidth="110"/>
    <Button Grid.Column="3" Click="OnSave" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" AutomationProperties.AutomationId="diary-save">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="13"/><TextBlock x:Name="SaveLabel"/></StackPanel>
    </Button>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
