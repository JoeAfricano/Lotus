<UserControl x:Class="Lotus.App.Controls.DiaryPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" xmlns:local="using:Lotus.App.Controls" AutomationProperties.AutomationId="diary">
 <StackPanel Spacing="18">
  <!-- Profile header: compact band or the full layout (the player picks; remembered) -->
  <Border Style="{StaticResource HeroCardStyle}" Padding="20,14">
   <Grid RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="HeaderCompact" ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Width="60" Height="60" VerticalAlignment="Center">
     <Ellipse Fill="{ThemeResource AccentGradientBrush}"/>
     <TextBlock x:Name="Initial" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource OnRoseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Ellipse x:Name="Picture" Visibility="Collapsed"><Ellipse.Fill><ImageBrush x:Name="PictureBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
     <Ellipse Stroke="{ThemeResource GoldGradientBrush}" StrokeThickness="2"/>
     <Border CornerRadius="9" Padding="6,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-8" Background="{ThemeResource GoldGradientBrush}">
      <TextBlock Text="{Binding Progress.Level}" FontWeight="Bold" FontSize="11" Foreground="#3A0F24"/>
     </Border>
    </Grid>
    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <Border CornerRadius="9" Padding="8,2" Background="{ThemeResource AccentSoftBrush}" VerticalAlignment="Center"><TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"><Run Text="{Binding LevelText}"/><Run Text=" · "/><Run Text="{Binding TitleText}"/></TextBlock></Border>
     </StackPanel>
     <TextBox x:Name="BioBox" Text="{Binding Bio, Mode=TwoWay}" PlaceholderText="{Binding Text[DyBioPlaceholder]}" MaxLength="160" Background="Transparent" BorderThickness="0,0,0,1" Padding="0,2" FontSize="13" MinHeight="26" MinWidth="280" HorizontalAlignment="Left"
              AutomationProperties.Name="{Binding Text[DyBio]}" AutomationProperties.AutomationId="diary-bio"/>
    </StackPanel>
    <!-- Stats: four compact numbers in a row -->
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
     <StackPanel><TextBlock Text="{Binding StatCompleted}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[DyStatCompleted]}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
     <StackPanel><TextBlock Text="{Binding StatHours}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[DyStatHours]}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
     <StackPanel><TextBlock Text="{Binding StatAverage}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[DyStatAverage]}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
     <StackPanel><TextBlock Text="{Binding StatYear}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[DyStatYear]}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="3" Width="190" Spacing="5" VerticalAlignment="Center">
     <Grid><TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="{Binding XpText}" FontSize="11.5" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right"/></Grid>
     <ProgressBar x:Name="XpBar" Maximum="100" MinHeight="6" CornerRadius="3"/>
     <TextBlock Text="{Binding Achievements.SummaryText}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
    </StackPanel>
    </Grid>
    <Grid x:Name="HeaderFull" ColumnSpacing="22" RowSpacing="18" Padding="6,8,6,4" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Width="96" Height="96">
     <Ellipse Fill="{ThemeResource AccentGradientBrush}"/>
     <TextBlock x:Name="FullInitial" FontSize="36" FontWeight="SemiBold" Foreground="{ThemeResource OnRoseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Ellipse x:Name="FullPicture" Visibility="Collapsed"><Ellipse.Fill><ImageBrush x:Name="FullPictureBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
     <Ellipse Stroke="{ThemeResource GoldGradientBrush}" StrokeThickness="2.5"/>
     <Border CornerRadius="11" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-10" Background="{ThemeResource GoldGradientBrush}">
      <TextBlock Text="{Binding Progress.Level}" FontWeight="Bold" FontSize="12" Foreground="#3A0F24"/>
     </Border>
    </Grid>
    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
     <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Border CornerRadius="10" Padding="10,3" Background="{ThemeResource AccentSoftBrush}"><TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"><Run Text="{Binding LevelText}"/><Run Text=" · "/><Run Text="{Binding TitleText}"/></TextBlock></Border>
      <Border CornerRadius="10" Padding="10,3" Background="{ThemeResource SubtleBrush}"><TextBlock Text="{Binding Achievements.SummaryText}" FontSize="12.5"/></Border>
     </StackPanel>
     <TextBox x:Name="FullBioBox" Text="{Binding Bio, Mode=TwoWay}" PlaceholderText="{Binding Text[DyBioPlaceholder]}" MaxLength="160" Background="Transparent" BorderThickness="0,0,0,1" Padding="0,4" MinWidth="320" HorizontalAlignment="Left"
              AutomationProperties.Name="{Binding Text[DyBio]}" AutomationProperties.AutomationId="diary-bio-full"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Width="230" Spacing="6" VerticalAlignment="Center">
     <Grid><TextBlock Text="{Binding TitleText}" FontWeight="SemiBold"/><TextBlock Text="{Binding XpText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/></Grid>
     <ProgressBar x:Name="FullXpBar" Maximum="100" MinHeight="8" CornerRadius="4"/>
    </StackPanel>
    <!-- Stats -->
    <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CompactCardStyle}" Padding="14,10"><StackPanel><TextBlock Text="{Binding StatCompleted}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[DyStatCompleted]}" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource CompactCardStyle}" Padding="14,10"><StackPanel><TextBlock Text="{Binding StatHours}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[DyStatHours]}" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}" Padding="14,10"><StackPanel><TextBlock Text="{Binding StatAverage}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[DyStatAverage]}" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
     <Border Grid.Column="3" Style="{StaticResource CompactCardStyle}" Padding="14,10"><StackPanel><TextBlock Text="{Binding StatYear}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[DyStatYear]}" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
    </Grid>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <!-- Medals (guide 13): collapsed by default; locked ones keep their name and criterion visible -->
    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="0" Padding="12,8" AutomationProperties.AutomationId="diary-medals">
     <Expander.Header><StackPanel Orientation="Horizontal" Spacing="10" Padding="0,0"><FontIcon Glyph="&#xE734;" FontSize="13" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding BadgesText}" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/></StackPanel></Expander.Header>
     <ItemsRepeater ItemsSource="{Binding Badges}">
      <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="250" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill"/></ItemsRepeater.Layout>
      <ItemsRepeater.ItemTemplate><DataTemplate>
       <Border Padding="12,10" MinHeight="96" CornerRadius="12" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource SubtleBrush}" VerticalAlignment="Top"><FontIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="{ThemeResource GoldBrush}"/></Border>
         <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <ProgressBar Value="{Binding Fraction}" Maximum="1" MinHeight="4" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11.5" Foreground="{ThemeResource MutedBrush}"/>
          </Grid>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ItemsRepeater.ItemTemplate>
     </ItemsRepeater>
    </Expander>
     <Button x:Name="HeaderToggle" Grid.Column="1" Click="OnHeaderToggle" Padding="10,8" CornerRadius="10" VerticalAlignment="Top" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" AutomationProperties.AutomationId="diary-header-toggle"><FontIcon x:Name="HeaderToggleIcon" Glyph="&#xE740;" FontSize="13"/></Button>
    </Grid>
   </Grid>
  </Border>
  <!-- Sections: games, Lotus achievements (the diary medals live there too), Steam -->
  <SelectorBar x:Name="SectionBar" SelectionChanged="OnSection" AutomationProperties.AutomationId="diary-sections">
   <SelectorBarItem x:Name="SectionGames" Tag="games" Text="{Binding Text[DySectionGames]}" Icon="Library"/>
   <SelectorBarItem x:Name="SectionStats" Tag="stats" Text="{Binding Text[DySectionStats]}"><SelectorBarItem.Icon><FontIcon Glyph="&#xE9D2;"/></SelectorBarItem.Icon></SelectorBarItem>
   <SelectorBarItem x:Name="SectionTrophies" Tag="trophies" Text="{Binding Text[DySectionTrophies]}"><SelectorBarItem.Icon><FontIcon Glyph="&#xE735;"/></SelectorBarItem.Icon></SelectorBarItem>
   <SelectorBarItem x:Name="SectionSteam" Tag="steam" Text="{Binding Text[DySectionSteam]}"><SelectorBarItem.Icon><FontIcon Glyph="&#xE7FC;"/></SelectorBarItem.Icon></SelectorBarItem>
  </SelectorBar>
  <local:DiaryStatsView x:Name="StatsArea" DataContext="{Binding Stats}" Visibility="Collapsed" RecapRequested="OnRecap"/>
  <local:TrophiesView x:Name="TrophiesArea" DataContext="{Binding Achievements}" Visibility="Collapsed"/>
  <local:SteamTrophiesView x:Name="SteamArea" DataContext="{Binding Achievements}" Visibility="Collapsed"/>

  <StackPanel x:Name="GamesArea" Spacing="18">
  <local:PlayNextView DataContext="{Binding PlayNext}"/>
  <!-- "Quero jogar" games on sale on Steam (only when there is one) -->
  <Border Style="{StaticResource CardStyle}" Padding="20,16" DataContext="{Binding Deals}" Visibility="{Binding HasDeals, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-deals">
   <StackPanel Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
     <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{ThemeResource GoldBrush}"/>
     <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Text[DlHint]}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
     <ItemsControl ItemsSource="{Binding Deals}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Click="OnDeal" Padding="0" CornerRadius="12" Background="Transparent" BorderThickness="0" app:Motion.Hover="1.03" AutomationProperties.Name="{Binding Name}" ToolTipService.ToolTip="{Binding StoreUrl}">
        <Grid Width="232" ColumnSpacing="12" Padding="8" CornerRadius="12" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Grid Width="62" Height="88" CornerRadius="8" Background="{ThemeResource HeroBrush}"><Image Source="{Binding Cover, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/></Grid>
         <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
          <Border HorizontalAlignment="Left" CornerRadius="6" Padding="6,1" Background="{ThemeResource SuccessBrush}"><TextBlock Text="{Binding DiscountText}" FontSize="12" FontWeight="Bold" Foreground="#12090F"/></Border>
          <StackPanel Orientation="Horizontal" Spacing="6">
           <TextBlock Text="{Binding Final}" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/>
           <TextBlock Text="{Binding Initial}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextDecorations="Strikethrough" VerticalAlignment="Center"/>
          </StackPanel>
         </StackPanel>
        </Grid>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </StackPanel>
  </Border>
  <!-- "Top 4" showcase: the player's favorite games, chosen by them (compact, the list stays the main content) -->
  <Grid ColumnSpacing="18" AutomationProperties.AutomationId="diary-showcase">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Spacing="4" MaxWidth="170">
    <TextBlock Text="{Binding Text[DyShowcaseTitle]}" FontFamily="Georgia" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/>
    <TextBlock Text="{Binding Text[DyShowcaseHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   </StackPanel>
   <ItemsControl Grid.Column="1" ItemsSource="{Binding Showcase}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Click="OnShowcaseSlot" Padding="0" CornerRadius="12" BorderThickness="0" Background="Transparent" app:Motion.Hover="1.04" AutomationProperties.Name="{Binding Card.Name}">
      <Grid Width="104" Height="140" CornerRadius="12">
       <!-- Empty slot -->
       <Border CornerRadius="12" BorderThickness="1.5" BorderBrush="{ThemeResource CardBorderBrush}" Background="{ThemeResource CardBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}">
        <StackPanel VerticalAlignment="Center" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="18" Foreground="{ThemeResource RoseBrush}"/><TextBlock Text="{Binding Index}" Visibility="Collapsed"/></StackPanel>
       </Border>
       <!-- Chosen game: gold frame -->
       <Grid Visibility="{Binding HasCard, Converter={StaticResource BooleanVisibility}}" CornerRadius="12" Background="{ThemeResource HeroBrush}">
        <TextBlock Text="{Binding Card.Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource GoldBrush}"/>
        <Image Source="{Binding Card.Cover, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/>
        <Border CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource GoldGradientBrush}"/>
       </Grid>
      </Grid>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </Grid>

  <!-- Tabs with counts -->
  <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
   <ItemsControl x:Name="TabBar" ItemsSource="{Binding Tabs}" AutomationProperties.AutomationId="diary-tabs">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Click="OnTab" Tag="{Binding Id}" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="12,5" AutomationProperties.Name="{Binding Label}">
      <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/><TextBlock Text="{Binding Count}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.75"/></StackPanel>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <!-- Toolbar: search, sort and the layout switch (grid / list / table) -->
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <AutoSuggestBox PlaceholderText="{Binding Text[DySearch]}" QueryIcon="Find" TextChanged="OnSearch" VerticalAlignment="Center" AutomationProperties.AutomationId="diary-search"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Sort, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
   <Border Grid.Column="2" CornerRadius="12" Padding="3" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" AutomationProperties.AutomationId="diary-view">
    <StackPanel Orientation="Horizontal" Spacing="2">
     <Button x:Name="ViewGrid" Tag="grid" Click="OnView" Padding="12,6" CornerRadius="9" BorderThickness="0" ToolTipService.ToolTip="{Binding Text[DyViewGrid]}" AutomationProperties.Name="{Binding Text[DyViewGrid]}" AutomationProperties.AutomationId="diary-view-grid"><FontIcon Glyph="&#xF0E2;" FontSize="15"/></Button>
     <Button x:Name="ViewList" Tag="list" Click="OnView" Padding="12,6" CornerRadius="9" BorderThickness="0" ToolTipService.ToolTip="{Binding Text[DyViewList]}" AutomationProperties.Name="{Binding Text[DyViewList]}" AutomationProperties.AutomationId="diary-view-list"><FontIcon Glyph="&#xE8FD;" FontSize="15"/></Button>
     <Button x:Name="ViewTable" Tag="table" Click="OnView" Padding="12,6" CornerRadius="9" BorderThickness="0" ToolTipService.ToolTip="{Binding Text[DyViewTable]}" AutomationProperties.Name="{Binding Text[DyViewTable]}" AutomationProperties.AutomationId="diary-view-table"><FontIcon Glyph="&#xE80A;" FontSize="15"/></Button>
    </StackPanel>
   </Border>
  </Grid>
  <!-- Filter chips (built from the player's own games), saved filters, and the active filters as text -->
  <StackPanel Spacing="8">
   <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
    <StackPanel x:Name="FilterChips" Orientation="Horizontal" Spacing="8" AutomationProperties.AutomationId="diary-filters"/>
   </ScrollViewer>
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="4">
     <TextBlock Text="{Binding ActiveFilters}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center" Visibility="{Binding HasFilters, Converter={StaticResource BooleanVisibility}}"/>
     <HyperlinkButton Content="{Binding Text[DyFilterClear]}" Click="OnClearFilters" Padding="6,2" Visibility="{Binding HasFilters, Converter={StaticResource BooleanVisibility}}"/>
    </StackPanel>
    <TextBlock Grid.Column="1" Text="{Binding ResultCount}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
   </Grid>
  </StackPanel>

  <!-- Empty -->
  <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}">
   <StackPanel Spacing="10" HorizontalAlignment="Center" Padding="0,14">
    <FontIcon Glyph="&#xE8F1;" FontSize="34" Foreground="{ThemeResource RoseBrush}"/>
    <TextBlock Text="{Binding Text[DyEmptyTitle]}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding Text[DyEmptyBody]}" Style="{StaticResource CaptionStyle}" TextAlignment="Center" MaxWidth="520"/>
    <Button Content="{Binding Text[DyEmptyAction]}" Click="OnOpenGameList" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"/>
   </StackPanel>
  </Border>
  <TextBlock Text="{Binding Text[DyNoMatch]}" Style="{StaticResource CaptionStyle}" FontSize="14" Visibility="{Binding NoMatch, Converter={StaticResource BooleanVisibility}}"/>

  <!-- Grid: cover wall (status and rating over the cover; hover shows hours and platform) -->
  <GridView x:Name="DiaryGrid" ItemsSource="{Binding Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnGridItem" Padding="0"
            ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsGrid, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-grid">
   <GridView.ItemContainerTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18"/><RepositionThemeTransition/></TransitionCollection></GridView.ItemContainerTransitions>
   <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="Padding" Value="0"/></Style></GridView.ItemContainerStyle>
   <GridView.ItemTemplate><DataTemplate>
    <Grid Width="168" Height="252" CornerRadius="14" Background="{ThemeResource HeroBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" app:Motion.Hover="1.04" AutomationProperties.Name="{Binding Name}" RequestedTheme="Dark">
     <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource GoldBrush}"/>
     <Image Source="{Binding Cover, Converter={StaticResource CoverImage}}" Stretch="UniformToFill" Opacity="{Binding CoverOpacity}"/>
     <!-- Special covers: platinum shimmer + ribbon, a 10 gets a gold frame and seal -->
     <Border CornerRadius="13" app:Motion.Sheen="True" Visibility="{Binding IsPlatinum, Converter={StaticResource BooleanVisibility}}" BorderThickness="2"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFB8E3FF" Offset="0"/><GradientStop Color="#FFF3C6FF" Offset="0.35"/><GradientStop Color="#FFFFE6B0" Offset="0.7"/><GradientStop Color="#FFB8FFE0" Offset="1"/></LinearGradientBrush></Border.BorderBrush></Border>
     <Border CornerRadius="13" BorderThickness="2" BorderBrush="{StaticResource GoldGradientBrush}" Visibility="{Binding IsPerfect, Converter={StaticResource BooleanVisibility}}"/>
     <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00160C14" Offset="0.5"/><GradientStop Color="#F0160C14" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
     <Border CornerRadius="8" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding IsPlatinum, Converter={StaticResource BooleanVisibility}}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFB8E3FF" Offset="0"/><GradientStop Color="#FFF3C6FF" Offset="0.5"/><GradientStop Color="#FFFFE6B0" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="{Binding DataContext.Text[DyPlatinumRibbon], ElementName=DiaryGrid}" FontSize="10" FontWeight="Bold" CharacterSpacing="80" Foreground="#2A1430"/></Border>
     <!-- Rating, top right -->
     <!-- A 10 shows a gold seal instead of the plain badge -->
     <Border Width="40" Height="40" CornerRadius="20" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource GoldGradientBrush}" Visibility="{Binding IsPerfect, Converter={StaticResource BooleanVisibility}}"><TextBlock Text="10" FontWeight="Bold" FontSize="15" Foreground="#3A0F24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border CornerRadius="10" Padding="8,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D912090F" BorderThickness="1" BorderBrush="{Binding RatingKind, Converter={StaticResource DiaryBrush}}" Visibility="{Binding IsPerfect, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}">
      <TextBlock Text="{Binding Rating}" FontSize="15" FontWeight="Bold" Foreground="{Binding RatingKind, Converter={StaticResource DiaryBrush}}"/>
     </Border>
     <!-- Name, status and hours at the bottom -->
     <StackPanel VerticalAlignment="Bottom" Padding="12,0,12,12" Spacing="6">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Border CornerRadius="8" Padding="8,2" Background="{Binding StatusKey, Converter={StaticResource DiaryBrush}}"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#12090F"/></Border>
       <Border CornerRadius="8" Padding="7,2" Background="#8012090F" Visibility="{Binding HasHours, Converter={StaticResource BooleanVisibility}}"><TextBlock Text="{Binding Hours}" FontSize="11" Foreground="#E6D6DE"/></Border>
      </StackPanel>
     </StackPanel>
    </Grid>
   </DataTemplate></GridView.ItemTemplate>
  </GridView>

  <!-- Table: one row per game, columns sort with a click on the header -->
  <StackPanel x:Name="DiaryTable" Spacing="4" Visibility="{Binding IsTable, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-table">
   <Grid Padding="12,6" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
    <HyperlinkButton Grid.Column="1" Content="{Binding Text[DyColGame]}" Tag="name" Click="OnColumnSort" Padding="0" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" CharacterSpacing="40"/>
    <TextBlock Grid.Column="2" Text="{Binding Text[DyColStatus]}" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center"/>
    <HyperlinkButton Grid.Column="3" Content="{Binding Text[DyColRating]}" Tag="rating" Click="OnColumnSort" Padding="0" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" CharacterSpacing="40"/>
    <HyperlinkButton Grid.Column="4" Content="{Binding Text[DyColHours]}" Tag="hours" Click="OnColumnSort" Padding="0" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" CharacterSpacing="40"/>
    <TextBlock Grid.Column="5" Text="{Binding Text[DyColStarted]}" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center"/>
    <HyperlinkButton Grid.Column="6" Content="{Binding Text[DyColFinished]}" Tag="finished" Click="OnColumnSort" Padding="0" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" CharacterSpacing="40"/>
    <TextBlock Grid.Column="7" Text="{Binding Text[DyColPlatform]}" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center"/>
   </Grid>
   <ItemsControl ItemsSource="{Binding Items}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Click="OnEntry" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="{Binding Name}">
      <Grid Padding="12,6" ColumnSpacing="12" CornerRadius="10" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
       <Border Width="32" Height="44" CornerRadius="6" Background="{ThemeResource HeroBrush}"><Image Source="{Binding Cover, Converter={StaticResource CoverImage}}" Stretch="UniformToFill" Opacity="{Binding CoverOpacity}"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Genre}" FontSize="11.5" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
       <Border Grid.Column="2" CornerRadius="8" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding StatusKey, Converter={StaticResource DiaryBrush}}"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#12090F"/></Border>
       <TextBlock Grid.Column="3" Text="{Binding Rating}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{Binding RatingKind, Converter={StaticResource DiaryBrush}}"/>
       <TextBlock Grid.Column="4" Text="{Binding HoursOrDash}" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="5" Text="{Binding StartedText}" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}"/>
       <TextBlock Grid.Column="6" Text="{Binding FinishedText}" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}"/>
       <TextBlock Grid.Column="7" Text="{Binding Platform}" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
      </Grid>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>

  <!-- Entries -->
  <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsList, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="diary-list">
   <ItemsControl.ItemContainerTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18"/><RepositionThemeTransition/></TransitionCollection></ItemsControl.ItemContainerTransitions>
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Button Click="OnEntry" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="{Binding Name}">
     <Border Padding="16" CornerRadius="16" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" app:Motion.Hover="1.008">
      <Grid ColumnSpacing="16" RowSpacing="10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Width="84" Height="112" CornerRadius="10" Background="{ThemeResource HeroBrush}" VerticalAlignment="Top">
        <Image Source="{Binding Cover, Converter={StaticResource CoverImage}}" Stretch="UniformToFill" Opacity="{Binding CoverOpacity}"/>
       </Border>
       <StackPanel Grid.Column="1" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
         <Border CornerRadius="6" Padding="7,1" Background="{ThemeResource SubtleBrush}" VerticalAlignment="Center"><TextBlock Text="{Binding Rank}" FontSize="12" FontWeight="SemiBold"/></Border>
         <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionStyle}"/>
        <TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionStyle}" FontSize="11.5"/>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
         <Border CornerRadius="8" Padding="8,2" Background="{ThemeResource SubtleBrush}"><TextBlock Text="{Binding Platform}" FontSize="11.5"/></Border>
         <Border CornerRadius="8" Padding="8,2" Background="{ThemeResource SubtleBrush}" Visibility="{Binding HasHours, Converter={StaticResource BooleanVisibility}}">
          <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE916;" FontSize="10" Foreground="{ThemeResource SuccessBrush}"/><TextBlock Text="{Binding Hours}" FontSize="11.5" Foreground="{ThemeResource SuccessBrush}"/></StackPanel>
         </Border>
         <ItemsControl ItemsSource="{Binding Feats}" Visibility="{Binding HasFeats, Converter={StaticResource BooleanVisibility}}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border CornerRadius="8" Padding="7,2" Background="{ThemeResource AccentSoftBrush}" ToolTipService.ToolTip="{Binding Label}"><FontIcon Glyph="{Binding Glyph}" FontSize="11" Foreground="{ThemeResource GoldBrush}"/></Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </StackPanel>
       <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
        <TextBlock Text="{Binding Rating}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{Binding RatingKind, Converter={StaticResource DiaryBrush}}"/>
        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Right" Background="{Binding StatusKey, Converter={StaticResource DiaryBrush}}">
         <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="#12090F"/>
        </Border>
       </StackPanel>
       <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Review}" Style="{StaticResource BodyStyle}" FontSize="13.5" MaxLines="4" TextTrimming="WordEllipsis" Visibility="{Binding HasReview, Converter={StaticResource BooleanVisibility}}"/>
      </Grid>
     </Border>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  </StackPanel>
 </StackPanel>
</UserControl>
