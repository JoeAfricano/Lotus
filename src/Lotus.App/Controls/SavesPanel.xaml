<UserControl x:Class="Lotus.App.Controls.SavesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls" x:Name="Root" AutomationProperties.AutomationId="saves">
 <Grid>
  <!-- Library: hero with the totals, filters, game covers -->
  <StackPanel x:Name="ListArea" Spacing="18" app:Motion.Stagger="True">
   <Border CornerRadius="20" MinHeight="236" BorderThickness="1" BorderBrush="{ThemeResource CardBorderBrush}" Background="#160C14" RequestedTheme="Dark" AutomationProperties.AutomationId="saves-hero">
    <Grid>
     <!-- Fanned covers of protected games (filled in code) -->
     <Canvas x:Name="HeroCovers" HorizontalAlignment="Right" Width="380" Margin="0,0,24,0" IsHitTestVisible="False"/>
     <Border CornerRadius="20" IsHitTestVisible="False">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FA160C14" Offset="0.38"/><GradientStop Color="#B3160C14" Offset="0.66"/><GradientStop Color="#33160C14" Offset="1"/></LinearGradientBrush></Border.Background>
     </Border>
     <StackPanel Padding="32,28" Spacing="18" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
       <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xEA18;" FontSize="13" Foreground="#F07A9C"/>
        <TextBlock Text="{Binding Text[SlHeroEyebrow]}" FontSize="12" FontWeight="SemiBold" CharacterSpacing="120" Foreground="#F07A9C"/>
       </StackPanel>
       <TextBlock Text="{Binding Text[SlHeroTitle]}" FontSize="30" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Text[SlHeroBody]}" FontSize="14.5" Foreground="#E6D6DE" TextWrapping="Wrap"/>
      </StackPanel>
      <!-- Totals -->
      <StackPanel Orientation="Horizontal" Spacing="28">
       <StackPanel Spacing="0"><TextBlock x:Name="StatProtected" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource BrandGoldGradientBrush}" AutomationProperties.AutomationId="saves-stat-protected"/><TextBlock Text="{Binding Text[SlStatProtected]}" FontSize="12" Foreground="#C9B4C0"/></StackPanel>
       <Rectangle Width="1" Fill="#33FFFFFF" Margin="0,6"/>
       <StackPanel Spacing="0"><TextBlock x:Name="StatBackups" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource BrandGoldGradientBrush}"/><TextBlock Text="{Binding Text[SlStatBackups]}" FontSize="12" Foreground="#C9B4C0"/></StackPanel>
       <Rectangle Width="1" Fill="#33FFFFFF" Margin="0,6"/>
       <StackPanel Spacing="0"><TextBlock Text="{Binding SpaceUsed}" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource BrandGoldGradientBrush}"/><TextBlock Text="{Binding Text[SlStatSpace]}" FontSize="12" Foreground="#C9B4C0"/></StackPanel>
      </StackPanel>
     </StackPanel>
    </Grid>
   </Border>

   <!-- Filters and search in one row -->
   <Grid ColumnSpacing="14">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <SelectorBar x:Name="FilterBar" SelectionChanged="OnFilter" AutomationProperties.Name="{Binding Text[SlFilters]}" AutomationProperties.AutomationId="saves-filter"/>
    <TextBox Grid.Column="1" PlaceholderText="{Binding Text[SlSearch]}" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" VerticalContentAlignment="Center" VerticalAlignment="Center"
             AutomationProperties.Name="{Binding Text[SlSearch]}" AutomationProperties.AutomationId="saves-search"/>
   </Grid>

   <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding Loading, Converter={StaticResource BooleanVisibility}}">
    <ProgressRing Width="20" Height="20" IsActive="{Binding Loading}"/><TextBlock Text="{Binding Text[SlLoading]}" VerticalAlignment="Center"/>
   </StackPanel>
   <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}">
    <StackPanel Orientation="Horizontal" Spacing="14"><Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE721;" Style="{StaticResource BadgeIconStyle}"/></Border><TextBlock Text="{Binding Text[SlEmpty]}" VerticalAlignment="Center" Style="{StaticResource BodyStyle}"/></StackPanel>
   </Border>

   <GridView ItemsSource="{Binding Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTileClick" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="0" AutomationProperties.AutomationId="saves-grid">
    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="Padding" Value="0"/></Style></GridView.ItemContainerStyle>
    <GridView.ItemTemplate><DataTemplate>
     <Border Width="172" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" app:Motion.Hover="1.035" Opacity="{Binding IsDim, Converter={StaticResource DimWhenTrue}}"
             AutomationProperties.Name="{Binding Name}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="228"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border CornerRadius="15,15,0,0" Background="{ThemeResource HeroBrush}">
        <Grid>
         <Image Source="{Binding Name, Converter={StaticResource FallbackCover}}" Stretch="UniformToFill" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}, ConverterParameter=Invert}" AutomationProperties.AccessibilityView="Raw"/>
         <TextBlock Text="{Binding Initials}" FontFamily="Georgia" FontSize="42" FontWeight="SemiBold" Foreground="#FFF6F9" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}, ConverterParameter=Invert}"/>
         <Border CornerRadius="15,15,0,0" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}}">
          <Border.Background><ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/></Border.Background>
         </Border>
         <!-- Bottom fade so the badge reads on any cover -->
         <Border CornerRadius="15,15,0,0" IsHitTestVisible="False">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.55"/><GradientStop Color="#CC12090F" Offset="1"/></LinearGradientBrush></Border.Background>
         </Border>
         <!-- Status badge -->
         <Border CornerRadius="10" Padding="8,4" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{ThemeResource AccentGradientBrush}" BorderBrush="#55FFFFFF" BorderThickness="1"
                 Visibility="{Binding IsProtected, Converter={StaticResource BooleanVisibility}}">
          <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{Binding BadgeGlyph}" FontSize="11" Foreground="White"/><TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="White"/></StackPanel>
         </Border>
         <Border CornerRadius="10" Padding="8,4" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#D912090F" BorderBrush="#33FFFFFF" BorderThickness="1"
                 Visibility="{Binding IsProtected, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}">
          <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{Binding BadgeGlyph}" FontSize="11" Foreground="{Binding NeedsAttention, Converter={StaticResource AttentionBrush}}"/><TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="#F8F0F3"/></StackPanel>
         </Border>
         <Border Background="#B312090F" CornerRadius="6" Padding="7,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding Store}" FontSize="11" FontWeight="SemiBold" Foreground="#F8F0F3"/></Border>
        </Grid>
       </Border>
       <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="3">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" MinHeight="16"/>
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate></GridView.ItemTemplate>
   </GridView>
  </StackPanel>

  <!-- One game: banner with its art, then its saves -->
  <StackPanel x:Name="DetailArea" Spacing="18" Visibility="Collapsed">
   <Border CornerRadius="20" Height="200" BorderThickness="1" BorderBrush="{ThemeResource CardBorderBrush}" Background="#160C14" RequestedTheme="Dark" AutomationProperties.AutomationId="saves-detail-hero">
    <Grid>
     <Border x:Name="DetailArt" CornerRadius="20" Opacity="0.55"/>
     <Border CornerRadius="20" IsHitTestVisible="False">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F5160C14" Offset="0.2"/><GradientStop Color="#80160C14" Offset="0.7"/><GradientStop Color="#33160C14" Offset="1"/></LinearGradientBrush></Border.Background>
     </Border>
     <Grid Padding="28,22" ColumnSpacing="22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="DetailCover" Width="112" Height="150" CornerRadius="12" BorderBrush="#40EEC1A8" BorderThickness="1" Background="{ThemeResource HeroBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
       <Button Click="OnBack" Background="#33FFFFFF" BorderBrush="#33FFFFFF" CornerRadius="10" Padding="12,6" app:Motion.Press="True" AutomationProperties.AutomationId="saves-back">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="White"/><TextBlock Text="{Binding Text[SlBack]}" Foreground="White"/></StackPanel>
       </Button>
       <TextBlock x:Name="DetailName" FontSize="28" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="DetailLine" FontSize="13.5" Foreground="#E6D6DE" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
   <controls:SaveManagerView x:Name="Manager"/>
  </StackPanel>
 </Grid>
</UserControl>
