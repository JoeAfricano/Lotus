<UserControl x:Class="Lotus.App.Controls.MonitoringPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Lotus.App.Controls">
 <StackPanel Spacing="14">
  <TextBlock Text="{Binding Text[MonitoringFocus]}" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
  <TextBlock Text="{Binding LastUpdate}" AutomationProperties.AutomationId="monitor-updated" FontSize="12" Foreground="{ThemeResource RoseBrush}"/>
  <Grid x:Name="Cards" ColumnSpacing="16" RowSpacing="16" SizeChanged="OnCardsSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ContentControl x:Name="CpuCard" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="8">
    <TextBlock Text="CPU" Style="{StaticResource EyebrowStyle}"/>
    <TextBlock Text="{Binding CpuName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="monitor-cpu-name"/>
    <TextBlock Text="{Binding CpuPercent}" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" AutomationProperties.AutomationId="monitor-cpu-percent"/>
    <TextBlock Text="{Binding CpuStatus}" FontSize="11" Foreground="{ThemeResource MutedBrush}" AutomationProperties.AutomationId="monitor-cpu-status"/>
    <local:TelemetryChart x:Name="CpuChart" Height="90" AutomationProperties.Name="{Binding Text[CpuChart]}"/>
   </StackPanel></ContentControl>
   <ContentControl x:Name="MemoryCard" Grid.Column="1" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="8">
    <TextBlock Text="{Binding Text[Memory]}" Style="{StaticResource EyebrowStyle}"/>
    <TextBlock Text="{Binding Text[PhysicalMemory]}" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding MemoryPercent}" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" AutomationProperties.AutomationId="monitor-memory-percent"/>
    <TextBlock Text="{Binding MemorySummary}" FontSize="13" AutomationProperties.AutomationId="monitor-memory-summary"/>
    <local:TelemetryChart x:Name="MemoryChart" Height="90" AutomationProperties.Name="{Binding Text[MemoryChart]}"/>
   </StackPanel></ContentControl>
  </Grid>
  <TextBlock Text="{Binding GpuStatus}" Foreground="{ThemeResource MutedBrush}" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="monitor-gpu-status"/>
  <ItemsControl ItemsSource="{Binding Gpus}"><ItemsControl.ItemTemplate><DataTemplate><local:GpuPanel Margin="0,0,0,14"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Expander Header="{Binding Text[CollectorDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
   <StackPanel Spacing="10">
    <TextBlock Text="{Binding CoreCounts}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Text[LotusCpu]}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProcessCpu}" AutomationProperties.AutomationId="monitor-process-cpu"/>
    <TextBlock Text="{Binding Text[WorkingSet]}"/><TextBlock Text="{Binding WorkingSet}" AutomationProperties.AutomationId="monitor-working-set"/>
    <TextBlock Text="{Binding Text[PrivateCommit]}"/><TextBlock Text="{Binding PrivateCommit}" AutomationProperties.AutomationId="monitor-private-commit"/>
    <TextBlock Text="{Binding Text[PhysicalAvailable]}"/><TextBlock Text="{Binding AvailableMemory}" AutomationProperties.AutomationId="monitor-memory-available"/>
    <TextBlock Text="{Binding MemoryStatus}" AutomationProperties.AutomationId="monitor-memory-status"/>
    <TextBlock Text="{Binding CpuSource}" TextWrapping="Wrap"/><TextBlock Text="{Binding MemorySource}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Text[FrequencyUnavailable]}" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
    <TextBlock Text="{Binding Text[CpuTemperatureUnavailable]}" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
    <TextBlock Text="{Binding Text[PhysicalDefinition]}" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
    <TextBlock Text="{Binding Text[ProcessMemoryDefinition]}" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
    <TextBlock Text="{Binding Text[MonitoringLimitations]}" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
   </StackPanel>
  </Expander>
 </StackPanel>
</UserControl>
