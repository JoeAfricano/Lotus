<UserControl x:Class="Lotus.App.Controls.TaskProgressView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <!-- Running: bar + percentage -->
  <Grid x:Name="RunningPart" ColumnSpacing="12" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
   <ProgressBar x:Name="Bar" Maximum="100" MinHeight="6" VerticalAlignment="Center"/>
   <TextBlock x:Name="PercentLabel" Grid.Column="1" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
  <!-- Done: check mark that pops in, then the result -->
  <StackPanel x:Name="DonePart" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
   <Grid x:Name="Check" Width="26" Height="26" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><ScaleTransform x:Name="CheckScale"/></Grid.RenderTransform>
    <Ellipse Fill="{ThemeResource SuccessBrush}"/>
    <FontIcon Glyph="&#xE73E;" FontSize="13" FontWeight="Bold" Foreground="#FF10251B"/>
   </Grid>
   <TextBlock x:Name="DoneLabel" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Grid>
</UserControl>
