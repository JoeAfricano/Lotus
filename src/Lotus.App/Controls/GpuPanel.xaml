<UserControl x:Class="Lotus.App.Controls.GpuPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Lotus.App.Controls">
 <StackPanel Spacing="12">
  <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="monitor-gpu-name"/>
  <Grid x:Name="Cards" ColumnSpacing="16" RowSpacing="16" SizeChanged="OnSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ContentControl x:Name="GpuCard" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="8">
    <TextBlock Text="GPU" Style="{StaticResource EyebrowStyle}"/>
    <TextBlock Text="{Binding Utilization}" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" AutomationProperties.AutomationId="monitor-gpu-utilization"/>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding Text[TemperatureShort]}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="{Binding Temperature}" FontSize="16" AutomationProperties.AutomationId="monitor-gpu-temperature"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="{Binding Text[PowerShort]}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="{Binding Power}" FontSize="16" AutomationProperties.AutomationId="monitor-gpu-power"/></StackPanel>
    </Grid>
    <local:TelemetryChart x:Name="GpuChart" Height="90" AutomationProperties.Name="{Binding Text[GpuHistory]}"/>
   </StackPanel></ContentControl>
   <ContentControl x:Name="VramCard" Grid.Column="1" Style="{StaticResource CardControlStyle}"><StackPanel Spacing="8">
    <TextBlock Text="VRAM" Style="{StaticResource EyebrowStyle}"/>
    <TextBlock Text="{Binding MemoryPercent}" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" AutomationProperties.AutomationId="monitor-vram-percent"/>
    <TextBlock Text="{Binding MemorySummary}" FontSize="16" AutomationProperties.AutomationId="monitor-vram-summary"/>
    <TextBlock Text="{Binding Text[VramAllocatedShort]}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
    <local:TelemetryChart x:Name="VramChart" Height="90" AutomationProperties.Name="{Binding Text[VramHistory]}"/>
   </StackPanel></ContentControl>
  </Grid>
  <Expander Header="{Binding Text[SensorDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
   <StackPanel Spacing="12">
    <TextBlock Text="{Binding Identity}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    <TextBlock Text="{Binding UtilizationDetail}" FontSize="11" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding MemoryDetail}" FontSize="11" TextWrapping="Wrap"/>
    <Grid ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding Text[VramTotal]}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding MemoryTotal}"/>
     <TextBlock Grid.Row="1" Text="{Binding Text[VramUsed]}" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MemoryUsed}"/>
     <TextBlock Grid.Row="2" Text="{Binding Text[VramFree]}" TextWrapping="Wrap"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MemoryFree}"/>
     <TextBlock Grid.Row="3" Text="{Binding Text[VramReserved]}" TextWrapping="Wrap"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MemoryReserved}"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding Sensors}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="4" Margin="0,0,0,14">
     <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" FontSize="17" Foreground="{ThemeResource RoseBrush}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{Binding Text[GpuDefinitions]}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
   </StackPanel>
  </Expander>
 </StackPanel>
</UserControl>
