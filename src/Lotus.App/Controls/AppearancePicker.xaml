<UserControl x:Class="Lotus.App.Controls.AppearancePicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="settings-appearance">
 <StackPanel Spacing="16">
  <TextBlock x:Name="Title" Style="{StaticResource SectionTitleStyle}"/>
  <Grid ColumnSpacing="24" RowSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <!-- Theme cards: a small preview of each mode -->
   <ItemsControl x:Name="ThemeCards" AutomationProperties.AutomationId="settings-theme-cards">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="196" ItemHeight="128"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   </ItemsControl>
   <StackPanel x:Name="AccentArea" Grid.Column="1" Spacing="12" MinWidth="220">
    <TextBlock x:Name="AccentTitle" FontSize="16" FontWeight="SemiBold"/>
    <VariableSizedWrapGrid x:Name="AccentDots" Orientation="Horizontal" ItemWidth="56" ItemHeight="56" MaximumRowsOrColumns="4" AutomationProperties.AutomationId="settings-accents"/>
    <TextBlock x:Name="AccentName" Style="{StaticResource CaptionStyle}"/>
   </StackPanel>
  </Grid>
  <!-- Theme gallery: complete themes (colors + animated background), the player's own themes and shared codes -->
  <StackPanel Spacing="12" Margin="0,10,0,0" AutomationProperties.AutomationId="settings-theme-gallery">
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="GalleryTitle" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="GalleryHint" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
    <Button x:Name="PasteButton" Grid.Column="1" Click="OnPaste" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="theme-paste">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE77F;" FontSize="13"/><TextBlock x:Name="PasteLabel"/></StackPanel>
    </Button>
    <Button x:Name="CreateButton" Grid.Column="2" Click="OnCreate" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="theme-create">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE790;" FontSize="13"/><TextBlock x:Name="CreateLabel"/></StackPanel>
    </Button>
   </Grid>
   <TextBlock x:Name="GalleryMessage" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
   <VariableSizedWrapGrid x:Name="GalleryCards" Orientation="Horizontal" ItemWidth="214" ItemHeight="158" AutomationProperties.AutomationId="theme-gallery-cards"/>
   <TextBlock x:Name="MineTitle" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
   <TextBlock x:Name="MineEmpty" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   <VariableSizedWrapGrid x:Name="MineCards" Orientation="Horizontal" ItemWidth="214" ItemHeight="158" AutomationProperties.AutomationId="theme-mine-cards"/>
  </StackPanel>
 </StackPanel>
</UserControl>
