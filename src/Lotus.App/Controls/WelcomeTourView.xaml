<UserControl x:Class="Lotus.App.Controls.WelcomeTourView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" KeyboardAcceleratorPlacementMode="Hidden" AutomationProperties.AutomationId="welcome-tour">
 <!-- "Conheça o Lotus": rail with one entry per feature (left), animated scene + plain text + "try it" (right).
      Same overlay pattern as the first-run profile welcome; Esc closes. -->
 <Grid>
  <Border x:Name="Backdrop" Background="#D90C060A" Opacity="0" Tapped="OnBackdropTapped"/>
  <Grid x:Name="Card" Width="1040" MaxWidth="1100" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Opacity="0"
        Background="{ThemeResource WindowBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="16">
   <Grid.RenderTransform><CompositeTransform x:Name="CardTransform" ScaleX="0.96" ScaleY="0.96" TranslateY="16"/></Grid.RenderTransform>
   <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition/></Grid.ColumnDefinitions>

   <!-- Rail -->
   <Grid Background="{ThemeResource PaneBrush}" CornerRadius="16,0,0,16" Padding="14,24,14,18" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,1,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="10,0,0,18">
     <TextBlock Text="Lotus" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrandGoldGradientBrush}"/>
     <TextBlock x:Name="RailKicker" Style="{StaticResource EyebrowStyle}" Margin="0,2,0,0"/>
    </StackPanel>
    <StackPanel x:Name="Rail" Grid.Row="1" Spacing="2" AutomationProperties.AutomationId="wt-rail"/>
    <TextBlock x:Name="StepLabel" Grid.Row="2" Margin="10,0,0,0" Style="{StaticResource CaptionStyle}"/>
   </Grid>

   <!-- Page -->
   <Grid Grid.Column="1" Padding="28,24,28,22" RowSpacing="18">
    <Grid.RowDefinitions><RowDefinition Height="236"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- Scene: always on the dark plum stage so it looks the same in every theme -->
    <Grid x:Name="Stage" CornerRadius="14" RequestedTheme="Dark" AutomationProperties.AutomationId="wt-scene">
     <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A1424" Offset="0"/><GradientStop Color="#160C14" Offset="0.6"/><GradientStop Color="#1E1020" Offset="1"/></LinearGradientBrush></Grid.Background>
     <Image x:Name="StageArt" Stretch="UniformToFill" Opacity="0" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><CompositeTransform x:Name="ArtTransform"/></Image.RenderTransform></Image>
     <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-140,0" Opacity="0.35" IsHitTestVisible="False">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#66F07A9C" Offset="0"/><GradientStop Color="#00F07A9C" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
     </Ellipse>
     <Grid x:Name="Scene" Margin="28,22"/>
     <TextBlock x:Name="SceneTag" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10" FontSize="10.5" Foreground="#99F4C9D6" CharacterSpacing="40"/>
    </Grid>

    <!-- Text -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Padding="0,0,22,0">
     <StackPanel x:Name="Body" Spacing="10">
      <StackPanel.RenderTransform><TranslateTransform x:Name="BodyShift"/></StackPanel.RenderTransform>
      <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
      <TextBlock x:Name="PageLead" Style="{StaticResource BodyLargeStyle}" TextWrapping="Wrap" Opacity="0.85"/>
      <StackPanel x:Name="Details" Spacing="8" Margin="0,6,0,0"/>
     </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Grid Grid.Row="2" ColumnSpacing="10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="CloseButton" Click="OnClose" Style="{StaticResource SoftButtonStyle}" MinHeight="42" MinWidth="100" AutomationProperties.AutomationId="wt-close"/>
     <Button x:Name="BackButton" Grid.Column="2" Click="OnBack" Style="{StaticResource SoftButtonStyle}" MinHeight="42" MinWidth="100" AutomationProperties.AutomationId="wt-back"/>
     <Button x:Name="TryButton" Grid.Column="3" Click="OnTry" Style="{StaticResource SoftButtonStyle}" MinHeight="42" AutomationProperties.AutomationId="wt-try">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="TryIcon" Glyph="&#xE8A7;" FontSize="14" Foreground="{ThemeResource RoseBrush}"/><TextBlock x:Name="TryText"/></StackPanel>
     </Button>
     <Button x:Name="NextButton" Grid.Column="4" Click="OnNext" Style="{StaticResource PrimaryButtonStyle}" MinHeight="42" MinWidth="150" AutomationProperties.AutomationId="wt-next"/>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
