<UserControl x:Class="Lotus.App.Controls.TrophiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" AutomationProperties.AutomationId="trophies">
 <UserControl.Resources>
  <!-- One Lotus achievement: tier medal, name, how to get it, progress and XP -->
  <DataTemplate x:Key="TrophyTemplate">
   <Border Height="150" Padding="16,14" CornerRadius="16" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
           ToolTipService.ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Name}" app:Motion.Hover="1.02">
    <Grid ColumnSpacing="14" RowSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Width="56" Height="56" VerticalAlignment="Top" Opacity="{Binding Unlocked, Converter={StaticResource UnlockedOpacity}}">
      <Ellipse Fill="{Binding Tier, Converter={StaticResource TierFill}}"/>
      <Ellipse Stroke="#59FFFFFF" StrokeThickness="1.2" Margin="5"/>
      <FontIcon Glyph="{Binding Glyph}" FontSize="21" Foreground="#2A0F1E"/>
     </Grid>
     <StackPanel Grid.Column="1" Spacing="3">
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
       <Border Grid.Column="1" CornerRadius="8" Padding="7,1" Background="#14FFFFFF" VerticalAlignment="Top">
        <TextBlock Text="{Binding TierLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Tier, Converter={StaticResource DiaryBrush}}"/>
       </Border>
      </Grid>
      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ProgressBar Value="{Binding Percent}" Maximum="100" MinHeight="5" CornerRadius="3" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11.5" Foreground="{ThemeResource MutedBrush}"/>
      <TextBlock Grid.Column="2" Text="{Binding XpText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/>
     </Grid>
    </Grid>
   </Border>
  </DataTemplate>
  <!-- One of the rarest Steam unlocks -->
  <DataTemplate x:Key="ShowcaseTemplate">
   <Border Height="96" Padding="14" CornerRadius="16" Background="{ThemeResource CardBrush}" BorderThickness="1.5" BorderBrush="{Binding RarityKind, Converter={StaticResource DiaryBrush}}"
           ToolTipService.ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Name}" app:Motion.Hover="1.03">
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Width="64" Height="64" CornerRadius="10" Background="{ThemeResource HeroBrush}"><Image Source="{Binding Icon, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/></Border>
     <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Game}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding RarityText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding RarityKind, Converter={StaticResource DiaryBrush}}"/>
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
 </UserControl.Resources>

 <StackPanel Spacing="20">
  <!-- Summary -->
  <Border Style="{StaticResource CardStyle}" Padding="22,18">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid Width="72" Height="72">
     <Ellipse Fill="{ThemeResource GoldGradientBrush}"/>
     <Ellipse Stroke="#66FFFFFF" StrokeThickness="1.5" Margin="6"/>
     <FontIcon x:Name="SummaryIcon" Glyph="&#xE735;" FontSize="28" Foreground="#3A0F24"/>
    </Grid>
    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding SummaryText}" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="trophies-summary"/>
      <TextBlock Grid.Column="1" Text="{Binding XpText}" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}" VerticalAlignment="Center"/>
     </Grid>
     <ProgressBar Value="{Binding SummaryPercent}" Maximum="100" MinHeight="8" CornerRadius="4"/>
     <TextBlock Text="{Binding Text[TrXpRule]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Almost there -->
  <StackPanel Spacing="10" Visibility="{Binding HasNextUp, Converter={StaticResource BooleanVisibility}}">
   <StackPanel Spacing="2"><TextBlock Text="{Binding Text[TrNextUp]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[TrNextUpHint]}" Style="{StaticResource CaptionStyle}"/></StackPanel>
   <ItemsRepeater ItemsSource="{Binding NextUp}" ItemTemplate="{StaticResource TrophyTemplate}" AutomationProperties.AutomationId="trophies-next">
    <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="280" MinItemHeight="150" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" MaximumRowsOrColumns="3"/></ItemsRepeater.Layout>
   </ItemsRepeater>
  </StackPanel>

  <!-- Showcase: rarest Steam unlocks -->
  <StackPanel Spacing="10" Visibility="{Binding HasShowcase, Converter={StaticResource BooleanVisibility}}">
   <StackPanel Spacing="2"><TextBlock Text="{Binding Text[TrShowcase]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[TrShowcaseHint]}" Style="{StaticResource CaptionStyle}"/></StackPanel>
   <ItemsRepeater ItemsSource="{Binding Showcase}" ItemTemplate="{StaticResource ShowcaseTemplate}" AutomationProperties.AutomationId="trophies-showcase">
    <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="280" MinItemHeight="96" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" MaximumRowsOrColumns="3"/></ItemsRepeater.Layout>
   </ItemsRepeater>
  </StackPanel>

  <!-- Every achievement, by category -->
  <SelectorBar x:Name="CategoryBar" SelectionChanged="OnCategory" AutomationProperties.AutomationId="trophies-categories"/>
  <ItemsRepeater ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource TrophyTemplate}" AutomationProperties.AutomationId="trophies-list">
   <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="280" MinItemHeight="150" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill"/></ItemsRepeater.Layout>
  </ItemsRepeater>
 </StackPanel>
</UserControl>
