<UserControl x:Class="Lotus.App.Controls.BenchmarkPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Lotus.App.Controls">
 <StackPanel Spacing="16">
  <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE9D2;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Text[BenchTitle]}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Text[BenchIntro]}" Style="{StaticResource CaptionStyle}"/></StackPanel>
   </Grid>
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox Header="{Binding Text[BenchProcess]}" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}"/>
    <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding Text[BenchRefresh]}" AutomationProperties.Name="{Binding Text[BenchRefresh]}"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
   </Grid>
   <NumberBox Header="{Binding Text[BenchDuration]}" Value="{Binding Seconds, Mode=TwoWay}" Minimum="10" Maximum="120" SmallChange="10" SpinButtonPlacementMode="Inline" IsEnabled="{Binding CanEdit}" MaxWidth="240" HorizontalAlignment="Left"/>
   <TextBox Header="{Binding Text[BenchConditions]}" Text="{Binding Conditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72" IsEnabled="{Binding CanEdit}"/>
   <CheckBox Content="{Binding Text[BenchElevate]}" IsChecked="{Binding Elevated, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
   <TextBlock Text="{Binding Text[BenchElevationNote]}" Style="{StaticResource CaptionStyle}"/>
   <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="{Binding Text[BenchStart]}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="{Binding Text[BenchStop]}" Command="{Binding StopCommand}" Style="{StaticResource SoftButtonStyle}"/></StackPanel>
   <ProgressBar IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}"/>
   <TextBlock Text="{Binding Status}" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource RoseBrush}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></Border>
  <ComboBox Header="{Binding Text[BenchSession]}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
  <Border Style="{StaticResource CardStyle}" Visibility="{Binding HasResult, Converter={StaticResource BooleanVisibility}}"><StackPanel Spacing="16">
   <TextBlock Text="{Binding Text[BenchResult]}" Style="{StaticResource SectionTitleStyle}"/>
   <TextBlock Text="{Binding Text[BenchLossUnknown]}" Style="{StaticResource CaptionStyle}"/>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource CompactCardStyle}" Background="{ThemeResource AccentSoftBrush}" BorderThickness="0"><StackPanel Spacing="4"><TextBlock Text="{Binding Text[BenchAverage]}" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="{Binding Average}" Style="{StaticResource MetricValueStyle}" FontSize="26" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="4"><TextBlock Text="1% LOW" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="{Binding Low1}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="4"><TextBlock Text="P99 · FRAMETIME" Style="{StaticResource EyebrowStyle}"/><TextBlock Text="{Binding P99}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
   </Grid>
   <TextBlock Text="{Binding Text[BenchChart]}" Style="{StaticResource EyebrowStyle}"/>
   <local:FrametimeChart x:Name="Chart" Height="160"/>
   <ComboBox Header="{Binding Text[BenchBaseline]}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding Baseline, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
   <TextBlock Text="{Binding Comparison}" Style="{StaticResource BodyStyle}"/>
   <TextBlock Text="{Binding Text[BenchComparisonCaution]}" Style="{StaticResource CaptionStyle}"/>
   <Expander Header="{Binding Text[UxTechnicalDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12"><TextBlock Text="{Binding Text[BenchMethod]}" Style="{StaticResource BodyStyle}"/><TextBlock Text="{Binding Details}" Style="{StaticResource CaptionStyle}" IsTextSelectionEnabled="True"/></StackPanel></Expander>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
