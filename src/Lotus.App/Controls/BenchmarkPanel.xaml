<UserControl x:Class="Lotus.App.Controls.BenchmarkPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Lotus.App.Controls">
 <StackPanel Spacing="16">
  <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
   <TextBlock Text="{Binding Text[BenchTitle]}" Style="{StaticResource SectionTitleStyle}"/>
   <TextBlock Text="{Binding Text[BenchIntro]}" TextWrapping="Wrap"/>
   <ComboBox Header="{Binding Text[BenchProcess]}" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}"/>
   <Button Content="{Binding Text[BenchRefresh]}" Command="{Binding RefreshCommand}"/>
   <NumberBox Header="{Binding Text[BenchDuration]}" Value="{Binding Seconds, Mode=TwoWay}" Minimum="10" Maximum="120" SmallChange="10" SpinButtonPlacementMode="Inline" IsEnabled="{Binding CanEdit}"/>
   <TextBox Header="{Binding Text[BenchConditions]}" Text="{Binding Conditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" IsEnabled="{Binding CanEdit}"/>
   <CheckBox Content="{Binding Text[BenchElevate]}" IsChecked="{Binding Elevated, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
   <TextBlock Text="{Binding Text[BenchElevationNote]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="{Binding Text[BenchStart]}" Command="{Binding StartCommand}" Style="{StaticResource AccentButtonStyle}"/><Button Content="{Binding Text[BenchStop]}" Command="{Binding StopCommand}"/></StackPanel>
   <ProgressBar IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></Border>
  <ComboBox Header="{Binding Text[BenchSession]}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
  <Border Style="{StaticResource CardStyle}" Visibility="{Binding HasResult, Converter={StaticResource BooleanVisibility}}"><StackPanel Spacing="16">
   <TextBlock Text="{Binding Text[BenchResult]}" Style="{StaticResource SectionTitleStyle}"/>
   <TextBlock Text="{Binding Text[BenchLossUnknown]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   <StackPanel Spacing="6"><TextBlock Text="{Binding Text[BenchAverage]}"/><TextBlock Text="{Binding Average}" FontSize="28" Foreground="{ThemeResource RoseBrush}"/><TextBlock Text="1% low"/><TextBlock Text="{Binding Low1}" FontSize="22"/><TextBlock Text="P99 · frametime"/><TextBlock Text="{Binding P99}" FontSize="22"/></StackPanel>
   <TextBlock Text="{Binding Text[BenchChart]}"/>
   <local:FrametimeChart x:Name="Chart" Height="150"/>
   <ComboBox Header="{Binding Text[BenchBaseline]}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding Baseline, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
   <TextBlock Text="{Binding Comparison}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Text[BenchComparisonCaution]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   <Expander Header="{Binding Text[UxTechnicalDetails]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12"><TextBlock Text="{Binding Text[BenchMethod]}" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></Expander>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
