<UserControl x:Class="Lotus.App.Controls.GameTunePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" AutomationProperties.AutomationId="tune-panel">
 <!-- "Otimizar este jogo": large centered window with what the game supports, settings for this PC, in-game tips and the last check -->
 <Grid>
  <Border x:Name="Backdrop" Background="#990C060A" Opacity="0" Tapped="OnBackdrop"/>
  <Grid x:Name="Sheet" MaxWidth="1080" MaxHeight="860" Margin="40,32,40,32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="22" Opacity="0"
        Background="{ThemeResource WindowBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
   <Grid.RenderTransform><ScaleTransform x:Name="SheetScale" ScaleX="0.96" ScaleY="0.96"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- Header: the game's art, name and what was detected -->
   <Grid Height="210" RequestedTheme="Dark" Background="#160C14">
    <Image x:Name="HeaderArt" Stretch="UniformToFill" Opacity="0"/>
    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#33160C14" Offset="0"/><GradientStop Color="#F2160C14" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Button x:Name="CloseButton" Click="OnClose" Background="#8012090F" BorderThickness="0" Padding="9" CornerRadius="18" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.AutomationId="tune-close"><FontIcon Glyph="&#xE711;" FontSize="12" Foreground="White"/></Button>
    <StackPanel VerticalAlignment="Bottom" Padding="36,0,36,22" Spacing="8">
     <TextBlock x:Name="Eyebrow" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" Foreground="#F07A9C"/>
     <TextBlock x:Name="GameName" FontSize="32" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
     <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="8"/>
    </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" Padding="36,24,36,24" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Body" Spacing="18">
     <ProgressRing x:Name="LoadingRing" IsActive="True" Width="28" Height="28" HorizontalAlignment="Left"/>
    </StackPanel>
   </ScrollViewer>
   <!-- Fixed footer: actions -->
   <Grid x:Name="Footer" Grid.Row="2" Padding="36,14,36,22" ColumnSpacing="12" MaxWidth="760" HorizontalAlignment="Stretch" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="SecondaryAction" Style="{StaticResource SoftButtonStyle}" HorizontalAlignment="Stretch" MinHeight="48" FontSize="15" Visibility="Collapsed" Click="OnSecondary" AutomationProperties.AutomationId="tune-secondary"/>
    <Button x:Name="PrimaryAction" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" MinHeight="48" FontSize="15" Visibility="Collapsed" Click="OnPrimary" AutomationProperties.AutomationId="tune-primary"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
