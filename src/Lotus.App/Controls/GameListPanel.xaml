<UserControl x:Class="Lotus.App.Controls.GameListPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls" AutomationProperties.AutomationId="gamelist">
 <Grid>
  <!-- Lists -->
  <StackPanel x:Name="ListArea" Spacing="16">
   <!-- "I don't know what to play" -->
   <Border Style="{StaticResource HeroCardStyle}" Padding="24">
    <Grid ColumnSpacing="24">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="12">
       <Border Width="44" Height="44" CornerRadius="14" Background="{ThemeResource AccentGradientBrush}"><FontIcon x:Name="DiceIcon" Glyph="&#xE8B1;" FontSize="20" Foreground="White"/></Border>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Text[GlPickTitle]}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Text[GlPickBody]}" Style="{StaticResource CaptionStyle}"/></StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12">
       <ComboBox x:Name="GenreBox" Header="{Binding Text[GlGenre]}" ItemsSource="{Binding GenreChips}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedIndex="0" MinWidth="160" SelectionChanged="OnGenre" AutomationProperties.AutomationId="pick-genre"/>
       <ComboBox x:Name="DiffBox" Header="{Binding Text[GlDifficulty]}" MinWidth="150" SelectedIndex="0" SelectionChanged="OnDifficulty" AutomationProperties.AutomationId="pick-difficulty"/>
       <StackPanel VerticalAlignment="Bottom" Spacing="0">
        <CheckBox Content="{Binding Text[GlOnlyNew]}" IsChecked="{Binding OnlyNotOwned, Mode=TwoWay}"/>
        <CheckBox Content="{Binding Text[GlOnlyFree]}" IsChecked="{Binding OnlyFree, Mode=TwoWay}"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12">
       <Button Click="OnPick" Style="{StaticResource PrimaryButtonStyle}" MinHeight="44" AutomationProperties.AutomationId="pick-go">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B1;" FontSize="14"/><TextBlock x:Name="PickLabel" Text="{Binding Text[GlPick]}"/></StackPanel>
       </Button>
       <ProgressRing IsActive="{Binding Picking}" Width="20" Height="20" Visibility="{Binding Picking, Converter={StaticResource BooleanVisibility}}"/>
       <TextBlock Text="{Binding PickStatus}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" MaxWidth="420" app:Motion.Settle="True"/>
      </StackPanel>
     </StackPanel>
     <!-- Shuffling covers while drawing -->
     <Grid Grid.Column="1" Width="150" Height="200" CornerRadius="14" Background="{ThemeResource CardBrush}">
      <Image x:Name="ShuffleArt" Stretch="UniformToFill"/>
      <FontIcon x:Name="ShuffleIdle" Glyph="&#xE7FC;" FontSize="40" Foreground="{ThemeResource RoseBrush}" Opacity="0.6"/>
     </Grid>
    </Grid>
   </Border>

   <!-- Search + charts + filters -->
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <AutoSuggestBox x:Name="Search" PlaceholderText="{Binding Text[GlSearchPlaceholder]}" QueryIcon="Find" TextChanged="OnSearch" AutomationProperties.AutomationId="gamelist-search"/>
    <Button Grid.Column="1" Click="OnRefresh" Style="{StaticResource SoftButtonStyle}" ToolTipService.ToolTip="{Binding Text[GlRefresh]}" AutomationProperties.Name="{Binding Text[GlRefresh]}">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="13"/><TextBlock Text="{Binding Text[GlRefresh]}"/></StackPanel>
    </Button>
   </Grid>
   <SelectorBar x:Name="ChartBar" SelectionChanged="OnChart" Visibility="{Binding Searching, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}" AutomationProperties.AutomationId="gamelist-charts"/>
   <StackPanel Orientation="Horizontal" Spacing="12">
    <ComboBox x:Name="SortBox" Header="{Binding Text[GlSortBy]}" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Sort, Mode=TwoWay}" MinWidth="190"/>
    <ComboBox Header="{Binding Text[GlMinRating]}" ItemsSource="{Binding RatingOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding MinRating, Mode=TwoWay}" MinWidth="150"/>
    <StackPanel VerticalAlignment="Bottom">
     <CheckBox Content="{Binding Text[GlHideOwned]}" IsChecked="{Binding HideOwned, Mode=TwoWay}"/>
     <CheckBox Content="{Binding Text[GlFreeOnly]}" IsChecked="{Binding FreeOnly, Mode=TwoWay}"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Spacing="10">
    <ProgressRing IsActive="{Binding Loading}" Width="16" Height="16" Visibility="{Binding Loading, Converter={StaticResource BooleanVisibility}}"/>
    <TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding ChartHint}"/><Run Text="  "/><Run Text="{Binding Status}" Foreground="{ThemeResource MutedBrush}"/></TextBlock>
   </StackPanel>
   <TextBlock Text="{Binding Text[GlEmpty]}" Style="{StaticResource CaptionStyle}" FontSize="14" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}"/>

   <GridView ItemsSource="{Binding Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItem" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="0" AutomationProperties.AutomationId="gamelist-grid">
    <GridView.ItemContainerTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20"/><RepositionThemeTransition/></TransitionCollection></GridView.ItemContainerTransitions>
    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="Padding" Value="0"/></Style></GridView.ItemContainerStyle>
    <GridView.ItemTemplate><DataTemplate>
     <Border Width="164" CornerRadius="14" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" app:Motion.Hover="1.04" AutomationProperties.Name="{Binding Name}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="218"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border CornerRadius="13,13,0,0" Background="{ThemeResource HeroBrush}">
        <Grid>
         <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource GoldBrush}"/>
         <Image Source="{Binding Cover}" Stretch="UniformToFill" ImageFailed="OnCoverFailed" Tag="{Binding Wide}"/>
         <Border Background="#CC12090F" CornerRadius="8" Padding="8,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding Rank, Converter={StaticResource PresenceVisibility}}">
          <TextBlock Text="{Binding Rank}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource GoldBrush}"/>
         </Border>
         <Border Background="{ThemeResource AccentGradientBrush}" CornerRadius="8" Padding="8,3" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding Installed, Converter={StaticResource BooleanVisibility}}">
          <TextBlock Text="{Binding DataContext.Text[GlInstalled], ElementName=ListArea}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
         </Border>
        </Grid>
       </Border>
       <StackPanel Grid.Row="1" Padding="10,8,10,10" Spacing="2">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
        <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate></GridView.ItemTemplate>
   </GridView>

   <!-- Credits -->
   <Border Style="{StaticResource SettingRowStyle}">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="{ThemeResource GoldBrush}" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" app:Rich.Text="{Binding Text[GlCredits]}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
     <HyperlinkButton Grid.Column="2" Content="{Binding Text[GlCreditsLink]}" NavigateUri="https://mygamelist.club"/>
    </Grid>
   </Border>
  </StackPanel>

  <!-- Game page -->
  <controls:GameDetailView x:Name="Detail" Visibility="Collapsed" DataContext="{Binding Details}" BackRequested="OnBack" PlayRequested="OnPlay"/>
 </Grid>
</UserControl>
