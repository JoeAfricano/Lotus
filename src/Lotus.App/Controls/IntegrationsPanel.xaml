<UserControl x:Class="Lotus.App.Controls.IntegrationsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls">
 <StackPanel Spacing="10" app:Motion.Stagger="True">
  <TextBlock Text="{Binding Text[IntegrationsCategory]}" Style="{StaticResource SectionTitleStyle}"/>
  <TextBlock Text="{Binding Text[IntIntro]}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/>
  <controls:RtssCard/>
  <!-- MSI Afterburner -->
  <Border Style="{StaticResource CardStyle}">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE9CA;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="MSI Afterburner" FontWeight="SemiBold"/><TextBlock Text="{Binding AfterburnerStatus}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Text[IntAfterburnerWhat]}" Style="{StaticResource CaptionStyle}"/></StackPanel>
   </Grid>
  </Border>
  <!-- SCSKiller -->
  <Border Style="{StaticResource CardStyle}">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE945;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="SCSKiller" FontWeight="SemiBold"/><TextBlock Text="{Binding ScsStatus}" Style="{StaticResource CaptionStyle}"/></StackPanel>
    <HyperlinkButton Grid.Column="2" Content="{Binding Text[ScsOfferLink]}" Click="OnScsLink" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </StackPanel>
</UserControl>
