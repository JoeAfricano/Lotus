<UserControl x:Class="Lotus.App.Controls.IntegrationsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="10">
  <TextBlock Text="{Binding Text[IntegrationsCategory]}" Style="{StaticResource SectionTitleStyle}"/>
  <TextBlock Text="{Binding Text[IntIntro]}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/>
  <!-- RivaTuner -->
  <Border Style="{StaticResource CardStyle}">
   <StackPanel Spacing="10">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE7F4;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="RivaTuner Statistics Server" FontWeight="SemiBold"/><TextBlock Text="{Binding RtssStatus}" Style="{StaticResource CaptionStyle}" AutomationProperties.AutomationId="int-rtss-status"/></StackPanel>
    </Grid>
    <TextBlock Text="{Binding Text[IntRtssWhat]}" Style="{StaticResource CaptionStyle}"/>
    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding RtssInstalled, Converter={StaticResource BooleanVisibility}}">
     <Button Content="{Binding Text[IntOverlayApply]}" Click="OnApplyOverlay" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="int-rtss-apply"/>
     <Button Content="{Binding Text[GsRestore]}" Click="OnRestoreOverlay" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding CanRestoreRtss, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="int-rtss-restore"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <!-- MSI Afterburner -->
  <Border Style="{StaticResource CardStyle}">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE9CA;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="MSI Afterburner" FontWeight="SemiBold"/><TextBlock Text="{Binding AfterburnerStatus}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Text[IntAfterburnerWhat]}" Style="{StaticResource CaptionStyle}"/></StackPanel>
   </Grid>
  </Border>
  <!-- SCSKiller -->
  <Border Style="{StaticResource CardStyle}">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE945;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="SCSKiller" FontWeight="SemiBold"/><TextBlock Text="{Binding ScsStatus}" Style="{StaticResource CaptionStyle}"/></StackPanel>
    <HyperlinkButton Grid.Column="2" Content="{Binding Text[ScsOfferLink]}" Click="OnScsLink" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <ProgressBar IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}"/>
  <TextBlock Text="{Binding Message}" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource GoldBrush}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="int-message"/>
 </StackPanel>
</UserControl>
