<UserControl x:Class="Lotus.App.Controls.PrimaryActionCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Lotus.App.Controls">
 <Border Style="{StaticResource HeroCardStyle}">
  <Grid ColumnSpacing="24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="14">
    <Border Width="52" Height="52" CornerRadius="16" Background="{ThemeResource AccentGradientBrush}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{ThemeResource OnRoseBrush}" AutomationProperties.AccessibilityView="Raw"/></Border>
    <TextBlock Text="{Binding Heading}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
    <TextBlock Text="{Binding Description}" FontSize="15" TextWrapping="Wrap" LineHeight="23" MaxWidth="640" HorizontalAlignment="Left" Foreground="{ThemeResource MutedBrush}"/>
    <local:OperationProgress Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanVisibility}}" MaxWidth="520" HorizontalAlignment="Left"/>
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
     <Button Content="{Binding Text[UxAnalyzeNow]}" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding ShowStart, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="analysis-start"/>
     <Button Content="{Binding Text[UxCancel]}" Command="{Binding CancelCommand}" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="analysis-cancel"/>
     <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{Binding HasResult, Converter={StaticResource BooleanVisibility}}">
      <Button Content="{Binding Text[UxViewResult]}" Command="{Binding ViewResultCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="analysis-result"/>
      <Button Content="{Binding Text[UxAnalyzeAgain]}" Command="{Binding AnalyzeCommand}" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="analysis-again"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE83D;" FontSize="13" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/><TextBlock Text="{Binding Text[UxAnalysisSafety]}" Style="{StaticResource CaptionStyle}" MaxWidth="600"/></StackPanel>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
