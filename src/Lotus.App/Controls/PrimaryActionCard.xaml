<UserControl x:Class="Lotus.App.Controls.PrimaryActionCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Lotus.App.Controls">
 <Border Background="{ThemeResource ElevatedBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
  <StackPanel Spacing="16">
   <FontIcon Glyph="&#xE9D9;" FontSize="32" Foreground="{ThemeResource RoseBrush}" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw"/>
   <TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
   <TextBlock Text="{Binding Description}" FontSize="15" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left"/>
   <local:OperationProgress Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanVisibility}}"/>
   <Button Content="{Binding Text[UxAnalyzeNow]}" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding ShowStart, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="analysis-start"/>
   <Button Content="{Binding Text[UxCancel]}" Command="{Binding CancelCommand}" Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="analysis-cancel"/>
   <StackPanel Spacing="12" Visibility="{Binding HasResult, Converter={StaticResource BooleanVisibility}}">
    <Button Content="{Binding Text[UxViewResult]}" Command="{Binding ViewResultCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="analysis-result"/>
    <Button Content="{Binding Text[UxAnalyzeAgain]}" Command="{Binding AnalyzeCommand}" AutomationProperties.AutomationId="analysis-again"/>
   </StackPanel>
   <TextBlock Text="{Binding Text[UxAnalysisSafety]}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
  </StackPanel>
 </Border>
</UserControl>
