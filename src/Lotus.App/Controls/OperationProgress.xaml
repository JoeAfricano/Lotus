<UserControl x:Class="Lotus.App.Controls.OperationProgress" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="10">
  <TextBlock Text="{Binding Text[UxCurrentCheck]}" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <ProgressBar Minimum="0" Maximum="30" Value="{Binding ObservationSeconds}" IsIndeterminate="{Binding WaitingAnimation}" Height="8" AutomationProperties.Name="{Binding ObservationProgress}" AutomationProperties.AutomationId="analysis-observation-progress"/>
  <TextBlock Text="{Binding ElapsedTime}" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" AutomationProperties.AutomationId="analysis-elapsed"/>
  <TextBlock Text="{Binding ObservationProgress}" Style="{StaticResource CaptionStyle}"/>
 </StackPanel>
</UserControl>
