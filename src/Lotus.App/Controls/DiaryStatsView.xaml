<UserControl x:Class="Lotus.App.Controls.DiaryStatsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" AutomationProperties.AutomationId="diary-stats">
 <UserControl.Resources>
  <app:BooleanChoiceConverter x:Key="ValueOpacity"><app:BooleanChoiceConverter.TrueValue><x:Double>1</x:Double></app:BooleanChoiceConverter.TrueValue><app:BooleanChoiceConverter.FalseValue><x:Double>0</x:Double></app:BooleanChoiceConverter.FalseValue></app:BooleanChoiceConverter>
  <app:BooleanChoiceConverter x:Key="BarOpacity"><app:BooleanChoiceConverter.TrueValue><x:Double>1</x:Double></app:BooleanChoiceConverter.TrueValue><app:BooleanChoiceConverter.FalseValue><x:Double>0.5</x:Double></app:BooleanChoiceConverter.FalseValue></app:BooleanChoiceConverter>
  <!-- Column bar (one series, one hue): the peak is full rose, the rest softer; value text on the peak, every value on hover -->
  <DataTemplate x:Key="ColumnBar">
   <Grid Background="Transparent" ToolTipService.ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Hint}" RowSpacing="6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding ValueText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="{Binding ShowValue, Converter={StaticResource ValueOpacity}}"/>
    <Border Grid.Row="1" VerticalAlignment="Bottom" MaxWidth="34" CornerRadius="4,4,0,0" Height="{Binding Fraction, Converter={StaticResource Scale}, ConverterParameter=120}"
            Background="{ThemeResource RoseBrush}" Opacity="{Binding Highlight, Converter={StaticResource BarOpacity}}"/>
    <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
   </Grid>
  </DataTemplate>
  <!-- Row bar: label, bar, value (the value is always text) -->
  <DataTemplate x:Key="RowBar">
   <Grid ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Hint}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding Fraction}" MinHeight="10" CornerRadius="5" VerticalAlignment="Center" Background="{ThemeResource SubtleBrush}" Foreground="{ThemeResource RoseBrush}"/>
    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Chip">
   <Border CornerRadius="14" Padding="12,6" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
    <StackPanel Orientation="Horizontal" Spacing="8">
     <FontIcon Glyph="{Binding Glyph}" FontSize="13" Foreground="{ThemeResource GoldBrush}"/>
     <TextBlock Text="{Binding Label}" FontSize="12.5"/>
     <TextBlock Text="{Binding Count}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/>
    </StackPanel>
   </Border>
  </DataTemplate>
  <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Padding" Value="22,18"/><Setter Property="CornerRadius" Value="16"/></Style>
  <Style x:Key="ChartTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </UserControl.Resources>

 <StackPanel Spacing="18">
  <!-- Title, year and the yearly recap -->
  <Grid ColumnSpacing="14">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="2" VerticalAlignment="Center">
    <TextBlock Text="{Binding Text[DyStTitle]}" FontFamily="Georgia" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/>
    <TextBlock Text="{Binding Text[DyStHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   </StackPanel>
   <ComboBox x:Name="YearBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="110" ItemsSource="{Binding Years}" SelectionChanged="OnYear"
             AutomationProperties.Name="{Binding Text[DyStYear]}" AutomationProperties.AutomationId="diary-stats-year"/>
   <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Click="OnRecap" VerticalAlignment="Center" AutomationProperties.AutomationId="diary-recap">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE734;" FontSize="14"/><TextBlock Text="{Binding RecapText}"/></StackPanel>
   </Button>
  </Grid>

  <TextBlock Text="{Binding Text[DyStEmpty]}" Style="{StaticResource CaptionStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}"/>

  <StackPanel Spacing="18" Visibility="{Binding HasData, Converter={StaticResource BooleanVisibility}}">
   <!-- Headline numbers -->
   <ItemsRepeater ItemsSource="{Binding Tiles}">
    <ItemsRepeater.Layout><UniformGridLayout x:Name="TilesLayout" MinItemWidth="100" MinItemHeight="96" MinColumnSpacing="12" MinRowSpacing="12" MaximumRowsOrColumns="6" ItemsStretch="Fill"/></ItemsRepeater.Layout>
    <ItemsRepeater.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource CardStyle}" Padding="16,12" CornerRadius="14">
      <Grid ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource AccentSoftBrush}" VerticalAlignment="Center"><FontIcon Glyph="{Binding Glyph}" FontSize="15" Foreground="{ThemeResource GoldBrush}"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="2"/>
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ItemsRepeater.ItemTemplate>
   </ItemsRepeater>

   <!-- Hours per month | rating distribution -->
   <Grid x:Name="Pair1" ColumnSpacing="18" RowSpacing="18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource ChartCard}">
     <StackPanel Spacing="12">
      <StackPanel Spacing="2"><TextBlock Text="{Binding MonthTitle}" Style="{StaticResource ChartTitle}"/><TextBlock Text="{Binding MonthSummary}" Style="{StaticResource CaptionStyle}"/></StackPanel>
      <Grid>
       <Border VerticalAlignment="Top" Margin="0,137,0,0" Height="1" Background="{ThemeResource DividerBrush}"/>
       <ItemsRepeater ItemsSource="{Binding MonthBars}" ItemTemplate="{StaticResource ColumnBar}">
        <ItemsRepeater.Layout><UniformGridLayout MaximumRowsOrColumns="12" MinItemWidth="22" MinColumnSpacing="6" ItemsStretch="Fill"/></ItemsRepeater.Layout>
       </ItemsRepeater>
      </Grid>
      <TextBlock Text="{Binding Text[DyStMonthNote]}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Border x:Name="RatingCard" Grid.Column="1" Style="{StaticResource ChartCard}">
     <StackPanel Spacing="12">
      <StackPanel Spacing="2"><TextBlock Text="{Binding Text[DyStRatingTitle]}" Style="{StaticResource ChartTitle}"/><TextBlock Text="{Binding RatingSummary}" Style="{StaticResource CaptionStyle}"/></StackPanel>
      <Grid>
       <Border VerticalAlignment="Top" Margin="0,137,0,0" Height="1" Background="{ThemeResource DividerBrush}"/>
       <ItemsRepeater ItemsSource="{Binding RatingBars}" ItemTemplate="{StaticResource ColumnBar}">
        <ItemsRepeater.Layout><UniformGridLayout MaximumRowsOrColumns="10" MinItemWidth="18" MinColumnSpacing="5" ItemsStretch="Fill"/></ItemsRepeater.Layout>
       </ItemsRepeater>
      </Grid>
     </StackPanel>
    </Border>
   </Grid>

   <!-- Genres | platforms -->
   <Grid x:Name="Pair2" ColumnSpacing="18" RowSpacing="18">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource ChartCard}">
     <StackPanel Spacing="14">
      <TextBlock Text="{Binding Text[DyStGenres]}" Style="{StaticResource ChartTitle}"/>
      <TextBlock Text="{Binding Text[DyStGenresEmpty]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Visibility="{Binding HasGenres, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}"/>
      <ItemsRepeater ItemsSource="{Binding GenreBars}" ItemTemplate="{StaticResource RowBar}"><ItemsRepeater.Layout><StackLayout Spacing="12"/></ItemsRepeater.Layout></ItemsRepeater>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Style="{StaticResource ChartCard}">
     <StackPanel Spacing="14">
      <TextBlock Text="{Binding Text[DyStPlatforms]}" Style="{StaticResource ChartTitle}"/>
      <ItemsRepeater ItemsSource="{Binding PlatformBars}" ItemTemplate="{StaticResource RowBar}"><ItemsRepeater.Layout><StackLayout Spacing="12"/></ItemsRepeater.Layout></ItemsRepeater>
     </StackPanel>
    </Border>
   </Grid>

   <!-- Category averages | moods and difficulty -->
   <Grid x:Name="Pair3" ColumnSpacing="18" RowSpacing="18">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource ChartCard}">
     <StackPanel Spacing="14">
      <TextBlock Text="{Binding Text[DyStCategories]}" Style="{StaticResource ChartTitle}"/>
      <TextBlock Text="{Binding Text[DyStCategoriesEmpty]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Visibility="{Binding HasCategories, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}"/>
      <ItemsRepeater ItemsSource="{Binding CategoryBars}" ItemTemplate="{StaticResource RowBar}"><ItemsRepeater.Layout><StackLayout Spacing="12"/></ItemsRepeater.Layout></ItemsRepeater>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Style="{StaticResource ChartCard}">
     <StackPanel Spacing="14">
      <TextBlock Text="{Binding Text[DyStMoods]}" Style="{StaticResource ChartTitle}"/>
      <TextBlock Text="{Binding Text[DyStMoodsEmpty]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Visibility="{Binding HasMoods, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}"/>
      <ItemsRepeater ItemsSource="{Binding MoodChips}" ItemTemplate="{StaticResource Chip}">
       <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="150" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill"/></ItemsRepeater.Layout>
      </ItemsRepeater>
      <ItemsRepeater ItemsSource="{Binding DifficultyChips}" ItemTemplate="{StaticResource Chip}">
       <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="150" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill"/></ItemsRepeater.Layout>
      </ItemsRepeater>
     </StackPanel>
    </Border>
   </Grid>
  </StackPanel>
 </StackPanel>
</UserControl>
