<UserControl x:Class="Lotus.App.Controls.UninstallerCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls" x:Name="Root">
 <Border Style="{StaticResource CardStyle}">
  <StackPanel Spacing="12">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE71D;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="3">
     <TextBlock Text="{Binding Text[UninTitle]}" FontWeight="SemiBold"/>
     <TextBlock app:Rich.Text="{Binding Text[UninWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
   <TextBox Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Text[UninSearch]}" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Text[UninSearch]}" AutomationProperties.AutomationId="unin-search"/>
   <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionStyle}"/>
   <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Apps}" AutomationProperties.AutomationId="unin-apps">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid ColumnSpacing="12" Padding="0,6,12,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding App.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <Button Grid.Column="1" Content="{Binding DataContext.Text[UninButton], ElementName=Root}" Tag="{Binding}" Click="OnUninstall" Style="{StaticResource SoftButtonStyle}" AutomationProperties.Name="{Binding App.Name}"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <TextBlock Text="{Binding Status}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="unin-status"/>
   <controls:TaskProgressView State="{Binding Job}" AutomationProperties.AutomationId="unin-task"/>
   <!-- Leftovers to review after the program's own uninstaller finished -->
   <StackPanel Spacing="8" Visibility="{Binding HasLeftovers, Converter={StaticResource BooleanVisibility}}">
    <TextBlock app:Rich.Text="{Binding Text[UninLeftoversWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding Leftovers}" AutomationProperties.AutomationId="unin-leftovers">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid ColumnSpacing="12" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
       <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanRecycle}"><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}"/></CheckBox>
       <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="{Binding Text[UninRecycle]}" Click="OnRecycleLeftovers" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="unin-recycle"/>
    </StackPanel>
   </StackPanel>
  </StackPanel>
 </Border>
</UserControl>
