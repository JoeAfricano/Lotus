<UserControl x:Class="Lotus.App.Controls.SteamTrophiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Lotus.App" AutomationProperties.AutomationId="steam-trophies">
 <StackPanel Spacing="16">
  <!-- Numbers -->
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CompactCardStyle}" Padding="14,10"><StackPanel><TextBlock Text="{Binding SteamUnlockedText}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}" AutomationProperties.AutomationId="steam-unlocked"/><TextBlock Text="{Binding Text[TrSteamUnlocked]}" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource CompactCardStyle}" Padding="14,10"><StackPanel><TextBlock Text="{Binding SteamPerfectText}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[TrSteamPerfect]}" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}" Padding="14,10"><StackPanel><TextBlock Text="{Binding SteamGamesText}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[TrSteamGames]}" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
   <Border Grid.Column="3" Style="{StaticResource CompactCardStyle}" Padding="14,10"><StackPanel><TextBlock Text="{Binding SteamXpText}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding Text[TrSteamXp]}" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
  </Grid>
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource SuccessBrush}"/>
    <TextBlock Text="{Binding Text[TrSteamHint]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding SyncText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
   <Button Grid.Column="2" Click="OnSync" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="steam-sync">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="SyncIcon" Glyph="&#xE72C;" FontSize="13"/><TextBlock Text="{Binding Text[TrSync]}"/></StackPanel>
   </Button>
  </Grid>

  <!-- No Steam data -->
  <Border Style="{StaticResource CardStyle}" Visibility="{Binding NoSteam, Converter={StaticResource BooleanVisibility}}">
   <StackPanel Spacing="10" HorizontalAlignment="Center" Padding="0,14">
    <FontIcon Glyph="&#xE7FC;" FontSize="34" Foreground="{ThemeResource RoseBrush}"/>
    <TextBlock Text="{Binding Text[TrNoSteam]}" Style="{StaticResource CaptionStyle}" FontSize="14" TextAlignment="Center" MaxWidth="560" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <ProgressBar IsIndeterminate="True" Visibility="{Binding Syncing, Converter={StaticResource BooleanVisibility}}"/>

  <!-- Every game -->
  <StackPanel x:Name="GamesArea" Spacing="12">
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <AutoSuggestBox PlaceholderText="{Binding Text[TrSteamSearch]}" QueryIcon="Find" TextChanged="OnSearch" AutomationProperties.AutomationId="steam-search"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding SteamSorts}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SteamSort, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
   </Grid>
   <ItemsRepeater ItemsSource="{Binding SteamGames}" AutomationProperties.AutomationId="steam-games">
    <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="290" MinItemHeight="232" MinRowSpacing="14" MinColumnSpacing="14" ItemsStretch="Fill"/></ItemsRepeater.Layout>
    <ItemsRepeater.ItemTemplate><DataTemplate>
     <Button Click="OnGame" Style="{StaticResource CardButtonStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
      <Border CornerRadius="16" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" app:Motion.Hover="1.02">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid CornerRadius="15,15,0,0" Background="{ThemeResource HeroBrush}">
         <TextBlock Text="{Binding Name}" Margin="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
         <Image Source="{Binding Header, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/>
         <Border Visibility="{Binding Perfect, Converter={StaticResource BooleanVisibility}}" Background="{ThemeResource GoldGradientBrush}" CornerRadius="10" Padding="9,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE735;" FontSize="11" Foreground="#3A0F24"/><TextBlock Text="100%" FontSize="11.5" FontWeight="Bold" Foreground="#3A0F24"/></StackPanel>
         </Border>
        </Grid>
        <StackPanel Grid.Row="1" Padding="14,10,14,12" Spacing="5">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         <ProgressBar Value="{Binding Percent}" Maximum="100" MinHeight="5" CornerRadius="3"/>
         <Grid><TextBlock Text="{Binding CountText}" FontSize="12"/><TextBlock Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}" HorizontalAlignment="Right"/></Grid>
         <TextBlock Text="{Binding LastText}" FontSize="11.5" Foreground="{ThemeResource MutedBrush}"/>
        </StackPanel>
       </Grid>
      </Border>
     </Button>
    </DataTemplate></ItemsRepeater.ItemTemplate>
   </ItemsRepeater>
  </StackPanel>

  <!-- One game: every achievement -->
  <StackPanel x:Name="DetailArea" Spacing="14" Visibility="Collapsed">
   <Button Click="OnBack" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="steam-back">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="12"/><TextBlock Text="{Binding Text[TrBack]}"/></StackPanel>
   </Button>
   <Grid Height="170" CornerRadius="18" Background="{ThemeResource HeroBrush}" RequestedTheme="Dark">
    <Image Source="{Binding Selected.Header, Converter={StaticResource CoverImage}}" Stretch="UniformToFill" Opacity="0.7"/>
    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2012090F" Offset="0"/><GradientStop Color="#F2170B13" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <StackPanel Padding="22,0,22,18" VerticalAlignment="Bottom" Spacing="6">
     <TextBlock Text="{Binding Selected.Name}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="steam-detail-name"/>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ProgressBar Value="{Binding Selected.Percent}" Maximum="100" MinHeight="6" CornerRadius="3" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1"><Run Text="{Binding Selected.CountText}"/><Run Text="  ·  "/><Run Text="{Binding Selected.PercentText}" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}"/></TextBlock>
     </Grid>
    </StackPanel>
   </Grid>
   <ItemsRepeater ItemsSource="{Binding SelectedItems}" AutomationProperties.AutomationId="steam-achievements">
    <ItemsRepeater.Layout><StackLayout Spacing="8"/></ItemsRepeater.Layout>
    <ItemsRepeater.ItemTemplate><DataTemplate>
     <Border Padding="12" CornerRadius="14" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" AutomationProperties.Name="{Binding Name}">
      <Grid ColumnSpacing="14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="52" Height="52" CornerRadius="10" Background="{ThemeResource HeroBrush}" Opacity="{Binding Unlocked, Converter={StaticResource UnlockedOpacity}}">
        <Image Source="{Binding Icon, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/>
       </Border>
       <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Opacity="{Binding Unlocked, Converter={StaticResource UnlockedOpacity}}">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="{Binding RarityText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{Binding RarityKind, Converter={StaticResource DiaryBrush}}"/>
        <TextBlock Text="{Binding DateText}" FontSize="11.5" HorizontalAlignment="Right" Foreground="{ThemeResource MutedBrush}"/>
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ItemsRepeater.ItemTemplate>
   </ItemsRepeater>
  </StackPanel>
 </StackPanel>
</UserControl>
