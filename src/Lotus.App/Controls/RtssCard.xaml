<UserControl x:Class="Lotus.App.Controls.RtssCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- RivaTuner overlay: shown in My Games (where players look) and in Settings › Integrations. -->
 <Border Style="{StaticResource CardStyle}">
  <StackPanel Spacing="12">
   <Grid ColumnSpacing="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE7F4;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
     <TextBlock Text="{Binding Text[IntOverlayCardTitle]}" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding RtssStatus}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="int-rtss-status"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding LayoutStatus}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" VerticalAlignment="Center" AutomationProperties.AutomationId="int-layout-status"/>
   </Grid>
   <TextBlock Text="{Binding Text[IntLayoutWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   <!-- Main choice first: the full Lotus overlay; the simple OSD stays as an alternative. -->
   <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding RtssInstalled, Converter={StaticResource BooleanVisibility}}">
    <Button Click="OnActivateLayout" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="int-layout-apply">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7F4;" FontSize="13"/><TextBlock Text="{Binding Text[IntLayoutApply]}"/></StackPanel>
    </Button>
    <Button Content="{Binding Text[IntLayoutRestore]}" Click="OnRestoreLayout" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding CanRestoreLayout, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="int-layout-restore"/>
    <Button Content="{Binding Text[IntLayoutExport]}" Click="OnExportLayout" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="int-layout-export"/>
   </StackPanel>
   <Expander Header="{Binding Text[IntSimpleOsd]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{Binding RtssInstalled, Converter={StaticResource BooleanVisibility}}">
    <StackPanel Spacing="10">
     <TextBlock Text="{Binding Text[IntRtssWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{Binding Text[IntOverlayApply]}" Click="OnApplyOverlay" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="int-rtss-apply"/>
      <Button Content="{Binding Text[GsRestore]}" Click="OnRestoreOverlay" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding CanRestoreRtss, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="int-rtss-restore"/>
     </StackPanel>
    </StackPanel>
   </Expander>
   <ProgressBar IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}"/>
   <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="int-message"/>
  </StackPanel>
 </Border>
</UserControl>
