<UserControl x:Class="Lotus.App.Controls.OptimizationPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ContentControl Style="{StaticResource CardControlStyle}">
  <StackPanel Spacing="12">
   <TextBlock Text="{Binding Text[OptTitle]}" Style="{StaticResource SectionTitleStyle}"/>
   <TextBlock Text="{Binding Text[OptTestDescription]}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Text[OptSafety]}" TextWrapping="Wrap"/>
   <Button Content="{Binding Text[OptAnalyze]}" Command="{Binding AnalyzeCommand}"/>
   <ComboBox Header="{Binding Text[OptHistory]}" ItemsSource="{Binding Plans}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Id" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <CheckBox Content="{Binding Text[OptConfirm]}" IsChecked="{Binding Confirmed, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
   <StackPanel Spacing="8">
    <Button Content="{Binding Text[OptApply]}" Command="{Binding ApplyCommand}"/>
    <Button Content="{Binding Text[OptRevert]}" Command="{Binding RevertCommand}"/>
    <Button Content="{Binding Text[OptRefresh]}" Command="{Binding RefreshCommand}"/>
   </StackPanel>
  </StackPanel>
 </ContentControl>
</UserControl>
