<UserControl x:Class="Lotus.App.Controls.GamesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls" x:Name="Root">
 <StackPanel Spacing="18" app:Motion.Stagger="True">
  <!-- Toolbar: search, store filter, add, rescan -->
  <Grid ColumnSpacing="12" RowSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox PlaceholderText="{Binding Text[GamesSearch]}" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Text[GamesSearch]}" AutomationProperties.AutomationId="games-search"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore, Mode=TwoWay}" DisplayMemberPath="Label" MinWidth="170" MinHeight="40" AutomationProperties.AutomationId="games-store"/>
   <Button Grid.Column="2" Click="OnAddGame" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="{Binding Text[GamesAdd]}" AutomationProperties.AutomationId="games-add"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13"/><TextBlock Text="{Binding Text[GamesAdd]}"/></StackPanel></Button>
   <Button Grid.Column="3" Click="OnRescan" Style="{StaticResource SoftButtonStyle}" AutomationProperties.Name="{Binding Text[GamesRescan]}" AutomationProperties.AutomationId="games-rescan"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="13"/><TextBlock Text="{Binding Text[GamesRescan]}"/></StackPanel></Button>
  </Grid>
  <StackPanel Spacing="4">
   <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" AutomationProperties.AutomationId="games-summary"/>
   <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource RoseBrush}" AutomationProperties.LiveSetting="Polite" app:Motion.Settle="True" AutomationProperties.AutomationId="games-status"/>
   <TextBlock Text="{Binding Text[GamesReadOnly]}" Style="{StaticResource CaptionStyle}"/>
  </StackPanel>
  <!-- Shader pre-compilation in progress: game, stage, bar and time left -->
  <Border Style="{StaticResource CardStyle}" Visibility="{Binding ShaderCardVisible, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="games-shader-job">
   <Grid ColumnSpacing="16" RowSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}" VerticalAlignment="Top"><FontIcon Glyph="&#xE945;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
     <TextBlock Text="{Binding ShaderJobTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding ShaderJobDetail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" app:Motion.Settle="True"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button Content="{Binding Text[ScsOpen]}" Click="OnOpenShaderToolButton" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="games-shader-open"/>
     <Button Content="{Binding Text[DlgCancel]}" Click="OnCancelPrecompile" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding ShaderJobActive, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="games-shader-cancel"/>
     <Button Content="{Binding Text[GsClose]}" Click="OnDismissShader" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding ShaderTask.Done, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="games-shader-dismiss"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="6">
     <controls:TaskProgressView State="{Binding ShaderTask}" AutomationProperties.AutomationId="games-shader-task"/>
     <TextBlock Text="{Binding ShaderJobEta}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" Visibility="{Binding ShaderJobEta, Converter={StaticResource PresenceVisibility}}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Style="{StaticResource SettingRowStyle}" Visibility="{Binding ShowShaderToolOffer, Converter={StaticResource BooleanVisibility}}">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{Binding Text[ScsOffer]}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
    <HyperlinkButton Grid.Column="2" Content="{Binding Text[ScsOfferLink]}" Click="OnScsOffer" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}">
   <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}"/><TextBlock Text="{Binding Text[GamesScanning]}" VerticalAlignment="Center"/>
  </StackPanel>
  <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}">
   <StackPanel Spacing="12"><Border Style="{StaticResource IconBadgeStyle}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE7FC;" Style="{StaticResource BadgeIconStyle}"/></Border><TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource BodyStyle}"/></StackPanel>
  </Border>
  <!-- Library -->
  <GridView ItemsSource="{Binding Games}" SelectionMode="None" IsItemClickEnabled="False" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="0" AutomationProperties.AutomationId="games-grid">
   <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="Padding" Value="0"/></Style></GridView.ItemContainerStyle>
   <GridView.ItemTemplate><DataTemplate>
    <Border Width="184" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" app:Motion.Hover="1.035">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="244"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- Cover or initials -->
      <Border CornerRadius="15,15,0,0" Background="{ThemeResource HeroBrush}">
       <Grid>
        <TextBlock Text="{Binding Initials}" FontFamily="Georgia" FontSize="44" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}, ConverterParameter=Invert}"/>
        <Border CornerRadius="15,15,0,0" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}}">
         <Border.Background><ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/></Border.Background>
        </Border>
        <Border Background="#B312090F" CornerRadius="6" Padding="7,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding Store}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MainTextBrush}"/></Border>
       </Grid>
      </Border>
      <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="10">
       <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" Height="40" ToolTipService.ToolTip="{Binding Name}"/>
       <TextBlock Text="{Binding ShaderLabel}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,-6,0,0" Visibility="{Binding ShaderLabel, Converter={StaticResource PresenceVisibility}}" ToolTipService.ToolTip="{Binding ShaderLabel}"/>
       <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Click="OnPrepareAndPlay" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" MinHeight="34" Padding="10,4" AutomationProperties.Name="{Binding PrepareLabel}" ToolTipService.ToolTip="{Binding PrepareLabel}">
         <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="12"/><TextBlock Text="{Binding PrepareLabel}" TextTrimming="CharacterEllipsis"/></StackPanel>
        </Button>
        <Button Grid.Column="1" Style="{StaticResource SoftButtonStyle}" MinHeight="34" Padding="9,4" ToolTipService.ToolTip="{Binding RemoveLabel}" AutomationProperties.Name="{Binding RemoveLabel}"><FontIcon Glyph="&#xE712;" FontSize="13"/>
         <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{Binding PlayLabel}" Command="{Binding Launch}" CommandParameter="{Binding}"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="{Binding PrecompileLabel}" Click="OnPrecompile" Visibility="{Binding CanPrecompile, Converter={StaticResource BooleanVisibility}}"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="{Binding OpenShaderLabel}" Click="OnOpenShaderTool" Visibility="{Binding ShaderLabel, Converter={StaticResource PresenceVisibility}}"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="{Binding WhyLabel}" Click="OnWhyStutter"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9CE;"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="{Binding MeasureLabel}" Click="OnMeasureGame"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D2;"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="{Binding OptimizeLabel}" Click="OnOptimizeSettings"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9E9;"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="{Binding RemoveLabel}" Click="OnRemoveGame"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout>
        </Button>
       </Grid>
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate></GridView.ItemTemplate>
  </GridView>
 </StackPanel>
</UserControl>
