<UserControl x:Class="Lotus.App.Controls.GamesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls" x:Name="Root">
 <StackPanel Spacing="18" app:Motion.Stagger="True">
  <!-- Toolbar: search, store filter, add, rescan -->
  <Grid ColumnSpacing="12" RowSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox PlaceholderText="{Binding Text[GamesSearch]}" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Text[GamesSearch]}" AutomationProperties.AutomationId="games-search"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore, Mode=TwoWay}" DisplayMemberPath="Label" MinWidth="170" MinHeight="40" AutomationProperties.AutomationId="games-store"/>
   <!-- Visual 2.0: add and rescan live in one "+" menu, so the games come first -->
   <DropDownButton x:Name="RescanButton" Grid.Column="2" MinHeight="40" MinWidth="56" CornerRadius="{StaticResource ControlRadius}" AutomationProperties.Name="{Binding Text[GamesAdd]}" AutomationProperties.AutomationId="games-more" ToolTipService.ToolTip="{Binding Text[GamesAdd]}">
    <FontIcon x:Name="RescanIcon" Glyph="&#xE710;" FontSize="14"/>
    <DropDownButton.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
     <MenuFlyoutItem Text="{Binding Text[GamesAdd]}" Click="OnAddGame" AutomationProperties.AutomationId="games-add"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
     <MenuFlyoutItem Text="{Binding Text[GamesRescan]}" Click="OnRescan" ToolTipService.ToolTip="{Binding Text[GamesReadOnly]}" AutomationProperties.AutomationId="games-rescan"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    </MenuFlyout></DropDownButton.Flyout>
   </DropDownButton>
  </Grid>
  <StackPanel Spacing="4">
   <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" AutomationProperties.AutomationId="games-summary"/><TextBlock x:Name="RescanText" Foreground="{ThemeResource SuccessBrush}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource RoseBrush}" AutomationProperties.LiveSetting="Polite" app:Motion.Settle="True" AutomationProperties.AutomationId="games-status"/>
  </StackPanel>
  <!-- Lotus Ports: its games, with Jogar (only when Lotus Ports is installed and answers) -->
  <controls:PortsGamesStrip/>
  <!-- Shader pre-compilation in progress: game, stage, bar and time left -->
  <Border Style="{StaticResource CardStyle}" Visibility="{Binding ShaderCardVisible, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="games-shader-job">
   <Grid ColumnSpacing="16" RowSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}" VerticalAlignment="Top"><FontIcon Glyph="&#xE945;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
     <TextBlock Text="{Binding ShaderJobTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding ShaderJobDetail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" app:Motion.Settle="True"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button Content="{Binding Text[ScsOpen]}" Click="OnOpenShaderToolButton" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="games-shader-open"/>
     <Button Content="{Binding Text[DlgCancel]}" Click="OnCancelPrecompile" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding ShaderJobActive, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="games-shader-cancel"/>
     <Button Content="{Binding Text[GsClose]}" Click="OnDismissShader" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding ShaderTask.Done, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="games-shader-dismiss"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="6">
     <controls:TaskProgressView State="{Binding ShaderTask}" AutomationProperties.AutomationId="games-shader-task"/>
     <TextBlock Text="{Binding ShaderJobEta}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" Visibility="{Binding ShaderJobEta, Converter={StaticResource PresenceVisibility}}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Style="{StaticResource SettingRowStyle}" Visibility="{Binding ShowShaderToolOffer, Converter={StaticResource BooleanVisibility}}">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource RoseBrush}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{Binding Text[ScsOffer]}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
    <HyperlinkButton Grid.Column="2" Content="{Binding Text[ScsOfferLink]}" Click="OnScsOffer" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}">
   <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}"/><TextBlock Text="{Binding Text[GamesScanning]}" VerticalAlignment="Center"/>
  </StackPanel>
  <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}">
   <StackPanel Spacing="12"><Border Style="{StaticResource IconBadgeStyle}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE7FC;" Style="{StaticResource BadgeIconStyle}"/></Border><TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource BodyStyle}"/></StackPanel>
  </Border>
  <!-- Library -->
  <GridView x:Name="Library" ItemsSource="{Binding Games}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnGameClick" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="0" AutomationProperties.AutomationId="games-grid">
   <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Margin" Value="0,0,16,24"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Top"/></Style></GridView.ItemContainerStyle>
   <GridView.ItemTemplate><DataTemplate>
    <!-- Visual 3.0: the cover is the card. Play, Otimizar and the rest appear over it on hover or keyboard focus. -->
    <Grid Width="184" VerticalAlignment="Top" RowSpacing="10" Background="Transparent" PointerEntered="OnCardEnter" PointerExited="OnCardLeave" GotFocus="OnCardEnter" LostFocus="OnCardLeave">
     <Grid.RowDefinitions><RowDefinition Height="276"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <!-- Cover or initials (named: it flies to the game page) -->
     <Border x:Name="CoverArt" CornerRadius="14" Background="{ThemeResource HeroBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" app:Motion.Hover="1.04">
      <Grid>
       <Image Source="{Binding Name, Converter={StaticResource FallbackCover}}" Stretch="UniformToFill" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}, ConverterParameter=Invert}" AutomationProperties.AccessibilityView="Raw"/>
       <TextBlock Text="{Binding Initials}" FontFamily="Georgia" FontSize="44" FontWeight="SemiBold" Foreground="#FFF6F9" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}, ConverterParameter=Invert}"/>
       <Border CornerRadius="13" Visibility="{Binding CoverPath, Converter={StaticResource PresenceVisibility}}">
        <Border.Background><ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/></Border.Background>
       </Border>
       <Grid x:Name="HoverActions" Opacity="0" Padding="12" CornerRadius="13">
        <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.15"/></Grid.OpacityTransition>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0012090F" Offset="0.3"/><GradientStop Color="#EB12090F" Offset="1"/></LinearGradientBrush></Grid.Background>
        <StackPanel VerticalAlignment="Bottom" Spacing="8">
         <!-- Play: launches the game directly -->
         <Button Click="OnCoverPlay" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" MinHeight="40" Padding="8,6" ToolTipService.ToolTip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}" AutomationProperties.AutomationId="game-play">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xF5B0;" FontSize="14"/><TextBlock Text="{Binding PlayLabel}"/></StackPanel>
         </Button>
         <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Click="OnOpenTune" Style="{StaticResource SoftButtonStyle}" HorizontalAlignment="Stretch" MinHeight="34" Padding="6,4" AutomationProperties.Name="{Binding OptimizeMenuLabel}" AutomationProperties.AutomationId="game-optimize">
           <TextBlock Text="{Binding OptimizeMenuLabel}" TextTrimming="CharacterEllipsis"/>
          </Button>
          <Button Grid.Column="1" Click="OnDetails" Style="{StaticResource SoftButtonStyle}" MinHeight="34" MinWidth="34" Padding="8,4" ToolTipService.ToolTip="{Binding DetailsLabel}" AutomationProperties.Name="{Binding DetailsLabel}"><FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource GoldBrush}"/></Button>
        <Button Grid.Column="2" Style="{StaticResource SoftButtonStyle}" MinHeight="34" MinWidth="34" Padding="8,4" ToolTipService.ToolTip="{Binding DataContext.Text[GmMore], ElementName=Root}" AutomationProperties.Name="{Binding DataContext.Text[GmMore], ElementName=Root}" AutomationProperties.AutomationId="game-more" Loaded="OnMoreLoaded">
         <FontIcon Glyph="&#xE712;" FontSize="13"/>
         <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnMoreOpening">
          <MenuFlyoutItem Tag="GmEdit" Click="OnEditGame" AutomationProperties.AutomationId="game-edit"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
          <MenuFlyoutItem Tag="GmRemove" Click="OnRemoveGame" AutomationProperties.AutomationId="game-remove"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
         </MenuFlyout></Button.Flyout>
        </Button>
         </Grid>
        </StackPanel>
       </Grid>
      </Grid>
     </Border>
     <!-- Name, store and shader state under the cover; fixed height so every row lines up -->
     <StackPanel Grid.Row="1" Spacing="2" Padding="2,0" Height="58">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{Binding Name}"/>
      <TextBlock Text="{Binding Store}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding ShaderLabel}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding ShaderLabel, Converter={StaticResource PresenceVisibility}}" ToolTipService.ToolTip="{Binding ShaderLabel}"/>
     </StackPanel>
    </Grid>
   </DataTemplate></GridView.ItemTemplate>
  </GridView>
 </StackPanel>
</UserControl>
