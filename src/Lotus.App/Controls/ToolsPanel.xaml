    <ItemsControl ItemsSource="{Binding DriverRows}" AutomationProperties.AutomationId="tools-driver-rows">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid ColumnSpacing="12" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarningBrush}" Visibility="{Binding Warning, Converter={StaticResource BooleanVisibility}}" VerticalAlignment="Top" Margin="0,2,0,0"/>
       <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SuccessBrush}" Visibility="{Binding Warning, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}" VerticalAlignment="Top" Margin="0,2,0,0"/>
       <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding DriverUpdateStatus}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="{Binding DriverUpdateStatus, Converter={StaticResource PresenceVisibility}}"/>
    <controls:TaskProgressView State="{Binding DriverTask}" AutomationProperties.AutomationId="tools-drivers-task"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="{Binding Text[ToolDrvOpenNvidia]}" Click="OnOpenGpuUpdate" Visibility="{Binding GpuUpdateUrl, Converter={StaticResource PresenceVisibility}}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="tools-drivers-nvidia"/>
     <Button Content="{Binding Text[ToolDrvOpenWu]}" Click="OnOpenWindowsUpdate" Visibility="{Binding HasWindowsDriverUpdates, Converter={StaticResource BooleanVisibility}}" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="tools-drivers-wu"/>
     <Button Content="{Binding Text[ToolDriverOpen]}" Click="OnOpenDriverSite" Visibility="{Binding DriverUrl, Converter={StaticResource PresenceVisibility}}" Style="{StaticResource SoftButtonStyle}"/>
    </StackPanel>
    <!-- System: hardware, devices with problems, recent Windows errors, Windows' own repair (asks; administrator prompt) -->
    <StackPanel Spacing="10" DataContext="{Binding SystemTool}" Visibility="{Binding Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="tools-system">
     <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,6"/>
     <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="3"><TextBlock Text="{Binding Text[SyTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[SyWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      <Button Grid.Column="1" Content="{Binding Text[SyLoad]}" Click="OnSystemLoad" IsEnabled="{Binding CanAct}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="tools-system-load"/>
     </Grid>
     <TextBlock Text="{Binding Status}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="tools-system-status"/>
     <controls:TaskProgressView State="{Binding Work}"/>
     <StackPanel Spacing="8" Visibility="{Binding Loaded, Converter={StaticResource BooleanVisibility}}">
      <ItemsControl ItemsSource="{Binding Hardware}" AutomationProperties.AutomationId="tools-system-hw">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Grid ColumnSpacing="12" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionStyle}"/><TextBlock Grid.Column="1" Text="{Binding Detail}" TextWrapping="Wrap"/>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Text[SyDevicesTitle]}" FontWeight="SemiBold" Visibility="{Binding HasDevices, Converter={StaticResource BooleanVisibility}}"/>
      <ItemsControl ItemsSource="{Binding Devices}" AutomationProperties.AutomationId="tools-system-devices">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Grid ColumnSpacing="12" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
         <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Text[SyEventsTitle]}" FontWeight="SemiBold" Visibility="{Binding HasEvents, Converter={StaticResource BooleanVisibility}}"/>
      <ItemsControl ItemsSource="{Binding Events}" AutomationProperties.AutomationId="tools-system-events">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Grid ColumnSpacing="12" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Warning, Converter={StaticResource WarnOrText}}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Button Content="{Binding Text[SySfc]}" Click="OnSystemSfc" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="tools-system-sfc"/>
       <Button Content="{Binding Text[SyDism]}" Click="OnSystemDism" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="tools-system-dism"/>
      </StackPanel>
      <TextBlock app:Rich.Text="{Binding Text[SyNever]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
     </StackPanel>
    </StackPanel>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
