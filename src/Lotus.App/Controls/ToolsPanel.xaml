<UserControl x:Class="Lotus.App.Controls.ToolsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls">
 <UserControl.Resources><app:BooleanChoiceConverter x:Key="WarnOrText" TrueValue="{StaticResource WarningBrush}" FalseValue="{StaticResource MainTextBrush}"/><app:BooleanChoiceConverter x:Key="WarnOrRose" TrueValue="{StaticResource WarningBrush}" FalseValue="{StaticResource RoseBrush}"/></UserControl.Resources>
 <StackPanel Spacing="16" app:Motion.Stagger="True">
  <TextBlock app:Rich.Text="{Binding Text[ToolIntro]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding Message}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource RoseBrush}" Visibility="{Binding Message, Converter={StaticResource PresenceVisibility}}"/>
  <!-- Check-up hero: one click runs every read-only analysis; the result opens on its own screen -->
  <Border x:Name="CheckupHero" DataContext="{Binding Checkup}" Visibility="{Binding Converter={StaticResource PresenceVisibility}}" Background="{ThemeResource HeroBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="tools-checkup-hero">
   <Grid ColumnSpacing="22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource BadgeBrush}" VerticalAlignment="Top">
     <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{ThemeResource RoseBrush}"/>
    </Border>
    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
     <TextBlock Text="{Binding Text[CkTitle]}" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding TileStatus}" app:Motion.Settle="True" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="tools-checkup-headline"/>
     <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding Done, Converter={StaticResource BooleanVisibility}}" app:Motion.Stagger="True">
      <Border CornerRadius="12" Padding="12,4" Background="{ThemeResource SubtleBrush}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource WarningBrush}"/><TextBlock Text="{Binding AttentionText}" FontSize="14"/></StackPanel></Border>
      <Border CornerRadius="12" Padding="12,4" Background="{ThemeResource SubtleBrush}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource GoldBrush}"/><TextBlock Text="{Binding TipsText}" FontSize="14"/></StackPanel></Border>
      <Border CornerRadius="12" Padding="12,4" Background="{ThemeResource SubtleBrush}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SuccessBrush}"/><TextBlock Text="{Binding GoodText}" FontSize="14"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Spacing="4" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}">
      <TextBlock Text="{Binding Step}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" app:Motion.Settle="True"/>
      <controls:TaskProgressView State="{Binding Work}" AutomationProperties.AutomationId="tools-checkup-task"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
     <Button Click="OnCheckupRun" IsEnabled="{Binding CanAct}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="190" app:Motion.Press="True" AutomationProperties.AutomationId="tools-checkup-run">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="13"/><TextBlock Text="{Binding RunLabel}"/></StackPanel>
     </Button>
     <Button Content="{Binding Text[CkSeeResult]}" Click="OnCheckupOpen" Visibility="{Binding Done, Converter={StaticResource BooleanVisibility}}" Style="{StaticResource SoftButtonStyle}" MinWidth="190" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="tools-checkup-see"/>
    </StackPanel>
   </Grid>
  </Border>
  <!-- Tool tiles (visual 2.0): compact squares in four groups, with a search box; each opens its tool on its own screen -->
  <StackPanel x:Name="Tiles" Spacing="20" AutomationProperties.AutomationId="tools-tiles">
   <AutoSuggestBox x:Name="ToolSearch" PlaceholderText="{Binding Text[ToolSearch]}" QueryIcon="Find" MaxWidth="420" HorizontalAlignment="Left" MinWidth="280" TextChanged="OnToolSearch" AutomationProperties.Name="{Binding Text[ToolSearch]}" AutomationProperties.AutomationId="tools-search"/>
   <TextBlock x:Name="ToolSearchEmpty" Text="{Binding Text[ToolSearchEmpty]}" Style="{StaticResource CaptionStyle}" Visibility="Collapsed"/>
   <StackPanel x:Name="TileGroups" Spacing="24"/>
  </StackPanel>
  <!-- Detail: back to the tiles -->
  <Button x:Name="BackButton" Click="OnBack" Style="{StaticResource SoftButtonStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="tools-back">
   <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="13"/><TextBlock Text="{Binding Text[ToolBack]}"/></StackPanel>
  </Button>
  <!-- Free memory for gaming -->
  <Border x:Name="MemCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
   <StackPanel Spacing="10">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE964;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[ToolMemTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[ToolMemWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
    </Grid>
    <ItemsControl ItemsSource="{Binding Apps}" AutomationProperties.AutomationId="tools-apps">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Grid ColumnSpacing="12" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding HasWindow}"/>
        <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"/>
       </Grid>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding MemoryStatus}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap"/>
    <controls:TaskProgressView State="{Binding MemTask}" AutomationProperties.AutomationId="tools-mem-task"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="{Binding Text[ToolMemClose]}" Click="OnCloseApps" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="tools-close-apps"/>
     <Button Content="{Binding Text[ToolRefresh]}" Click="OnRefresh" Style="{StaticResource SoftButtonStyle}"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <!-- Temporary files -->
  <Border x:Name="TempCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE74D;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[ToolTempTitle]}" FontWeight="SemiBold"/><TextBlock Text="{Binding TempStatus}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="tools-temp-status"/><controls:TaskProgressView State="{Binding TempTask}" Margin="0,6,0,0" AutomationProperties.AutomationId="tools-temp-task"/></StackPanel>
    <Button Grid.Column="2" Content="{Binding Text[ToolTempClean]}" Click="OnCleanTemp" IsEnabled="{Binding HasTemp}" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="tools-temp-clean"/>
   </Grid>
  </Border>
  <!-- Memory and processes: real RAM/CPU per program; closing asks; system, anti-cheat, games and Lotus are protected -->
  <Border x:Name="ProcCard" Visibility="Collapsed" Style="{StaticResource CardStyle}" DataContext="{Binding Processes}" AutomationProperties.AutomationId="tools-proc">
   <StackPanel Spacing="12">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE964;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[PrTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[PrWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="2" Click="OnProcRefresh" IsEnabled="{Binding CanAct}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="tools-proc-refresh">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="13"/><TextBlock Text="{Binding Text[PrRefresh]}"/></StackPanel>
     </Button>
    </Grid>
    <TextBlock Text="{Binding Status}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="tools-proc-status"/>
    <controls:TaskProgressView State="{Binding Work}" AutomationProperties.AutomationId="tools-proc-task"/>
    <CheckBox Content="{Binding Text[PrShowAll]}" IsChecked="{Binding ShowAll, Mode=TwoWay}" AutomationProperties.AutomationId="tools-proc-all"/>
    <Grid ColumnSpacing="12" Padding="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="64"/><ColumnDefinition Width="150"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Text[PrColName]}" Style="{StaticResource CaptionStyle}"/><TextBlock Grid.Column="1" Text="RAM" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="tools-proc-rows">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="12" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="64"/><ColumnDefinition Width="150"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
       <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanClose}" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
       <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Location}" Style="{StaticResource CaptionStyle}" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Location}"/></StackPanel>
       <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="3" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"/>
       <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12" Padding="10,3" Background="{ThemeResource BadgeBrush}"><TextBlock Text="{Binding KindText}" FontSize="12" Foreground="{ThemeResource GoldBrush}"/></Border>
       <Button Grid.Column="5" Click="OnProcToggleList" Visibility="{Binding CanClose, Converter={StaticResource BooleanVisibility}}" Padding="6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{Binding DataContext.Text[PrListTip], ElementName=ProcCard}" AutomationProperties.Name="{Binding Name}">
        <Grid><FontIcon Glyph="&#xE734;" FontSize="15" Foreground="{ThemeResource MutedBrush}" Visibility="{Binding InCloseList, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}"/><FontIcon Glyph="&#xE735;" FontSize="15" Foreground="{ThemeResource RoseBrush}" Visibility="{Binding InCloseList, Converter={StaticResource BooleanVisibility}}"/></Grid>
       </Button>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="{Binding Text[PrClose]}" Click="OnProcClose" IsEnabled="{Binding CanAct}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="tools-proc-close"/>
     <Button Content="{Binding Text[PrPickList]}" Click="OnProcPickList" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="tools-proc-picklist"/>
     <Button Content="{Binding Text[PrForce]}" Click="OnProcForce" IsEnabled="{Binding CanAct}" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="tools-proc-force"/>
    </StackPanel>
    <TextBlock app:Rich.Text="{Binding Text[PrNever]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <!-- Files and storage: large files, biggest folders, duplicates (content hash), old downloads; only to the Recycle Bin -->
  <Border x:Name="StoreCard" Visibility="Collapsed" Style="{StaticResource CardStyle}" DataContext="{Binding Storage}" AutomationProperties.AutomationId="tools-store">
   <StackPanel Spacing="12">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE8B7;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[StTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[StWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
    </Grid>
    <ItemsControl ItemsSource="{Binding Drives}" AutomationProperties.AutomationId="tools-store-drives">
     <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource CaptionStyle}" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="10">
     <ComboBox ItemsSource="{Binding Scopes}" SelectedIndex="{Binding ScopeIndex, Mode=TwoWay}" MinWidth="320" AutomationProperties.AutomationId="tools-store-scope" AutomationProperties.Name="{Binding Text[StScope]}"/>
     <Button Click="OnStoreScan" IsEnabled="{Binding CanAct}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="tools-store-scan">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="13"/><TextBlock Text="{Binding Text[StScan]}"/></StackPanel>
     </Button>
     <Button Content="{Binding Text[DlgCancel]}" Click="OnStoreCancel" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="tools-store-cancel"/>
    </StackPanel>
    <TextBlock Text="{Binding Status}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="tools-store-status"/>
    <controls:TaskProgressView State="{Binding Work}" AutomationProperties.AutomationId="tools-store-task"/>
    <StackPanel Spacing="10" Visibility="{Binding HasReport, Converter={StaticResource BooleanVisibility}}">
     <ComboBox ItemsSource="{Binding Views}" SelectedIndex="{Binding ViewIndex, Mode=TwoWay}" MinWidth="320" AutomationProperties.AutomationId="tools-store-view"/>
     <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="tools-store-rows">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Grid>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{ThemeResource GoldBrush}" Margin="2,8,0,0" Visibility="{Binding IsHeader, Converter={StaticResource BooleanVisibility}}"/>
        <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="12" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Visibility="{Binding IsHeader, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Visibility="{Binding CanRecycle, Converter={StaticResource BooleanVisibility}}" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
         <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}"/></StackPanel>
         <Button Grid.Column="2" Content="{Binding DataContext.Text[StReveal], ElementName=StoreCard}" Click="OnStoreReveal" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center"/>
        </Grid>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button Content="{Binding Text[StRecycle]}" Click="OnStoreRecycle" IsEnabled="{Binding CanAct}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="tools-store-recycle"/>
    </StackPanel>
    <TextBlock app:Rich.Text="{Binding Text[StNever]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <!-- Windows startup: publisher, signature, path and mechanism; turning off asks and can be undone -->
  <Border x:Name="StartCard" Visibility="Collapsed" Style="{StaticResource CardStyle}" DataContext="{Binding Startup}" AutomationProperties.AutomationId="tools-startup">
   <StackPanel Spacing="12">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE7E8;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[SuTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[SuWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="2" Click="OnStartupRefresh" IsEnabled="{Binding CanAct}" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="tools-startup-refresh">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="13"/><TextBlock Text="{Binding Text[ToolRefresh]}"/></StackPanel>
     </Button>
    </Grid>
    <TextBlock Text="{Binding Status}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="tools-startup-status"/>
    <controls:TaskProgressView State="{Binding Work}" AutomationProperties.AutomationId="tools-startup-task"/>
    <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="tools-startup-rows">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="12" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Opacity="{Binding IsDisabled, Converter={StaticResource DimWhenTrue}}">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Entry.Command}"/>
        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"><Run Text="{Binding Mechanism}"/><Run Text=" · "/><Run Text="{Binding SignatureText}"/></TextBlock>
       </StackPanel>
       <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="12" Padding="10,3" Background="{ThemeResource BadgeBrush}"><TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{ThemeResource GoldBrush}"/></Border>
       <Button Grid.Column="2" Content="{Binding ToggleLabel}" Click="OnStartupToggle" Visibility="{Binding CanToggle, Converter={StaticResource BooleanVisibility}}" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock app:Rich.Text="{Binding Text[SuNever]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <!-- Disk health: Windows' own data; what it does not report shows as unavailable. No defragmenting. -->
  <Border x:Name="HealthCard" Visibility="Collapsed" Style="{StaticResource CardStyle}" DataContext="{Binding DiskTool}" AutomationProperties.AutomationId="tools-diskhealth">
   <StackPanel Spacing="12">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xEDA2;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[DkTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[DkWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="2" Click="OnDiskRefresh" IsEnabled="{Binding CanAct}" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="tools-diskhealth-refresh">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="13"/><TextBlock Text="{Binding Text[ToolRefresh]}"/></StackPanel>
     </Button>
    </Grid>
    <TextBlock Text="{Binding Status}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="tools-diskhealth-status"/>
    <controls:TaskProgressView State="{Binding Work}"/>
    <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="tools-diskhealth-rows">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Padding="14,12" Spacing="8" CornerRadius="12" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
       <StackPanel Orientation="Horizontal" Spacing="10">
        <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="{ThemeResource WarningBrush}" Visibility="{Binding Warning, Converter={StaticResource BooleanVisibility}}"/>
        <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{ThemeResource SuccessBrush}" Visibility="{Binding Warning, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}"/>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
       </StackPanel>
       <ItemsControl ItemsSource="{Binding Facts}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Grid ColumnSpacing="12" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <!-- Labels at the same 14 px as the values (muted), like the other tool cards -->
          <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionStyle}" FontSize="14" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Warning, Converter={StaticResource WarnOrText}}" TextWrapping="Wrap"/>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <ItemsControl ItemsSource="{Binding ScanTargets}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Click="OnDiskScan" Tag="{Binding Letter}" Style="{StaticResource SoftButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="14"/><TextBlock Text="{Binding Label}"/></StackPanel></Button>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock app:Rich.Text="{Binding Text[DkNever]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <!-- Check-up result: most important first; each line opens the tool that can act on it -->
  <Border x:Name="CheckupCard" Visibility="Collapsed" Style="{StaticResource CardStyle}" DataContext="{Binding Checkup}" AutomationProperties.AutomationId="tools-checkup">
   <StackPanel Spacing="14">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE9D9;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Style="{StaticResource CaptionStyle}"/></StackPanel>
     <Button Grid.Column="2" Click="OnCheckupRun" IsEnabled="{Binding CanAct}" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="13"/><TextBlock Text="{Binding Text[CkRunAgain]}"/></StackPanel>
     </Button>
    </Grid>
    <TextBlock Text="{Binding Step}" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}" app:Motion.Settle="True"/>
    <controls:TaskProgressView State="{Binding Work}"/>
    <ItemsControl ItemsSource="{Binding Findings}" AutomationProperties.AutomationId="tools-checkup-findings">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemContainerTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18"/></TransitionCollection></ItemsControl.ItemContainerTransitions>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Padding="16,12" ColumnSpacing="14" CornerRadius="12" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid Width="36" Height="36" VerticalAlignment="Center">
        <Ellipse Fill="{ThemeResource BadgeBrush}"/>
        <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource WarningBrush}" Visibility="{Binding IsAttention, Converter={StaticResource BooleanVisibility}}"/>
        <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource GoldBrush}" Visibility="{Binding IsTip, Converter={StaticResource BooleanVisibility}}"/>
        <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SuccessBrush}" Visibility="{Binding IsGood, Converter={StaticResource BooleanVisibility}}"/>
       </Grid>
       <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel>
       <Button Grid.Column="2" Tag="{Binding ToolId}" Click="OnCheckupGo" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center" app:Motion.Press="True">
        <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding DataContext.Text[ToolOpen], ElementName=CheckupCard}"/><TextBlock Text="→"/></StackPanel>
       </Button>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
