<UserControl x:Class="Lotus.App.Controls.ToolsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:Lotus.App" xmlns:controls="using:Lotus.App.Controls">
 <StackPanel Spacing="16" app:Motion.Stagger="True">
  <TextBlock app:Rich.Text="{Binding Text[ToolIntro]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding Message}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource RoseBrush}" Visibility="{Binding Message, Converter={StaticResource PresenceVisibility}}"/>
  <!-- Tool tiles: a grid of squares; each opens its tool on its own screen -->
  <GridView x:Name="Tiles" SelectionMode="None" IsItemClickEnabled="False" ScrollViewer.VerticalScrollMode="Disabled" Padding="0" AutomationProperties.AutomationId="tools-tiles">
   <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="Padding" Value="0"/></Style></GridView.ItemContainerStyle>
  </GridView>
  <!-- Detail: back to the tiles -->
  <Button x:Name="BackButton" Click="OnBack" Style="{StaticResource SoftButtonStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="tools-back">
   <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="13"/><TextBlock Text="{Binding Text[ToolBack]}"/></StackPanel>
  </Button>
  <!-- Free memory for gaming -->
  <Border x:Name="MemCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
   <StackPanel Spacing="10">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE964;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[ToolMemTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[ToolMemWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
    </Grid>
    <ItemsControl ItemsSource="{Binding Apps}" AutomationProperties.AutomationId="tools-apps">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Grid ColumnSpacing="12" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding HasWindow}"/>
        <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"/>
       </Grid>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding MemoryStatus}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap"/>
    <controls:TaskProgressView State="{Binding MemTask}" AutomationProperties.AutomationId="tools-mem-task"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="{Binding Text[ToolMemClose]}" Click="OnCloseApps" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="tools-close-apps"/>
     <Button Content="{Binding Text[ToolRefresh]}" Click="OnRefresh" Style="{StaticResource SoftButtonStyle}"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <!-- Temporary files -->
  <Border x:Name="TempCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE74D;" Style="{StaticResource BadgeIconStyle}"/></Border>
    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[ToolTempTitle]}" FontWeight="SemiBold"/><TextBlock Text="{Binding TempStatus}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="tools-temp-status"/><controls:TaskProgressView State="{Binding TempTask}" Margin="0,6,0,0" AutomationProperties.AutomationId="tools-temp-task"/></StackPanel>
    <Button Grid.Column="2" Content="{Binding Text[ToolTempClean]}" Click="OnCleanTemp" IsEnabled="{Binding HasTemp}" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="tools-temp-clean"/>
   </Grid>
  </Border>
  <!-- Uninstall programs (official uninstaller, then leftovers to the Recycle Bin) -->
  <controls:UninstallerCard x:Name="UninCard" DataContext="{Binding Uninstall}" Visibility="Collapsed"/>
  <!-- Connection test -->
  <Border x:Name="NetCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
   <StackPanel Spacing="10">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE701;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[ToolNetTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[ToolNetWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="2" Content="{Binding Text[ToolNetRun]}" Click="OnTestNet" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="tools-net-run"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding NetRows}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid ColumnSpacing="12" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding NetStatus}" app:Motion.Settle="True" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="{Binding NetStatus, Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="tools-net-status"/>
    <controls:TaskProgressView State="{Binding NetTask}" AutomationProperties.AutomationId="tools-net-task"/>
    <!-- DNS: measured here, switched only on request (UAC), with restore -->
    <StackPanel Spacing="8" Visibility="{Binding HasDns, Converter={StaticResource BooleanVisibility}}">
     <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,6"/>
     <TextBlock Text="{Binding Text[ToolDnsTitle]}" FontWeight="SemiBold"/>
     <TextBlock app:Rich.Text="{Binding Text[ToolDnsWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
     <ItemsControl ItemsSource="{Binding DnsRows}" AutomationProperties.AutomationId="tools-dns-rows">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Grid ColumnSpacing="12" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CaptionStyle}"/>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{Binding DnsStatus}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="tools-dns-status"/>
     <controls:TaskProgressView State="{Binding DnsTask}" AutomationProperties.AutomationId="tools-dns-task"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{Binding Text[ToolDnsTest]}" Click="OnTestDns" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="tools-dns-test"/>
      <Button Content="{Binding RecommendedDnsLabel}" Click="OnApplyDns" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanApplyDns, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="tools-dns-apply"/>
      <Button Content="{Binding Text[ToolDnsRestore]}" Click="OnRestoreDns" Style="{StaticResource SoftButtonStyle}" Visibility="{Binding CanRestoreDns, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="tools-dns-restore"/>
     </StackPanel>
    </StackPanel>
   </StackPanel>
  </Border>
  <!-- Disk health -->
  <Border x:Name="DiskCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
   <StackPanel Spacing="10">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xEDA2;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[ToolDiskTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[ToolDiskWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
    </Grid>
    <ItemsControl ItemsSource="{Binding DiskRows}" AutomationProperties.AutomationId="tools-disks">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid ColumnSpacing="12" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding DiskTip}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap" Visibility="{Binding DiskTip, Converter={StaticResource PresenceVisibility}}" AutomationProperties.AutomationId="tools-disk-tip"/>
   </StackPanel>
  </Border>
  <!-- Drivers: outdated ones from trusted sources (NVIDIA's own service, Windows Update) -->
  <!-- Overlays and capture apps that often cause stutter (read-only; explains how to turn each off) -->
  <Border x:Name="OverlayCard" Visibility="Collapsed" Style="{StaticResource CardStyle}" DataContext="{Binding Overlays}" AutomationProperties.AutomationId="tools-overlays">
   <StackPanel Spacing="12">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE7F4;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[OvTitle]}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Text[OvWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="2" Click="OnScanOverlays" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="tools-overlays-scan">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="13"/><TextBlock Text="{Binding Text[OvScan]}"/></StackPanel>
     </Button>
    </Grid>
    <TextBlock Text="{Binding Summary}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding Rows}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Padding="14,12" ColumnSpacing="12" CornerRadius="12" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <FontIcon Glyph="{Binding Glyph}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{Binding Heavy, Converter={StaticResource AttentionBrush}}"/>
       <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock app:Rich.Text="{Binding Advice}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Border>
  <Border x:Name="DriverCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
   <StackPanel Spacing="10">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE7F8;" Style="{StaticResource BadgeIconStyle}"/></Border>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Text[ToolDriverTitle]}" FontWeight="SemiBold"/><TextBlock Text="{Binding DriverStatus}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="tools-driver"/><TextBlock app:Rich.Text="{Binding Text[ToolDriverWhat]}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="2" Content="{Binding Text[ToolDrvCheck]}" Click="OnCheckDrivers" Visibility="{Binding CanCheckDrivers, Converter={StaticResource BooleanVisibility}}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="tools-drivers-check"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding DriverRows}" AutomationProperties.AutomationId="tools-driver-rows">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid ColumnSpacing="12" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarningBrush}" Visibility="{Binding Warning, Converter={StaticResource BooleanVisibility}}" VerticalAlignment="Top" Margin="0,2,0,0"/>
       <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SuccessBrush}" Visibility="{Binding Warning, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}" VerticalAlignment="Top" Margin="0,2,0,0"/>
       <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding DriverUpdateStatus}" app:Motion.Settle="True" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource GoldBrush}" TextWrapping="Wrap" Visibility="{Binding DriverUpdateStatus, Converter={StaticResource PresenceVisibility}}"/>
    <controls:TaskProgressView State="{Binding DriverTask}" AutomationProperties.AutomationId="tools-drivers-task"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="{Binding Text[ToolDrvOpenNvidia]}" Click="OnOpenGpuUpdate" Visibility="{Binding GpuUpdateUrl, Converter={StaticResource PresenceVisibility}}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="tools-drivers-nvidia"/>
     <Button Content="{Binding Text[ToolDrvOpenWu]}" Click="OnOpenWindowsUpdate" Visibility="{Binding HasWindowsDriverUpdates, Converter={StaticResource BooleanVisibility}}" Style="{StaticResource SoftButtonStyle}" AutomationProperties.AutomationId="tools-drivers-wu"/>
     <Button Content="{Binding Text[ToolDriverOpen]}" Click="OnOpenDriverSite" Visibility="{Binding DriverUrl, Converter={StaticResource PresenceVisibility}}" Style="{StaticResource SoftButtonStyle}"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
