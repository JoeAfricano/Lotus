<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:Lotus.App">
 <!-- Design kit (visual 2.0): every screen uses these. Type follows the Windows ramp (12/14/18/20/28/40),
      spacing is a 4 px grid (4, 8, 12, 16, 24, 32, 48) and corners come in three sizes. -->
 <CornerRadius x:Key="ControlRadius">8</CornerRadius><CornerRadius x:Key="CardRadius">12</CornerRadius><CornerRadius x:Key="HeroRadius">16</CornerRadius>
 <x:Double x:Key="CaptionSize">12</x:Double><x:Double x:Key="BodySize">14</x:Double><x:Double x:Key="BodyLargeSize">18</x:Double>
 <x:Double x:Key="SubtitleSize">20</x:Double><x:Double x:Key="TitleSize">28</x:Double><x:Double x:Key="DisplaySize">40</x:Double>
 <!-- Surfaces -->
 <Style x:Key="CardStyle" TargetType="Border"><Setter Property="app:Motion.Hover" Value="1.004"/><Setter Property="Background" Value="{ThemeResource CardBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/><Setter Property="Padding" Value="20"/></Style>
 <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/></Style>
 <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="app:Motion.Sheen" Value="True"/><Setter Property="Background" Value="{ThemeResource HeroBrush}"/><Setter Property="CornerRadius" Value="{StaticResource HeroRadius}"/><Setter Property="Padding" Value="24"/></Style>
 <Style x:Key="CardControlStyle" TargetType="ContentControl">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Border Style="{StaticResource CardStyle}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Settings-style row: icon, title/description, control on the right. -->
 <Style x:Key="SettingRowStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Padding" Value="16,12"/><Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/></Style>
 <Style x:Key="IconBadgeStyle" TargetType="Border"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
 <Style x:Key="BadgeIconStyle" TargetType="FontIcon"><Setter Property="FontSize" Value="24"/><Setter Property="Foreground" Value="{ThemeResource RoseBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="StatusBadgeStyle" TargetType="ContentControl">
  <Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="6" Padding="8,5,10,5"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource RoseBrush}"/><TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Foreground="{ThemeResource MainTextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/></Grid></Border></ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- Controls -->
 <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="app:Motion.Press" Value="True"/><Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/><Setter Property="Foreground" Value="{StaticResource OnRoseBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="20,8"/><Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="SoftButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="app:Motion.Press" Value="True"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,8"/><Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/></Style>
 <Style x:Key="ProfileToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="MinHeight" Value="64"/><Setter Property="Padding" Value="16,12"/><Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/></Style>

 <!-- Chromeless button used for selectable cards; selection visuals live in the content (bound to the VM). -->
 <Style x:Key="CardButtonStyle" TargetType="Button">
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Padding" Value="0"/><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="FocusVisualMargin" Value="-3"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid x:Name="Root" Background="Transparent">
    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
     <VisualState x:Name="Normal"/>
     <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
     <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/><Setter Target="Root.Opacity" Value="0.86"/></VisualState.Setters></VisualState>
     <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
    </VisualStateGroup></VisualStateManager.VisualStateGroups>
    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource CardRadius}" Background="{ThemeResource SubtleBrush}" IsHitTestVisible="False"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ChipStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SubtleBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="9,5"/></Style>
 <Style x:Key="ChipTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

 <!-- Typography: the Windows type ramp -->
 <Style x:Key="CaptionStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="16"/></Style>
 <Style x:Key="BodyStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
 <Style x:Key="BodyStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="BodyLargeStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="24"/></Style>
 <Style x:Key="SubtitleStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="28"/></Style>
 <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleStyle}"/>
 <Style x:Key="TitleStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="36"/></Style>
 <Style x:Key="MetricValueStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="40"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{ThemeResource MainTextBrush}"/></Style>
 <Style x:Key="EmptyIconStyle" TargetType="FontIcon"><Setter Property="FontSize" Value="28"/><Setter Property="Foreground" Value="{ThemeResource RoseBrush}"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>

 <DataTemplate x:Key="PageHeaderTemplate">
  <!-- Compact header: title (28) and one short line, so the page content starts high. -->
  <StackPanel Spacing="4" Margin="0,0,0,4">
   <TextBlock Text="{Binding Title}" Style="{StaticResource TitleStyle}" AutomationProperties.HeadingLevel="Level1"/>
   <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource MutedBrush}" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
 </DataTemplate>
 <DataTemplate x:Key="MetricCardTemplate">
  <Border Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="6"><TextBlock Text="{Binding Title}" Style="{StaticResource EyebrowStyle}" TextWrapping="Wrap"/><TextBlock Text="&#x2014;" FontSize="28"/><TextBlock Text="{Binding Status}" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
 </DataTemplate>
 <DataTemplate x:Key="SectionEmptyStateTemplate">
  <StackPanel Spacing="16">
   <Border Style="{StaticResource IconBadgeStyle}" HorizontalAlignment="Left"><FontIcon Glyph="{Binding Glyph}" Style="{StaticResource BadgeIconStyle}" AutomationProperties.AccessibilityView="Raw"/></Border>
   <TextBlock Text="{Binding Text[NextSteps]}" Style="{StaticResource EyebrowStyle}"/>
   <TextBlock Text="{Binding NextStep}" Style="{StaticResource SubtitleStyle}"/>
   <ContentControl Content="{Binding Planned}" Style="{StaticResource StatusBadgeStyle}"/>
  </StackPanel>
 </DataTemplate>
 <!-- Shared future loading presentation, instantiated only by an actual loading operation. -->
 <DataTemplate x:Key="LoadingStateTemplate"><StackPanel Orientation="Horizontal" Spacing="12"><ProgressRing Width="20" Height="20" IsActive="True" AutomationProperties.Name="{Binding Text[Loading]}"/><TextBlock Text="{Binding Text[Loading]}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
</ResourceDictionary>
