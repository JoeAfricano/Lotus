<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CardControlStyle" TargetType="ContentControl">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Border Style="{StaticResource CardStyle}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="StatusBadgeStyle" TargetType="ContentControl">
  <Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Border Background="{ThemeResource BadgeBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6"><TextBlock Text="{TemplateBinding Content}" Foreground="{ThemeResource RoseBrush}" FontSize="11" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="Background" Value="{ThemeResource RoseBrush}"/><Setter Property="Foreground" Value="#171017"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="18,8"/><Setter Property="CornerRadius" Value="6"/></Style>
 <Style x:Key="SettingsPanelStyle" TargetType="StackPanel"><Setter Property="Spacing" Value="18"/><Setter Property="MaxWidth" Value="560"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
 <DataTemplate x:Key="PageHeaderTemplate">
  <StackPanel Spacing="8"><TextBlock Text="{Binding Text[Eyebrow]}" Style="{StaticResource EyebrowStyle}"/>
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="{Binding Glyph}" FontSize="26" Foreground="{ThemeResource RoseBrush}"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/></Grid>
   <TextBlock Text="{Binding Subtitle}" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
  </StackPanel>
 </DataTemplate>
 <DataTemplate x:Key="MetricCardTemplate">
  <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="6"><TextBlock Text="{Binding Title}" FontSize="12" Foreground="{ThemeResource RoseBrush}" TextWrapping="Wrap"/><TextBlock Text="&#x2014;" FontSize="26"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
 </DataTemplate>
 <DataTemplate x:Key="SectionEmptyStateTemplate">
  <StackPanel Spacing="18">
   <FontIcon Glyph="{Binding Glyph}" FontSize="36" Foreground="{ThemeResource RoseBrush}" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw"/>
   <TextBlock Text="{Binding Text[NextSteps]}" Style="{StaticResource EyebrowStyle}"/>
   <TextBlock Text="{Binding NextStep}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <ContentControl Content="{Binding Planned}" Style="{StaticResource StatusBadgeStyle}"/>
  </StackPanel>
 </DataTemplate>
 <!-- Shared future loading presentation, instantiated only by an actual loading operation. -->
 <DataTemplate x:Key="LoadingStateTemplate"><StackPanel Orientation="Horizontal" Spacing="12"><ProgressRing Width="20" Height="20" IsActive="True" AutomationProperties.Name="{Binding Text[Loading]}"/><TextBlock Text="{Binding Text[Loading]}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
</ResourceDictionary>
