<Project>
  <PropertyGroup><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>14</LangVersion><Deterministic>true</Deterministic></PropertyGroup>
  <!-- Lotus version. Betas use 2.x inside (2.0.0 = "Lotus 1.0 Beta") so alpha 1.x installs still see them as newer. -->
  <PropertyGroup>
    <Version>2.0.8</Version>
    <AssemblyVersion>2.0.8.0</AssemblyVersion>
    <FileVersion>2.0.8.0</FileVersion>
    <InformationalVersion>2.0.8-beta</InformationalVersion>
    <!-- The name players see (Settings, updates, installer, Novidades). Free text: it never has to match the number above,
         which only has to keep growing for the updater. -->
    <LotusDisplayVersion>1.0.8 Beta</LotusDisplayVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Lotus</Product>
    <Company>Joeafricano</Company>
    <Copyright>Lotus Â· cÃ³digo aberto Â· feito por Joeafricano com o Claude</Copyright>
  </PropertyGroup>
  <ItemGroup><AssemblyMetadata Include="LotusDisplayVersion" Value="$(LotusDisplayVersion)"/></ItemGroup>
</Project>
