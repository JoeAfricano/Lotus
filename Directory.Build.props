<Project>
  <PropertyGroup><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>14</LangVersion><Deterministic>true</Deterministic></PropertyGroup>
  <!-- Lotus version (first public build: alpha). Shown in Settings and used by the installer. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0-alpha</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Lotus</Product>
    <Company>Joeafricano</Company>
    <Copyright>Lotus · código aberto · feito por Joeafricano com o Claude</Copyright>
  </PropertyGroup>
</Project>
